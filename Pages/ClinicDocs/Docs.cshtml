@page "/Clinic/Docs"
@model SamsonDentalCenterManagementSystem.Pages.ClinicDocs.DocsModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "System Documentation";
}

<div class="min-h-screen bg-[#0a0a0b] text-white overflow-hidden dot-grid p-6 lg:p-12 relative">
    <!-- Background Decor -->
    <div class="absolute top-0 right-0 w-[50vw] h-[50vw] bg-indigo-500/5 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-[40vw] h-[40vw] bg-blue-500/5 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/2"></div>

    <style>
        .glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .gradient-text {
            background: linear-gradient(135deg, #fff 0%, #6366f1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .dot-grid {
            background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
            background-size: 30px 30px;
        }
        section { scroll-margin-top: 100px; }
    </style>

    <div class="max-w-5xl mx-auto py-10 relative z-10">
        <!-- Header -->
        <header class="mb-24 opacity-0" id="doc-header">
            <div class="inline-block px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-[10px] font-bold uppercase tracking-[0.2em] mb-6">
                System Transparency & Tech Stack
            </div>
            <h1 class="text-5xl md:text-8xl font-bold mb-8 gradient-text tracking-tighter">SDC Operations<br>Engine</h1>
            <p class="text-white/40 text-xl max-w-2xl leading-relaxed">
                Explore the technological foundation of Samson Dental Center—where enterprise-grade security meets clinical excellence and patient-first design.
            </p>
        </header>

        <!-- Main Content -->
        <div class="space-y-40">
            <!-- Architecture -->
            <section class="opacity-0 translate-y-10 doc-section">
                <div class="flex flex-col md:flex-row gap-12 items-start">
                    <div class="md:w-1/3">
                        <h2 class="text-3xl font-bold mb-4">Architecture</h2>
                        <p class="text-white/40 text-sm leading-relaxed">
                            A modern, cloud-native stack designed for high availability and sub-second latency.
                        </p>
                    </div>
                    <div class="md:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div class="glass p-8 rounded-3xl">
                            <div class="w-10 h-10 rounded-xl bg-indigo-500/20 flex items-center justify-center mb-6">
                                <i class="fa-solid fa-server text-indigo-400"></i>
                            </div>
                            <h3 class="text-white font-bold mb-3">Backend Core</h3>
                            <p class="text-white/50 text-[13px] leading-relaxed">
                                Built on <strong>.NET 9.0 Core</strong>, utilizing a service-oriented architecture with asynchronous processing for appointment scheduling and billing.
                            </p>
                        </div>
                        <div class="glass p-8 rounded-3xl">
                            <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center mb-6">
                                <i class="fa-solid fa-database text-blue-400"></i>
                            </div>
                            <h3 class="text-white font-bold mb-3">Data Infrastructure</h3>
                            <p class="text-white/50 text-[13px] leading-relaxed">
                                Powered by <strong>Supabase (PostgreSQL)</strong>, featuring Row-Level Security (RLS) to ensure patients only ever access their own data.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Integrity & Security -->
            <section class="opacity-0 translate-y-10 doc-section">
                <div class="glass p-12 rounded-[40px] border-indigo-500/10">
                    <div class="flex items-center gap-4 mb-10">
                        <div class="px-4 py-1.5 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 text-[10px] font-bold uppercase tracking-widest">
                            Secure & Compliant
                        </div>
                    </div>
                    <h2 class="text-4xl font-bold mb-8">System Integrity</h2>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                        <div class="space-y-4">
                            <h4 class="text-white font-semibold flex items-center gap-2">
                                <i class="fa-solid fa-shield-halved text-indigo-400 text-sm"></i>
                                HIPAA Alignment
                            </h4>
                            <p class="text-white/40 text-sm leading-relaxed">
                                Encrypted data transmission (TLS 1.3) and storage-at-rest ensure that sensitive dental records remain strictly confidential.
                            </p>
                        </div>
                        <div class="space-y-4">
                            <h4 class="text-white font-semibold flex items-center gap-2">
                                <i class="fa-solid fa-fingerprint text-indigo-400 text-sm"></i>
                                Identity Bridge
                            </h4>
                            <p class="text-white/40 text-sm leading-relaxed">
                                Multi-factor authentication support and secure OTP (One-Time Password) flows protect your account from unauthorized access.
                            </p>
                        </div>
                        <div class="space-y-4">
                            <h4 class="text-white font-semibold flex items-center gap-2">
                                <i class="fa-solid fa-clock-rotate-left text-indigo-400 text-sm"></i>
                                Audit Logging
                            </h4>
                            <p class="text-white/40 text-sm leading-relaxed">
                                Every administrative action is logged and immutable, providing full transparency on how clinical data is managed.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- AI Operations -->
            <section class="opacity-0 translate-y-10 doc-section">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                    <div>
                        <h2 class="text-3xl font-bold mb-6">Samson Dental Core (SLM)</h2>
                        <p class="text-white/40 leading-relaxed mb-8">
                            A specialized, high-efficiency appointment management model optimized for low-latency, high-accuracy scheduling. 
                            Operating on strict domain constraints for Samson Dental Center.
                        </p>
                        <ul class="space-y-4">
                            <li class="flex gap-4 items-start">
                                <div class="w-6 h-6 rounded-lg bg-indigo-500/20 flex items-center justify-center shrink-0 mt-1">
                                    <i class="fa-solid fa-bolt text-indigo-400 text-[10px]"></i>
                                </div>
                                <div>
                                    <h4 class="text-white font-semibold text-sm">Low-Latency Scheduling</h4>
                                    <p class="text-white/30 text-xs mt-1">Direct natural language processing for instant availability extraction.</p>
                                </div>
                            </li>
                            <li class="flex gap-4 items-start">
                                <div class="w-6 h-6 rounded-lg bg-blue-500/20 flex items-center justify-center shrink-0 mt-1">
                                    <i class="fa-solid fa-shield-heart text-blue-400 text-[10px]"></i>
                                </div>
                                <div>
                                    <h4 class="text-white font-semibold text-sm">Strict Domain Constraints</h4>
                                    <p class="text-white/30 text-xs mt-1">Focuses exclusively on dental health; redirects general medical inquiries for safety.</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="glass p-8 rounded-[32px] border-l-4 border-l-indigo-500/50">
                        <div class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest mb-4">Operational Protocol</div>
                        <div class="space-y-4 font-mono text-xs">
                            <div class="p-3 bg-white/5 rounded-xl border border-white/5">
                                <span class="text-white/30">Step 1:</span> <span class="text-indigo-400">Model</span> Extracts 2026-05-16 from text.
                            </div>
                            <div class="p-3 bg-white/5 rounded-xl border border-white/5">
                                <span class="text-white/30">Step 2:</span> <span class="text-blue-400">Backend</span> Runs SELECT against Supabase & BlockedDates.
                            </div>
                            <div class="p-3 bg-white/5 rounded-xl border border-white/5">
                                <span class="text-white/30">Step 3:</span> <span class="text-indigo-400">Model</span> Outputs structured JSON for SignalR Hub.
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Leadership -->
            <section class="opacity-0 translate-y-10 doc-section">
                <div class="flex flex-col md:flex-row gap-12 items-center">
                    <div class="md:w-1/2 space-y-6">
                        <h2 class="text-4xl font-bold">Leadership</h2>
                        <p class="text-white/40 leading-relaxed text-lg">
                            Behind the technology is a team of professionals committed to dental innovation and administrative excellence.
                        </p>
                        <div class="space-y-6 pt-4">
                            <div class="flex items-center gap-6 p-6 glass rounded-3xl border-l-4 border-l-indigo-500">
                                <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 flex items-center justify-center">
                                    <i class="fa-solid fa-user-doctor text-indigo-400 text-2xl"></i>
                                </div>
                                <div>
                                    <h4 class="text-white font-bold text-lg">Dr. Marcus Rivera</h4>
                                    <p class="text-indigo-400 text-xs font-bold uppercase tracking-widest">Chief Executive Officer</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-6 p-6 glass rounded-3xl border-l-4 border-l-blue-500">
                                <div class="w-14 h-14 rounded-2xl bg-blue-500/10 flex items-center justify-center">
                                    <i class="fa-solid fa-user-tie text-blue-400 text-2xl"></i>
                                </div>
                                <div>
                                    <h4 class="text-white font-bold text-lg">Samson Admin</h4>
                                    <p class="text-blue-400 text-xs font-bold uppercase tracking-widest">Clinic Administrator</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="md:w-1/2 grid grid-cols-2 gap-4">
                        <div class="glass p-6 rounded-3xl text-center">
                            <div class="text-3xl font-bold mb-1 gradient-text">60+</div>
                            <div class="text-white/30 text-[10px] uppercase font-bold tracking-widest">Years of Heritage</div>
                        </div>
                        <div class="glass p-6 rounded-3xl text-center">
                            <div class="text-3xl font-bold mb-1 gradient-text">2k+</div>
                            <div class="text-white/30 text-[10px] uppercase font-bold tracking-widest">Active Patients</div>
                        </div>
                        <div class="glass p-6 rounded-3xl text-center">
                            <div class="text-3xl font-bold mb-1 gradient-text">12</div>
                            <div class="text-white/30 text-[10px] uppercase font-bold tracking-widest">Specialists</div>
                        </div>
                        <div class="glass p-6 rounded-3xl text-center">
                            <div class="text-3xl font-bold mb-1 gradient-text">99%</div>
                            <div class="text-white/30 text-[10px] uppercase font-bold tracking-widest">System Uptime</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tech Stats -->
            <section class="opacity-0 translate-y-10 doc-section">
                <h2 class="text-2xl font-bold mb-12 flex items-center gap-4">
                    <span class="w-8 h-[1px] bg-indigo-500"></span>
                    Integrated Features
                </h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    @foreach (var feature in new[] { "Patient EHR", "Smart Scheduling", "Invoice Engine", "Analytics Suite", "SignalR Hubs", "Staff Portal", "Dynamic Chatbot", "Dental Charting" })
                    {
                        <div class="glass py-8 px-4 rounded-[32px] text-center group hover:bg-indigo-500 transition-all duration-500 hover:-translate-y-2">
                            <div class="text-white/80 font-bold text-xs uppercase tracking-widest">@feature</div>
                        </div>
                    }
                </div>
            </section>

            <!-- Developer Footnote -->
            <section class="opacity-0 translate-y-10 doc-section pb-20">
                <div class="glass p-12 rounded-[40px] relative overflow-hidden text-center">
                    <div class="relative z-10 max-w-2xl mx-auto">
                        <h2 class="text-3xl font-bold mb-6">Engineering Excellence</h2>
                        <p class="text-white/60 leading-relaxed mb-10">
                            Designed and engineered by <strong>Marc Kevin</strong> in collaboration with <strong>Antigravity AI</strong>. 
                            Our goal is to redefine dental management through software that is as beautiful as it is powerful.
                        </p>
                        <div class="flex justify-center gap-8">
                            <a href="#" class="text-white/40 hover:text-indigo-400 transition-colors flex items-center gap-2">
                                <i class="fa-brands fa-github"></i>
                                <span class="text-xs font-bold tracking-widest uppercase">Source</span>
                            </a>
                            <a href="#" class="text-white/40 hover:text-indigo-400 transition-colors flex items-center gap-2">
                                <i class="fa-solid fa-globe"></i>
                                <span class="text-xs font-bold tracking-widest uppercase">Website</span>
                            </a>
                        </div>
                    </div>
                    <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-indigo-500/10 rounded-full blur-[100px]"></div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tl = gsap.timeline();
            tl.to("#doc-header", { opacity: 1, duration: 1.5, ease: "power4.out" })
              .to(".doc-section", { opacity: 1, y: 0, stagger: 0.3, duration: 1, ease: "power3.out" }, "-=1");
        });
    </script>
}
