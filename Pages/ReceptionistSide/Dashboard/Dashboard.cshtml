@page "/Receptionist/Dashboard"
@model SamsonDentalCenterManagementSystem.Pages.ReceptionistSide.Dashboard.DashboardModel
@{
    Layout = "AdminSide/_StaffLayout";
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="page p-4 md:p-6 space-y-6">
    <!-- Welcome Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="font-display text-2xl font-bold text-brand tracking-tight">Welcome back, @ViewData["UserName"]</h2>
            <p class="text-[13px] text-brand/50 mt-1">Manage clinic flow and patient appointments with ease.</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/Receptionist/Appointments" class="bg-white border border-slate-200 text-brand text-[12.5px] font-bold px-4 py-2 rounded-xl hover:bg-slate-50 transition-all shadow-sm">View Calendar</a>
            <a href="/Receptionist/Patients" class="bg-primary text-white text-[12.5px] font-bold px-4 py-2 rounded-xl hover:bg-primary/90 transition-all shadow-sm">Patient Directory</a>
        </div>
    </div>

    <!-- Stat cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-5">
        <div class="stat-card stat-blue relative bg-white rounded-[32px] p-6 border border-slate-200 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <i class="fa-solid fa-user-group text-primary text-lg"></i>
                </div>
                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-blue-50 text-primary uppercase tracking-wider">Patients</span>
            </div>
            <div class="font-display text-3xl font-bold text-brand tracking-tight" id="stat-total-patients">@Model.TotalPatients</div>
            <div class="text-[13px] font-medium text-brand/50 mt-1">Total Patients</div>
            <div class="text-[11px] text-emerald-600 mt-2 font-bold" id="stat-patients-trend">Registered in system</div>
        </div>
        
        <div class="stat-card stat-teal relative bg-white rounded-[32px] p-6 border border-slate-200 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <i class="fa-solid fa-user-nurse text-emerald-600 text-lg"></i>
                </div>
                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600 uppercase tracking-wider">Active</span>
            </div>
            <div class="font-display text-3xl font-bold text-brand tracking-tight" id="stat-active-doctors">@Model.ActiveDoctorsCount</div>
            <div class="text-[13px] font-medium text-brand/50 mt-1">Doctors Available</div>
            <div class="text-[11px] text-emerald-600 mt-2 font-bold" id="stat-doctors-trend">On duty today</div>
        </div>

        <div class="stat-card stat-red relative bg-white rounded-[32px] p-6 border border-slate-200 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-red-50 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <i class="fa-solid fa-calendar-day text-red-600 text-lg"></i>
                </div>
                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-red-50 text-red-600 uppercase tracking-wider">Arrived</span>
            </div>
            <div class="font-display text-3xl font-bold text-brand tracking-tight" id="stat-today-appts">@Model.ArrivedTodayCount</div>
            <div class="text-[13px] font-medium text-brand/50 mt-1">Patients Arrived</div>
            <div class="text-[11px] text-red-500 mt-2 font-bold" id="stat-appts-trend">Today's visits</div>
        </div>

        <div class="stat-card stat-purple relative bg-white rounded-[32px] p-6 border border-slate-200 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-violet-50 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <i class="fa-solid fa-money-bill-trend-up text-violet-600 text-lg"></i>
                </div>
                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-violet-50 text-violet-600 uppercase tracking-wider">Month</span>
            </div>
            <div class="font-display text-3xl font-bold text-brand tracking-tight" id="stat-monthly-revenue">₱@Model.MonthlyRevenue.ToString("N0")</div>
            <div class="text-[13px] font-medium text-brand/50 mt-1">Monthly Billing</div>
            <div class="text-[11px] text-emerald-600 mt-2 font-bold" id="stat-revenue-trend">Real-time stats</div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <!-- Main Appointments (2/3) -->
        <div class="xl:col-span-2 space-y-6">
            <div class="bg-white rounded-[32px] border border-slate-200 overflow-hidden shadow-sm flex flex-col">
                <div class="px-6 py-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/30">
                    <div>
                        <h3 class="font-display font-bold text-brand text-lg tracking-tight">Incoming Schedule</h3>
                        <p class="text-[12px] text-brand/40 mt-0.5">Today's confirmed appointments at a glance.</p>
                    </div>
                    <a href="/Receptionist/Appointments" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-[11px] font-bold text-brand/60 hover:bg-slate-50 transition-all uppercase tracking-wider">View Calendar</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50/50">
                            <tr>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Patient</th>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Time</th>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status</th>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="upcoming-appts-body" class="divide-y divide-slate-100">
                             <!-- Hydrated by adminDashboard.js -->
                             <tr><td colspan="4" class="px-6 py-12 text-center text-slate-400 text-[13px] italic"><i class="fa-solid fa-spinner fa-spin mr-2"></i>Loading appointments...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Charts row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white rounded-[32px] p-8 border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <h3 class="font-display font-bold text-brand text-lg tracking-tight">Weekly Visits</h3>
                            <p class="text-[12px] text-brand/40">Patient traffic trend analysis</p>
                        </div>
                    </div>
                    <div class="h-64">
                        <canvas id="visitsChart"></canvas>
                    </div>
                </div>
                <div class="bg-white rounded-[32px] p-8 border border-slate-200 shadow-sm">
                    <h3 class="font-display font-bold text-brand text-lg tracking-tight mb-1">Department Load</h3>
                    <p class="text-[12px] text-brand/40 mb-8">Service distribution across specialties</p>
                    <div class="h-64 flex justify-center">
                        <canvas id="departmentChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar (1/3) -->
        <div class="space-y-6">
            <!-- Inquiry Widget -->
            <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-brand/5">
                    <div>
                        <h3 class="font-display font-bold text-brand">Pending Payments</h3>
                        <p class="text-[10px] text-brand/40 mt-0.5 uppercase tracking-widest font-bold">Billing Status Tracker</p>
                    </div>
                    <a href="/Receptionist/Billing" class="w-8 h-8 rounded-full bg-white flex items-center justify-center text-brand/30 hover:text-primary transition-colors border border-slate-100 shadow-sm">
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                </div>
                <div id="pending-payments-body" class="p-2 divide-y divide-slate-50 overflow-y-auto max-h-[350px]">
                    <div class="py-12 text-center text-slate-400 text-[12px] italic">Loading records…</div>
                </div>
            </div>

            <!-- Activity Logs -->
            <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="font-display font-bold text-brand">Clinic Pulse</h3>
                        <p class="text-[10px] text-brand/40 mt-0.5 uppercase tracking-widest font-bold">Recent Updates</p>
                    </div>
                </div>
                <div id="dashboard-activity-body" class="p-2 space-y-2 overflow-y-auto max-h-[400px]">
                    <!-- Hydrated by adminDashboard.js -->
                    <div class="py-12 text-center text-slate-400 text-[12px] italic">Loading activity...</div>
                </div>
            </div>
        </div>
    </div>
</div>

            <!-- Leave Quick Links -->
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-display font-bold text-brand text-[14px]">Quick Actions</h3>
                </div>
                <div class="grid grid-cols-1 gap-2">
                    <button onclick="openLeaveModal()" class="w-full flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-slate-100 transition-all group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center">
                                <i class="fa-solid fa-plane-departure text-[12px]"></i>
                            </div>
                            <span class="text-[12.5px] font-bold text-brand group-hover:text-primary transition-colors">Apply for Leave</span>
                        </div>
                        <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                    <a href="/Receptionist/Billing" class="w-full flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-slate-100 transition-all group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                                <i class="fa-solid fa-file-invoice-dollar text-[12px]"></i>
                            </div>
                            <span class="text-[12.5px] font-bold text-brand group-hover:text-primary transition-colors">Manage Billing</span>
                        </div>
                        <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:translate-x-1 transition-transform"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Leave Modal (Reuse existing logic) -->
<div id="leave-modal" class="fixed inset-0 z-[1000] hidden">
    <div class="absolute inset-0 bg-brand/40 backdrop-blur-md" onclick="closeLeaveModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md pointer-events-auto flex flex-col overflow-hidden">
            <div class="p-6 bg-brand text-white">
                <h3 class="font-display font-bold text-xl">Apply for Leave</h3>
                <p class="text-white/50 text-[11px] font-bold uppercase tracking-wider">Submit request for approval</p>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-[11px] font-bold text-brand/50 mb-1.5 ml-1">Leave Type</label>
                    <select id="leave-type" class="w-full text-[13px] px-4 py-3 rounded-2xl border border-slate-100 bg-slate-50 outline-none focus:ring-2 focus:ring-primary/20">
                        <option value="Sick Leave">Sick Leave</option>
                        <option value="Vacation">Vacation</option>
                        <option value="Emergency">Emergency</option>
                        <option value="Others">Others</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-bold text-brand/50 mb-1.5 ml-1">Start Date</label>
                        <input id="leave-start" type="date" class="w-full text-[13px] px-4 py-3 rounded-2xl border border-slate-100 bg-slate-50 outline-none" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-brand/50 mb-1.5 ml-1">End Date</label>
                        <input id="leave-end" type="date" class="w-full text-[13px] px-4 py-3 rounded-2xl border border-slate-100 bg-slate-50 outline-none" />
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-brand/50 mb-1.5 ml-1">Reason</label>
                    <textarea id="leave-reason" rows="3" class="w-full text-[13px] px-4 py-3 rounded-2xl border border-slate-100 bg-slate-50 outline-none resize-none" placeholder="Provide a brief reason..."></textarea>
                </div>
            </div>
            <div class="flex justify-end gap-3 p-6 bg-slate-50 border-t">
                <button onclick="closeLeaveModal()" class="text-[12px] font-bold text-brand/50 hover:text-brand transition-colors">Cancel</button>
                <button onclick="submitLeave()" class="px-6 py-2.5 bg-primary text-white text-[12px] font-bold rounded-xl shadow-lg hover:bg-primary/90 transition-all">Submit Request</button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="~/js/AdminSide/adminDashboard.js" asp-append-version="true"></script>

<script>
    function openLeaveModal() { document.getElementById('leave-modal').classList.remove('hidden'); }
    function closeLeaveModal() { document.getElementById('leave-modal').classList.add('hidden'); }

    async function submitLeave() {
        const payload = {
            leaveType: document.getElementById('leave-type').value,
            startDate: document.getElementById('leave-start').value,
            endDate: document.getElementById('leave-end').value,
            reason: document.getElementById('leave-reason').value
        };

        if(!payload.startDate || !payload.endDate) return alert('Select dates');

        const res = await fetch('/api/staff/leave/apply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        if(res.ok) {
            alert('Request submitted');
            location.reload();
        } else {
            alert('Failed to submit');
        }
    }
</script>
