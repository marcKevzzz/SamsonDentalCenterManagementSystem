    <div class="gallery-wrapper relative h-screen flex flex-col items-center justify-center">
        <h2 id="galleryText" class="brand-font font-black text-brand leading-none opacity-20 pointer-events-none" style="font-size: clamp(4rem, 15vw, 12rem);">
            THE CLINIC
        </h2>
        
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
             <!-- Scattered Images -->
             <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80" class="gallery-item absolute w-64 h-80 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 1%; left: 35%;" />
             <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=800&q=80" class="gallery-item absolute w-72 h-56 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 20%; right: 10%;" />
             <img src="https://images.unsplash.com/photo-1559757148-5c350d0d3c56?w=800&q=80" class="gallery-item absolute w-60 h-72 object-cover rounded-3xl shadow-2xl opacity-0" style="bottom: 5%; left: 80%;" />
             <img src="https://images.unsplash.com/photo-1609840114035-3c981b782dfe?w=800&q=80" class="gallery-item absolute w-80 h-60 object-cover rounded-3xl shadow-2xl opacity-0" style="bottom: 10%; right: 15%;" />
             <img src="https://images.unsplash.com/photo-1445527815219-ecbfec67492e?w=800&q=80" class="gallery-item absolute w-56 h-72 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 3%; left: 5%;" />
             <img src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80" class="gallery-item absolute w-64 h-56 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 40%; right: 5%;" />
             <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80" class="gallery-item absolute w-64 h-80 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 70%; left: 35%;" />
             <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=800&q=80" class="gallery-item absolute w-72 h-56 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 60%; right: 10%;" />
             <img src="https://images.unsplash.com/photo-1559757148-5c350d0d3c56?w=800&q=80" class="gallery-item absolute w-60 h-72 object-cover rounded-3xl shadow-2xl opacity-0" style="bottom: 15%; left: 20%;" />
             <img src="https://images.unsplash.com/photo-1609840114035-3c981b782dfe?w=800&q=80" class="gallery-item absolute w-80 h-60 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 5%; right: 5%;" />
             <img src="https://images.unsplash.com/photo-1445527815219-ecbfec67492e?w=800&q=80" class="gallery-item absolute w-56 h-72 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 45%; left: 5%;" />
             <img src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80" class="gallery-item absolute w-64 h-56 object-cover rounded-3xl shadow-2xl opacity-0" style="top: 30%; right: 45%;" />
        </div>
    </div>
</section>


<!-- ------------------------------------
     REVIEWS (Scroll Triggered)
------------------------------------- -->
<section id="reviews-pin" class="bg-[var(--brand-dark)] overflow-hidden relative py-24">
    <div class="reviews-wrapper h-screen flex flex-col justify-center">
        <div class="max-w mx-auto px-8 relative z-10 mb-12 text-center">
            <h2 class="brand-font font-extrabold text-white mb-4" style="font-size: clamp(2.5rem, 5vw, 4rem);">
                Trusted by <span class="text-primary italic">Thousands.</span>
            </h2>
            <p class="text-white/40 font-body text-sm max-w-xl mx-auto uppercase tracking-widest">
                Our patients' smiles are our greatest achievement. Hear from those who have experienced the Samson Standard.
            </p>
        </div>

        <div class="review-tracks-container flex flex-col gap-8">
            <!-- Row 1 -->
            <div id="track-1" class="flex gap-8 px-24">
                @foreach(var r in Model.Reviews.Take(Math.Max(1, Model.Reviews.Count))) {
                    <div class="review-card bg-white/5 border border-white/10 backdrop-blur-sm p-6 rounded-[2.5rem] w-[400px] shrink-0 transition-all duration-500">
                        <div class="flex items-center gap-4 mb-4">
                            <img src="@(string.IsNullOrEmpty(r.AuthorAvatar) ? "https://ui-avatars.com/api/?name=" + r.AuthorName : r.AuthorAvatar)" class="w-12 h-12 rounded-full border-2 border-primary/30" />
                            <div>
                                <div class="text-white text-base font-bold">@r.AuthorName</div>
                                <div class="text-white/40 text-[10px] uppercase tracking-[0.2em] font-black">Verified Patient</div>
                            </div>
                        </div>
                        <p class="text-white/40 text-sm leading-relaxed italic">"@r.ReviewText"</p>
                    </div>
                }
            </div>
            
            <!-- Row 2 -->
            <div id="track-2" class="flex gap-8 px-24 translate-x-[-10%]">
                @foreach(var r in Model.Reviews.Take(Math.Max(1, Model.Reviews.Count))) {
                    <div class="review-card bg-white/5 border border-white/10 backdrop-blur-sm p-6 rounded-[2.5rem] w-[400px] shrink-0 transition-all duration-500">
                        <div class="flex items-center gap-4 mb-4">
                            <img src="@(string.IsNullOrEmpty(r.AuthorAvatar) ? "https://ui-avatars.com/api/?name=" + r.AuthorName : r.AuthorAvatar)" class="w-12 h-12 rounded-full border-2 border-primary/30" />
                            <div>
                                <div class="text-white text-base font-bold">@r.AuthorName</div>
                                <div class="text-white/40 text-[10px] uppercase tracking-[0.2em] font-black">Verified Patient</div>
                            </div>
                        </div>
                        <p class="text-white/80 text-sm leading-relaxed italic">"@r.ReviewText"</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>


<!-- ------------------------------------
     OPERATING HOURS + MAP
------------------------------------- -->
<section id="location" class="bg-white py-24">
    <div class="max-w mx-auto px-8 lg:px-12 grid grid-cols-1 lg:grid-cols-2 gap-16">
      

    <!-- Left -->
      <div class="fade-up">
        <h2 class="brand-font font-extrabold text-[1.8rem] mb-7">Operating Hours</h2>

        <div class="bg-[var(--bg-soft)] rounded-2xl overflow-hidden">
          <div class="flex justify-between items-center px-7 py-5 border-b border-[#e5e7eb]">
            <span class="font-body text-[0.9rem] text-muted">Monday  Friday</span>
            <span class="brand-font font-bold text-[0.9rem]">9:00 AM  6:00 PM</span>
          </div>
          <div class="flex justify-between items-center px-7 py-5 border-b border-[#e5e7eb]">
            <span class="font-body text-[0.9rem] text-muted">Saturday</span>
            <span class="brand-font font-bold text-[0.9rem]">8:00 AM  5:00 PM</span>
          </div>
          <div class="flex justify-between items-center px-7 py-5">
            <span class="font-body text-[0.9rem] text-muted">Sunday</span>
            <span class="font-body text-[0.9rem] text-muted italic">Closed (By Appointment)</span>
          </div>
        </div>

        <h3 class="brand-font font-extrabold text-[1.5rem] mt-10 mb-2">Visit Us</h3>
        <p class="brand-font font-semibold text-[0.92rem] mb-2">
          @(Model.ClinicSettings.LocationAddress ?? "7 Himlayan Rd, Tandang Sora, Quezon City, Metro Manila")
        </p>
        <p class="font-body text-[0.84rem] text-muted leading-relaxed mb-5">
          Email: @(Model.ClinicSettings.ContactEmail ?? "support@samson.com") <br>
          Phone: @(Model.ClinicSettings.ContactPhone ?? "N/A")
          @if (!string.IsNullOrEmpty(Model.ClinicSettings.Landline)) { <span> | @Model.ClinicSettings.Landline</span> }
        </p>
        <a href="https://maps.google.com/?q=Tandang+Sora+Ave+Quezon+City" target="_blank"
          class="brand-font font-bold text-[0.74rem] tracking-[0.1em] uppercase text-[var(--brand-dark)] border-b-2 border-[var(--primary)] pb-0.5 hover:text-[var(--primary)] transition-colors no-underline group">
          GET DIRECTIONS <i class="fa-solid fa-arrow-right-long ml-2 group-hover:translate-x-1 transition-transform duration-300"></i>
        </a>
      </div>

    <!-- Right: Map -->
    <div class="reveal-up relative rounded-[1rem] overflow-hidden shadow-2xl border border-white/10 group h-[500px]">
      @if (!string.IsNullOrEmpty(Model.ClinicSettings.MapsUrl) && (Model.ClinicSettings.MapsUrl.Contains("google.com/maps/embed") || Model.ClinicSettings.MapsUrl.Contains("pb=")))
      {
          <iframe class="w-full h-full border-0"
            src="@Model.ClinicSettings.MapsUrl"
            allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade">
          </iframe>
      }
      else
      {
          <div class="w-full h-full bg-slate-100 flex flex-col items-center justify-center p-12 text-center">
              <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mb-6 shadow-sm">
                  <i class="fa-solid fa-map-location-dot text-brand text-3xl"></i>
              </div>
              <h3 class="brand-font font-bold text-brand text-xl mb-3">Interactive Map Not Ready</h3>
              <p class="font-body text-sm text-slate-500 max-w-xs mb-8">Please use the official Google Maps Embed URL in settings to enable the interactive view.</p>
              <a href="@(Model.ClinicSettings.MapsUrl ?? "https://maps.google.com/?q=Samson+Dental+Center")" target="_blank"
                 class="px-8 py-3 bg-brand text-white rounded-full font-bold text-xs uppercase tracking-widest hover:bg-primary transition-all shadow-lg shadow-brand/20">
                  Open in Google Maps
              </a>
          </div>
      }
    </div>

  </div>
</section>

<script type="module" src="~/js/PatientSide/home.js"></script>
