@page
@model IndexModel
@{
ViewData["Title"] = "Home page";
}
<script>
    window.reviewsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Reviews.Select(r => new {
        id = r.Id,
        author_name = r.AuthorName,
        author_avatar = r.AuthorAvatar,
        rating = r.Rating,
        review_text = r.ReviewText,
        platform = r.Platform,
        external_link = r.ExternalLink,
        review_date = r.ReviewDate ?? r.CreatedAt,
        created_at = r.CreatedAt
    })));

    window.clinicSettings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        faqs = Model.ClinicSettings.FaqsRaw,
        hours = Model.ClinicSettings.ClinicalHoursRaw,
        photos = Model.ClinicSettings.ClinicPhotosRaw,
        status = new {
            isAutomated = Model.ClinicSettings.IsAutomatedStatus,
            manual = Model.ClinicSettings.ManualStatus
        }
    }));
</script>

<section id="hero" class="relative h-[105vh] min-h-[700px] flex items-center overflow-hidden bg-[var(--brand-dark)] relative ">
    <!-- Skeleton Loader -->
    <div class="hero-skeleton" id="heroSkeleton"></div>

    <!-- BG layers -->
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--brand-dark)] via-[#1e293b] to-[var(--brand-dark)]"></div>
    <div id="heroBg" class="home-hero-bg-img absolute inset-0 opacity-0 transition-opacity duration-1000 scale-105"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-brand/95 via-brand/80 to-brand/60"></div>

    <!-- Content -->
    <div id="heroContent" class="relative z-10 max-w mx-auto px-8 md:px-4 2xl:px-8 w-full flex flex-col lg:flex-row lg:items-center justify-between gap-12 ">
        <div class="max-w-3xl xl:w-1/2">
            <span class="hp-reveal inline-block w-fit font-body text-[0.68rem] font-medium tracking-[0.15em] uppercase text-white/50 bg-white/[0.05] px-3 py-1.5 rounded-full mb-4 border border-white/5">
                Established 1964
            </span>

            <h1 id="heroTitle" class="brand-font font-extrabold leading-[0.95] text-white mb-6 flex flex-col"
                style="font-size: clamp(2rem, 5vw, 3.8rem);">
                <span class="hp-reveal overflow-hidden">
                    <span class="hp-word inline-block">Unlock a World</span>
                </span>
                <span class="hp-reveal overflow-hidden">
                    <span class="hp-word inline-block">of Radiant</span>
                </span>
                <span class="hp-reveal overflow-hidden">
                    <span class="hp-word inline-block text-primary brightness-115">Smiles</span>
                </span>
                
            </h1>

            <p class="hp-reveal-late font-body text-base text-white/60 max-w-[430px] leading-relaxed sm:mb-10 mb-6">
                Exceptional Dental Care Powered by Expertise, Innovation and Advanced Technology. Trusted by companies and individuals for over 60 years.
            </p>

            <div class="hp-reveal-late flex flex-wrap gap-2">
                <a href="/Appointments"
                    class="brand-font font-bold text-xs sm:text-sm bg-[var(--primary)] text-white px-6 sm:px-8 py-3 sm:py-4 rounded-full hover:scale-105 hover:shadow-[0_10px_20px_rgba(30,64,175,0.3)] transition-all duration-300 no-underline flex items-center gap-2 group">
                    Book Treatment
                    <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </a>
                <a href="/Services"
                    class="brand-font font-bold text-xs sm:text-sm border-2 border-white/20 text-white px-6 sm:px-8 py-3 sm:py-4 rounded-full hover:border-white hover:scale-105 transition-all duration-300 no-underline">
                    Our Services
                </a>
            </div>
        </div>

        <!-- Right side: Doctor Portrait -->
        <div class="xl:w-1/2 hidden xl:flex justify-end items-end relative h-full">
            <div id="doctor-interaction-area" class="hero-doctor-container relative h-[90%] flex items-end">
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-primary/20 blur-[120px] rounded-full -z-10 animate-pulse"></div>
                <img src="~/images/hero_doc1-remove.png" alt="Dentist" class="hp-doctor-img h-[95%] w-auto object-contain object-bottom" />
                
                <div id="doctor-pill" class="hp-glass-badge absolute top-[60%] -left-12 bg-white/10 backdrop-blur-xl border border-white/20 p-5 rounded-3xl shadow-2xl flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-primary flex items-center justify-center shadow-lg">
                        <i class="fa-solid fa-star text-white text-xl"></i>
                    </div>
                    <div>
                        <div class="text-[0.65rem] font-black uppercase tracking-[0.25em] text-white/50 mb-1">Top Rated</div>
                        <div class="text-[1.1rem] font-extrabold text-white leading-none" style="text-shadow: 
                          -0.5px -0.5px 0 #545e6d,  
                          0.5px -0.5px 0 #545e6d,
                          -0.5px  0.5px 0 #545e6d,
                          0.5px  0.5px 0 #545e6d;
                      ">Pioneer Care</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<div class="absolute bottom-[-1px] left-0 w-[150%] overflow-hidden z-10 scale-x-[-1] rotate-180 pointer-events-none">
    <svg class="relative block w-[150%] lg:w-full h-[60px] lg:h-[120px] fill-[#f8fafc]" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5,73.84-4.36,147.54,16.88,218.2,35.26,69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113,2,1200,40V0Z" opacity=".45"></path>
        <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-20V0Z" opacity=".5"></path>
        <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-60V0Z"></path>
    </svg>
</div>
</section>

<!-- Wavy Transition -->

<!-- ------------------------------------
     THE SAMSON STANDARD (Why Choose Us)
------------------------------------- -->
<section id="features" class="bg-[var(--bg-soft)] section-padding">
  <div class="max-w mx-auto px-8 lg:px-12">

    <!-- Section header -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-8 mb-16 sm:mb-20">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 font-body text-[0.65rem] font-bold tracking-[0.2em] uppercase text-[var(--primary)] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-pulse"></span>
          Why Choose Us?
        </div>
        <h2 class="brand-font font-extrabold leading-[1.1] text-[var(--brand-dark)]" style="font-size:clamp(2.2rem, 5vw, 3.5rem);">
          Pioneering <br><span class="text-gradient">Dental Care</span>
        </h2>
      </div>
      <p class="font-body text-[0.95rem] text-muted leading-relaxed max-w-[420px]">
        Samson Dental Center has its roots since 1964. Now on its 3rd generation, we incorporate skill, experience and technology under one roof.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="reveal-up grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Feature 1: History -->
      <div class="hp-feature-card group bg-white p-6 rounded-[2rem] border border-blue-50 shadow-sm hover:shadow-xl transition-all duration-500 relative overflow-hidden">
        <div class="w-12 h-12 bg-primary rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-landmark text-white text-lg group-hover:scale-1.1 group-hover:rotate-[15deg] transition-transform duration-300"></i>
        </div>
        <h3 class="brand-font font-bold text-lg mb-3 text-[var(--brand-dark)]">Heritage & Trust</h3>
        <p class="font-body text-[0.82rem] text-muted leading-relaxed">
          Pioneer of dental advancements in Baguio since 1964, building trust across generations.
        </p>
      </div>

      <!-- Feature 2: Ortho -->
      <div class="hp-feature-card group bg-white p-6 rounded-[2rem] border border-blue-50 shadow-sm hover:shadow-xl transition-all duration-500 relative overflow-hidden">
        <div class="w-12 h-12 bg-primary rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-teeth text-white text-lg group-hover:scale-1.1 group-hover:rotate-[15deg] transition-transform duration-300"></i>
        </div>
        <h3 class="brand-font font-bold text-lg mb-3 text-[var(--brand-dark)]">Orthodontics</h3>
        <p class="font-body text-[0.82rem] text-muted leading-relaxed">
          Straightening teeth for all ages. We make your dream of a perfect smile a reality.
        </p>
      </div>

      <!-- Feature 3: Implants -->
      <div class="hp-feature-card group bg-white p-6 rounded-[2rem] border border-blue-50 shadow-sm hover:shadow-xl transition-all duration-500 relative overflow-hidden">
        <div class="w-12 h-12 bg-primary rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-tooth text-white text-lg group-hover:scale-1.1 group-hover:rotate-[15deg] transition-transform duration-300"></i>
        </div>
        <h3 class="brand-font font-bold text-lg mb-3 text-[var(--brand-dark)]">Dental Implants</h3>
        <p class="font-body text-[0.82rem] text-muted leading-relaxed">
          Mimic the look and feel of natural teeth with our experienced restorative specialists.
        </p>
      </div>

      <!-- Feature 4: General -->
      <div class="hp-feature-card group bg-white p-6 rounded-[2rem] border border-blue-50 shadow-sm hover:shadow-xl transition-all duration-500 relative overflow-hidden">
        <div class="w-12 h-12 bg-primary rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-heart-pulse text-white text-lg group-hover:scale-1.1 group-hover:rotate-[15deg] transition-transform duration-300"></i>
        </div>
        <h3 class="brand-font font-bold text-lg mb-3 text-[var(--brand-dark)]">General Care</h3>
        <p class="font-body text-[0.82rem] text-muted leading-relaxed">
          From cleanings to extractions, we promise a comfortable and positive experience.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- ------------------------------------
     GALLERY (Scattered & Pinned)
------------------------------------- -->
