@page "/Doctor/Availability"
@model SamsonDentalCenterManagementSystem.Helpers.AdminPageModel
@{
    Layout = "AdminSide/_StaffLayout";
}

<div id="page-availability" class="page p-4 md:p-6">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <div>
      <h2 class="font-display text-xl font-extrabold text-brand-900">My Schedule & Leave</h2>
      <p class="text-[12px] text-brand-500 mt-0.5">Manage your availability and leave requests</p>
    </div>
    <button onclick="document.getElementById('leave-modal').classList.remove('hidden')" class="bg-primary text-white text-[12px] font-bold px-4 py-2 rounded-xl hover:bg-primary/90 transition-all shadow-sm flex items-center gap-2">
      <i class="fa-solid fa-plus"></i> Request Leave
    </button>
  </div>
  
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Schedule Calendar -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-5">
        <h3 class="font-display font-bold text-brand mb-4">My Weekly Availability</h3>
        <div id="availability-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="col-span-full py-8 text-center text-brand-400 text-[12px]"><i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Loading availability...</div>
        </div>
    </div>
    
    <!-- Leave Requests -->
    <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h3 class="font-display font-bold text-brand mb-4">My Leave Requests</h3>
        <div id="leaves-container" class="space-y-3 divide-y divide-slate-100">
             <div class="py-8 text-center text-brand-400 text-[12px]"><i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Loading leaves...</div>
        </div>
    </div>
  </div>
</div>

<!-- Request Leave Modal -->
<div id="leave-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h3 class="font-display font-bold text-brand">Request Leave</h3>
                <p class="text-[11px] text-brand-400 mt-0.5">Submit a new leave request for approval</p>
            </div>
            <button onclick="document.getElementById('leave-modal').classList.add('hidden')" class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:bg-rose-50 hover:text-rose-500 transition-colors">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>
        <div class="p-6 space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">Start Date</label>
                    <input type="date" id="leave-start" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-[13px] outline-none focus:border-primary transition-all text-brand" />
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">End Date</label>
                    <input type="date" id="leave-end" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-[13px] outline-none focus:border-primary transition-all text-brand" />
                </div>
            </div>
            <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">Leave Type</label>
                <select id="leave-type" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-[13px] outline-none focus:border-primary transition-all text-brand">
                    <option value="Sick">Sick Leave</option>
                    <option value="Vacation">Vacation</option>
                    <option value="Emergency">Emergency</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">Reason</label>
                <textarea id="leave-reason" rows="3" placeholder="Briefly describe your reason..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-[13px] outline-none focus:border-primary transition-all text-brand resize-none"></textarea>
            </div>
            <button onclick="submitLeave()" class="w-full bg-primary text-white text-[13px] font-bold py-2.5 rounded-xl hover:bg-primary/90 transition-all shadow-sm">
                Submit Request
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/AdminSide/staffAvailability.js"></script>
}
