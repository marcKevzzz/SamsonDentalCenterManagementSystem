@page "/Doctor/Patients"
@model SamsonDentalCenterManagementSystem.Pages.DoctorSide.Patients.IndexModel
@{
    Layout = "AdminSide/_StaffLayout";
    ViewData["Title"] = "My Patients";
}

@section Scripts {
    <script type="module" src="~/js/AdminSide/adminPatient.js" asp-append-version="true"></script>
}

<div class="page p-4 md:p-6 bg-slate-50 min-h-screen">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h2 class="text-xl font-bold text-brand tracking-tight">Patient Directory</h2>
      <p class="text-[11px] text-brand/40 mt-0.5 uppercase font-bold tracking-widest">Manage your assigned patients and clinical records</p>
    </div>
    <div class="flex items-center gap-2">
       <button id="addPatientBtn" class="px-4 py-2 bg-primary text-white rounded-xl text-[12px] font-bold shadow-md hover:shadow-lg hover:scale-[1.01] transition-all flex items-center gap-2">
          <i class="fa-solid fa-user-plus text-[10px]"></i>
          Add Patient
       </button>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/60 shadow-sm mb-6">
    <div class="flex flex-wrap items-center gap-4">
      <div class="relative flex-1 min-w-[240px]">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 translate-half text-slate-400 text-[12px]"></i>
        <input id="patient-search" oninput="filterPatients()" placeholder="Search by name or ID..."
          class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary/50 focus:ring-4 focus:ring-primary/5 transition-all" />
      </div>
      <select id="patient-status" onchange="filterPatients()"
        class="px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary/50 font-medium">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
      </select>
    </div>
  </div>

  <!-- Patients Table -->
  <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50/80 border-b border-slate-100">
            <th class="px-4 py-4 text-[10px] font-bold text-brand/40 uppercase tracking-widest">Patient Details</th>
            <th class="px-4 py-4 text-[10px] font-bold text-brand/40 uppercase tracking-widest">Contacts</th>
            <th class="px-4 py-4 text-[10px] font-bold text-brand/40 uppercase tracking-widest">Age / Gender</th>
            <th class="px-4 py-4 text-[10px] font-bold text-brand/40 uppercase tracking-widest">Last Visit</th>
            <th class="px-4 py-4 text-[10px] font-bold text-brand/40 uppercase tracking-widest">Assigned Doctor</th>
            <th class="px-4 py-4 text-[10px] font-bold text-brand/40 uppercase tracking-widest">Account Status</th>
            <th class="px-4 py-4 text-[10px] font-bold text-brand/40 uppercase tracking-widest text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="patients-body">
          <tr>
            <td colspan="6" class="px-4 py-20 text-center">
              <div class="flex flex-col items-center gap-3">
                <div class="w-10 h-10 border-4 border-primary/20 border-t-primary rounded-full animate-spin"></div>
                <span class="text-[12px] font-medium text-slate-400">Loading patients...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div id="patients-pagination" class="hidden items-center justify-between px-6 py-4 border-t border-slate-50 bg-slate-50/30">
      <div id="patients-info" class="text-[11.5px] font-medium text-brand/50"></div>
      <div id="patients-btns" class="flex items-center gap-1"></div>
    </div>
  </div>
</div>

<!-- Add/Edit Patient Modal -->
<div id="userModal" class="fixed inset-0 z-[1000] hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-brand/40 backdrop-blur-sm"></div>
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-2xl overflow-hidden relative animate-in fade-in zoom-in duration-300">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div>
                <h3 id="modalTitle" class="text-lg font-bold text-brand font-display">Add New Patient</h3>
                <p class="text-[10px] text-brand/40 font-bold uppercase tracking-widest mt-0.5">Enter basic information to create a record</p>
            </div>
            <button onclick="closeUserModal()" class="w-8 h-8 flex items-center justify-center rounded-xl hover:bg-slate-100 text-slate-400 transition-colors">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <form id="patientForm" class="p-8 space-y-6" onsubmit="event.preventDefault(); saveUser();">
            <input type="hidden" id="modalUserId" />
            
            <div class="flex flex-col items-center mb-4">
                <div class="relative group">
                    <img id="avatarPreview" src="/images/default-avatar.png" class="w-24 h-24 rounded-3xl object-cover ring-4 ring-slate-50 shadow-xl" />
                    <label class="absolute -bottom-2 -right-2 w-8 h-8 rounded-xl bg-primary text-white flex items-center justify-center cursor-pointer shadow-lg hover:scale-110 transition-all border-4 border-white">
                        <i class="fa-solid fa-camera text-xs"></i>
                        <input type="file" id="mAvatar" class="hidden" accept="image/*" onchange="previewAvatar(this)" />
                    </label>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-brand/40 uppercase ml-1">First Name</label>
                    <input id="mFirstName" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary transition-all shadow-inner" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-brand/40 uppercase ml-1">Last Name</label>
                    <input id="mLastName" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary transition-all shadow-inner" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-brand/40 uppercase ml-1">Email Address</label>
                    <input id="mEmail" type="email" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary transition-all shadow-inner" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-brand/40 uppercase ml-1">Phone Number</label>
                    <input id="mPhone" placeholder="09XXXXXXXXX" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary transition-all shadow-inner" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-brand/40 uppercase ml-1">Date of Birth</label>
                    <input id="mDob" type="date" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary transition-all shadow-inner" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-brand/40 uppercase ml-1">Gender</label>
                    <select id="mSex" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary transition-all shadow-inner font-medium">
                        <option value="">Select...</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="md:col-span-2 flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-brand/40 uppercase ml-1">Address</label>
                    <textarea id="mAddress" rows="2" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-[13px] outline-none focus:border-primary transition-all shadow-inner resize-none"></textarea>
                </div>
                <div class="flex flex-col gap-1.5 hidden">
                    <label class="text-[10px] font-bold text-brand/40 uppercase ml-1">Role</label>
                    <input id="mRole" value="patient" readonly />
                </div>
            </div>

            <div class="flex items-center gap-3 pt-4">
                <button type="button" onclick="closeUserModal()" class="flex-1 px-6 py-3 rounded-2xl bg-slate-100 text-slate-600 text-[12px] font-bold hover:bg-slate-200 transition-all">Cancel</button>
                <button id="modalSaveBtn" type="submit" class="flex-1 px-6 py-3 rounded-2xl bg-primary text-white text-[12px] font-bold shadow-lg shadow-primary/20 hover:shadow-primary/30 transition-all">Save Patient</button>
            </div>
        </form>
    </div>
</div>

<script>
    function previewAvatar(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = (e) => {
                document.getElementById('avatarPreview').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

<style>
    .font-display { font-family: 'Syne', sans-serif; }
    .animate-spin { animation: spin 1s linear infinite; }
    @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>
