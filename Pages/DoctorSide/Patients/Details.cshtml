@page "/Doctor/Patients/Details"
@model SamsonDentalCenterManagementSystem.Pages.DoctorSide.Patients.PatientDetailsModel
@{
    Layout = "AdminSide/_StaffLayout";
    var p = Model.Patient;
    var initials = p != null ? $"{(p.FirstName.Length > 0 ? p.FirstName[0] : ' ')}{(p.LastName.Length > 0 ? p.LastName[0] : ' ')}".Trim().ToUpper() : "??";
    var age = p?.DateOfBirth.HasValue == true ? (DateTime.Today.Year - p.DateOfBirth.Value.Year).ToString() : "N/A";
}

<div class="page p-4 md:p-6 bg-slate-50 min-h-screen">
    <!-- Header / Breadcrumbs -->
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <a href="/Doctor/Patients" class="w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center text-brand-500 hover:bg-slate-50 transition-colors">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            </a>
            <div>
                <h2 class="text-xl font-bold text-brand-900 font-display">Patient Profile</h2>
                <div class="flex items-center gap-2 text-[11px] text-brand-400">
                    <span>Doctor</span>
                    <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"/></svg>
                    <span>Patients</span>
                    <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"/></svg>
                    <span class="text-brand-600 font-medium">@p?.FirstName @p?.LastName</span>
                </div>
            </div>
        </div>
        <div class="flex gap-2">
            <button onclick="openNewAppointment()" class="px-4 py-2 bg-primary text-white rounded-xl text-[12.5px] font-bold shadow-md shadow-primary/20 hover:shadow-primary/30 transition-all flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                New Appointment
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Sidebar: Patient Info -->
        <div class="lg:col-span-3 space-y-6">
            <div class="bg-white rounded-3xl p-6 border border-slate-200/60 shadow-sm">
                <div class="flex flex-col items-center text-center mb-6">
                    <div class="relative mb-4">
                        @if (!string.IsNullOrEmpty(p?.AvatarUrl)) {
                            <img src="@p.AvatarUrl" class="w-24 h-24 rounded-3xl object-cover ring-4 ring-slate-50 shadow-lg" />
                        } else {
                            <div class="w-24 h-24 rounded-3xl bg-primary flex items-center justify-center text-white text-3xl font-bold font-display shadow-lg ring-4 ring-slate-50">
                                @initials
                            </div>
                        }
                        <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-emerald-500 border-4 border-white"></div>
                    </div>
                    <h3 class="text-lg font-bold text-brand-900 font-display">@p?.FirstName @p?.LastName</h3>
                    <span class="text-[11px] font-bold uppercase tracking-wider @(p?.IsActive == true ? "text-emerald-500" : "text-rose-500")">@(p?.IsActive == true ? "ACTIVE" : "INACTIVE")</span>
                </div>

                <div class="space-y-4">
                    <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100">
                        <div class="w-8 h-8 rounded-xl bg-white flex items-center justify-center text-brand-500 shadow-sm">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div>
                            <div class="text-[10px] text-brand-400 font-bold uppercase">Age / Gender</div>
                            <div class="text-[13px] font-bold text-brand-800">@age yrs / @(p?.Sex ?? "N/A")</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100">
                        <div class="w-8 h-8 rounded-xl bg-white flex items-center justify-center text-brand-500 shadow-sm">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <div>
                            <div class="text-[10px] text-brand-400 font-bold uppercase">Phone</div>
                            <div class="text-[13px] font-bold text-brand-800">@p?.PhoneNumber</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100">
                        <div class="w-8 h-8 rounded-xl bg-white flex items-center justify-center text-brand-500 shadow-sm">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <div class="overflow-hidden">
                            <div class="text-[10px] text-brand-400 font-bold uppercase">Email</div>
                            <div class="text-[13px] font-bold text-brand-800 truncate">@p?.Email</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="lg:col-span-9 space-y-6">
            <!-- Summary Tiles -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div class="bg-white p-5 rounded-3xl border border-slate-200/60 shadow-sm flex items-center gap-4 group hover:border-rose-100 transition-all">
                    <div class="w-11 h-11 rounded-xl bg-rose-50 text-rose-500 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-wallet text-lg"></i>
                    </div>
                    <div>
                        <div class="text-[9px] text-brand-400 font-bold uppercase tracking-widest mb-0.5">Balance</div>
                        <div class="text-xl font-bold text-brand-900">₱@Model.OutstandingBalance.ToString("N0")</div>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-3xl border border-slate-200/60 shadow-sm flex items-center gap-4 group hover:border-brand-100 transition-all">
                    <div class="w-11 h-11 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-calendar-check text-lg"></i>
                    </div>
                    <div>
                        <div class="text-[9px] text-brand-400 font-bold uppercase tracking-widest mb-0.5">Next Visit</div>
                        @if (Model.NextAppointment != null) {
                            <div class="text-[13px] font-bold text-brand-900">@Model.NextAppointment.AppointmentDate.ToString("MMM dd")</div>
                            <div class="text-[10px] font-bold text-brand-400 uppercase">@Model.NextAppointment.AppointmentTime</div>
                        } else {
                            <div class="text-[12px] font-bold text-slate-300 italic">None Scheduled</div>
                        }
                    </div>
                </div>

                <div class="bg-white p-5 rounded-3xl border border-slate-200/60 shadow-sm flex items-center gap-4 group hover:border-emerald-100 transition-all">
                    <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-tooth text-lg"></i>
                    </div>
                    <div>
                        <div class="text-[9px] text-brand-400 font-bold uppercase tracking-widest mb-0.5">Last Treatment</div>
                        @if (Model.LastTreatmentDate.HasValue) {
                            <div class="text-[13px] font-bold text-brand-900">@Model.LastTreatmentDate.Value.ToString("MMM dd, yyyy")</div>
                            <div class="text-[10px] font-bold text-brand-400 uppercase truncate max-w-[120px]">@Model.ClinicalTimeline.FirstOrDefault()?.ServiceName</div>
                        } else {
                            <div class="text-[12px] font-bold text-slate-300 italic">New Patient</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Tabs Module -->
            <div class="space-y-5">
                <!-- Tab Bar -->
                <div class="flex items-center justify-between">
                    <div id="tab-bar" class="flex gap-1.5 bg-white p-1 rounded-xl border border-slate-200/60 shadow-sm overflow-x-auto hide-scrollbar">
                        <button onclick="switchTab('timeline')" data-tab="timeline" class="tab-btn active px-4 sm:px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all whitespace-nowrap">History</button>
                        <button onclick="switchTab('chart')" data-tab="chart" class="tab-btn text-brand-400 hover:bg-slate-50 px-4 sm:px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all whitespace-nowrap">Chart</button>
                        <button onclick="switchTab('medical')" data-tab="medical" class="tab-btn text-brand-400 hover:bg-slate-50 px-4 sm:px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all whitespace-nowrap">Medical</button>
                        <button onclick="switchTab('appointments')" data-tab="appointments" class="tab-btn text-brand-400 hover:bg-slate-50 px-4 sm:px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all whitespace-nowrap">Visits</button>
                        <button onclick="switchTab('evaluation')" data-tab="evaluation" class="tab-btn text-brand-400 hover:bg-slate-50 px-4 sm:px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all whitespace-nowrap">Evaluation</button>
                        <button onclick="switchTab('notes')" data-tab="notes" class="tab-btn text-brand-400 hover:bg-slate-50 px-4 sm:px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all whitespace-nowrap">Notes</button>
                    </div>
                    
                    <div class="hidden md:flex items-center gap-3 text-[10px] font-bold text-brand-400">
                        <div class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Stable</div>
                        <div class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-900"></span> Active</div>
                    </div>
                </div>

                <!-- Tab Content: Evaluation -->
                <div id="content-evaluation" class="tab-content hidden bg-white rounded-3xl p-6 border border-slate-200/60 shadow-sm space-y-6">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-md font-bold text-brand-900 font-display">Oral Health Evaluation</h4>
                        <button onclick="saveEvaluation()" class="px-4 py-1.5 bg-primary/10 text-primary text-[12px] font-bold rounded-lg hover:bg-primary hover:text-white transition-all">Save Evaluation</button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Score -->
                        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 flex flex-col items-center justify-center text-center">
                            <div class="text-[11px] font-bold text-brand-400 uppercase tracking-widest mb-4">Health Score</div>
                            <div class="relative w-28 h-28 flex items-center justify-center">
                                <svg class="w-full h-full -rotate-90">
                                    <circle cx="56" cy="56" r="50" fill="none" stroke="#e2e8f0" stroke-width="8"></circle>
                                    <circle cx="56" cy="56" r="50" fill="none" stroke="currentColor" stroke-width="8" stroke-dasharray="314" :stroke-dashoffset="314 - (314 * (parseInt(document.getElementById('health-score-input')?.value || 0) / 100))" class="text-primary transition-all duration-1000"></circle>
                                </svg>
                                <input type="number" id="health-score-input" value="0" min="0" max="100" class="absolute text-2xl font-bold text-brand-900 bg-transparent text-center w-16 outline-none" />
                                <span class="absolute bottom-6 text-[10px] font-bold text-brand-400">/ 100</span>
                            </div>
                        </div>

                        <!-- Metrics -->
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                <span class="text-[12px] font-bold text-brand-600">Gum Health</span>
                                <select id="eval-gum" class="text-[11px] font-bold px-3 py-1 rounded-lg border border-slate-200 bg-white outline-none">
                                    <option value="Healthy">Healthy</option>
                                    <option value="Gingivitis">Gingivitis</option>
                                    <option value="Periodontitis">Periodontitis</option>
                                </select>
                            </div>
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                <span class="text-[12px] font-bold text-brand-600">Cavity Risk</span>
                                <select id="eval-cavity" class="text-[11px] font-bold px-3 py-1 rounded-lg border border-slate-200 bg-white outline-none">
                                    <option value="Low">Low</option>
                                    <option value="Moderate">Moderate</option>
                                    <option value="High">High</option>
                                </select>
                            </div>
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                <span class="text-[12px] font-bold text-brand-600">Enamel Status</span>
                                <select id="eval-enamel" class="text-[11px] font-bold px-3 py-1 rounded-lg border border-slate-200 bg-white outline-none">
                                    <option value="Strong">Strong</option>
                                    <option value="Thinning">Thinning</option>
                                    <option value="Eroded">Eroded</option>
                                </select>
                            </div>
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                <span class="text-[12px] font-bold text-brand-600">Plaque Level</span>
                                <select id="eval-plaque" class="text-[11px] font-bold px-3 py-1 rounded-lg border border-slate-200 bg-white outline-none">
                                    <option value="None">None</option>
                                    <option value="Mild">Mild</option>
                                    <option value="Moderate">Moderate</option>
                                    <option value="Heavy">Heavy</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                        <label class="block text-[11px] font-bold text-brand-400 uppercase mb-2">Doctor's Recommendations</label>
                        <textarea id="eval-notes" class="w-full p-4 rounded-xl border border-slate-200 bg-white text-[13px] outline-none focus:border-primary resize-none" rows="3" placeholder="Add specific advice for the patient dashboard...">Continue daily flossing and use fluoride mouthwash.</textarea>
                    </div>
                </div>

                <!-- Tab Content: Timeline -->
                <div id="content-timeline" class="tab-content hidden bg-white rounded-3xl p-6 border border-slate-200/60 shadow-sm">
                    <h4 class="text-md font-bold text-brand-900 mb-6 font-display flex items-center gap-2">
                        Clinical History
                        <span class="px-2 py-0.5 bg-slate-100 text-[10px] text-brand-400 rounded-full">@Model.ClinicalTimeline.Count records</span>
                    </h4>

                    @if (Model.ClinicalTimeline.Any()) {
                        <div class="relative space-y-8 before:absolute before:left-4 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-100">
                            @foreach (var t in Model.ClinicalTimeline) {
                                <div class="relative pl-10 group">
                                    <div class="absolute left-0 top-1.5 w-8 h-8 rounded-full bg-white border-2 border-primary flex items-center justify-center z-10 shadow-sm transition-transform group-hover:scale-110">
                                        <div class="w-2.5 h-2.5 rounded-full bg-primary"></div>
                                    </div>
                                    <div class="bg-white border border-slate-100 rounded-2xl p-5 hover:border-primary/20 hover:shadow-xl hover:shadow-slate-200/50 transition-all duration-300">
                                        <div class="flex items-center justify-between mb-3">
                                            <div class="text-[14px] font-bold text-brand-900">@t.ServiceName</div>
                                            <div class="px-3 py-1 bg-slate-50 rounded-lg text-[11px] font-bold text-brand-400">@t.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </div>
                                        <div class="space-y-3">
                                            @if (!string.IsNullOrEmpty(t.ToothNumbers)) {
                                                <div class="flex items-center gap-2">
                                                    <span class="text-[10px] font-bold uppercase text-brand-400">Teeth:</span>
                                                    <div class="flex gap-1">
                                                        @foreach(var tooth in t.ToothNumbers.Split(',')) {
                                                            <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-bold rounded-md border border-blue-100">@tooth.Trim()</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            <p class="text-[13px] text-brand-600 leading-relaxed bg-slate-50/50 p-3 rounded-xl italic">"@t.ProcedureDetails"</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    } else {
                        <div class="bg-white rounded-2xl p-12 text-center border border-slate-100 shadow-sm mt-4">
                            <div class="w-16 h-16 bg-slate-50 rounded-xl flex items-center justify-center mx-auto mb-4">
                                <i class="fa-solid fa-folder-open text-slate-200 text-2xl"></i>
                            </div>
                            <h4 class="text-lg font-bold text-brand-900 mb-1">No Clinical History</h4>
                            <p class="text-[12px] text-brand-400 max-w-xs mx-auto">This patient hasn't had any recorded treatments yet.</p>
                        </div>
                    }
                </div>

                <!-- Tab Content: Chart -->
                <div id="content-chart" class="tab-content hidden">
                    <div class="bg-white rounded-3xl p-8 border border-slate-200/60 shadow-sm overflow-x-auto">
                        <div class="min-w-[800px]">
                            <div class="flex items-center justify-between mb-8">
                                <div>
                                    <h3 class="text-lg font-bold text-brand-900 font-display">Odontogram Visualization</h3>
                                    <p class="text-[10px] text-brand-400 font-bold uppercase tracking-widest mt-0.5">Digital charting of patient tooth status</p>
                                </div>
                                <div class="flex gap-3">
                                    <div class="flex items-center gap-2 text-[9px] font-bold text-brand-400 uppercase tracking-widest"><span class="w-2.5 h-2.5 rounded bg-emerald-500 shadow-sm"></span> Healthy</div>
                                    <div class="flex items-center gap-2 text-[9px] font-bold text-brand-400 uppercase tracking-widest"><span class="w-2.5 h-2.5 rounded bg-blue-500 shadow-sm"></span> Filled</div>
                                    <div class="flex items-center gap-2 text-[9px] font-bold text-brand-400 uppercase tracking-widest"><span class="w-2.5 h-2.5 rounded bg-rose-500 shadow-sm"></span> Decay</div>
                                </div>
                            </div>

                            <div class="bg-slate-50/50 rounded-[2rem] p-10 border border-slate-100 shadow-inner relative overflow-hidden">
                                <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-slate-200/50"></div>
                                
                                <!-- Upper Arch -->
                                <div class="flex justify-center gap-2 mb-12 relative z-10">
                                    @for (int i = 1; i <= 16; i++) {
                                        var status = Model.ToothStatusMap.ContainsKey(i) ? Model.ToothStatusMap[i].ToLower() : "healthy";
                                        var colorClass = status switch {
                                            "healthy" => "bg-white text-emerald-500 border-emerald-100",
                                            "filled" => "bg-blue-500 text-white border-blue-600",
                                            "crown" => "bg-purple-500 text-white border-purple-600",
                                            "rct" => "bg-emerald-600 text-white border-emerald-700",
                                            "extracted" => "bg-slate-400 text-white border-slate-500 line-through",
                                            "decay" => "bg-rose-500 text-white border-rose-600",
                                            "missing" => "bg-slate-200 text-slate-400 border-slate-300 opacity-50",
                                            _ => "bg-amber-500 text-white border-amber-600"
                                        };
                                        <div class="flex flex-col items-center gap-1.5">
                                            <span class="text-[8px] font-bold text-slate-300">#@i</span>
                                            <div class="w-9 h-12 rounded-lg border flex items-center justify-center font-bold text-[11px] shadow-sm transition-all hover:scale-110 cursor-help @colorClass" title="Tooth #@i: @status">@i</div>
                                        </div>
                                    }
                                </div>

                                <!-- Lower Arch -->
                                <div class="flex justify-center gap-2 relative z-10">
                                    @for (int i = 32; i >= 17; i--) {
                                        var status = Model.ToothStatusMap.ContainsKey(i) ? Model.ToothStatusMap[i].ToLower() : "healthy";
                                        var colorClass = status switch {
                                            "healthy" => "bg-white text-emerald-500 border-emerald-100",
                                            "filled" => "bg-blue-500 text-white border-blue-600",
                                            "crown" => "bg-purple-500 text-white border-purple-600",
                                            "rct" => "bg-emerald-600 text-white border-emerald-700",
                                            "extracted" => "bg-slate-400 text-white border-slate-500 line-through",
                                            "decay" => "bg-rose-500 text-white border-rose-600",
                                            "missing" => "bg-slate-200 text-slate-400 border-slate-300 opacity-50",
                                            _ => "bg-amber-500 text-white border-amber-600"
                                        };
                                        <div class="flex flex-col items-center gap-1.5">
                                            <div class="w-9 h-12 rounded-lg border flex items-center justify-center font-bold text-[11px] shadow-sm transition-all hover:scale-110 cursor-help @colorClass" title="Tooth #@i: @status">@i</div>
                                            <span class="text-[8px] font-bold text-slate-300">#@i</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Medical -->
                <div id="content-medical" class="tab-content hidden">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Core Medical Data -->
                        <div class="bg-white rounded-3xl p-6 border border-slate-200/60 shadow-sm space-y-6">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-brand-900 text-white flex items-center justify-center shadow-md">
                                        <i class="fa-solid fa-file-medical text-base"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-md font-bold text-brand-900 font-display">Medical Profile</h3>
                                        <p class="text-[9px] font-bold uppercase tracking-widest text-brand-400">Vital signs & data</p>
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-[9px] font-bold text-brand-400 uppercase tracking-widest mb-1">Blood Type</div>
                                    <div class="text-lg font-bold text-brand-900">@(Model.MedicalInfo?.BloodType ?? "Unknown")</div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-[9px] font-bold text-brand-400 uppercase tracking-widest mb-1">Smoker</div>
                                    <div class="text-lg font-bold @(Model.MedicalInfo?.IsSmoker == true ? "text-rose-600" : "text-emerald-600")">@(Model.MedicalInfo?.IsSmoker == true ? "Yes" : "No")</div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-[9px] font-bold text-brand-400 uppercase tracking-widest mb-1">Weight</div>
                                    <div class="text-lg font-bold text-brand-900">@(Model.MedicalInfo?.Weight?.ToString("0.0") ?? "---") <span class="text-[10px] font-bold text-brand-400 uppercase">kg</span></div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-[9px] font-bold text-brand-400 uppercase tracking-widest mb-1">Height</div>
                                    <div class="text-lg font-bold text-brand-900">@(Model.MedicalInfo?.Height?.ToString("0.0") ?? "---") <span class="text-[10px] font-bold text-brand-400 uppercase">cm</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Allergies & Risks -->
                        <div class="bg-white rounded-3xl p-6 border border-slate-200/60 shadow-sm space-y-6">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-rose-500 text-white flex items-center justify-center shadow-md">
                                        <i class="fa-solid fa-shield-virus text-base"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-md font-bold text-brand-900 font-display">Allergies & Risks</h3>
                                        <p class="text-[9px] font-bold uppercase tracking-widest text-brand-400">Critical safety info</p>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-3">
                                @if (Model.MedicalInfo != null && !string.IsNullOrEmpty(Model.MedicalInfo.AllergiesJson)) {
                                    var allergies = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.MedicalInfo.AllergiesJson);
                                    if (allergies?.Any() == true) {
                                        @foreach (var allergy in allergies) {
                                            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-rose-50 border border-rose-100 text-rose-700">
                                                <i class="fa-solid fa-circle-exclamation text-rose-400 text-[11px]"></i>
                                                <span class="text-[12px] font-bold uppercase tracking-wider">@allergy</span>
                                            </div>
                                        }
                                    } else {
                                        <div class="flex flex-col items-center justify-center py-8 text-center opacity-40">
                                            <i class="fa-solid fa-check-circle text-3xl mb-2"></i>
                                            <p class="text-[12px] font-bold">No Known Allergies</p>
                                        </div>
                                    }
                                } else {
                                    <div class="flex flex-col items-center justify-center py-8 text-center opacity-40">
                                        <i class="fa-solid fa-check-circle text-3xl mb-2"></i>
                                        <p class="text-[12px] font-bold">No Known Allergies</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Appointments -->
                <div id="content-appointments" class="tab-content hidden bg-white rounded-3xl border border-slate-200/60 shadow-sm overflow-hidden">
                    @if (Model.Appointments.Any()) {
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 border-b border-slate-100">
                                <tr>
                                    <th class="px-6 py-4 text-[10.5px] font-bold text-brand-400 uppercase tracking-wider font-display">Date & Time</th>
                                    <th class="px-6 py-4 text-[10.5px] font-bold text-brand-400 uppercase tracking-wider font-display">Service</th>
                                    <th class="px-6 py-4 text-[10.5px] font-bold text-brand-400 uppercase tracking-wider font-display">Doctor</th>
                                    <th class="px-6 py-4 text-[10.5px] font-bold text-brand-400 uppercase tracking-wider font-display">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                @foreach (var a in Model.Appointments) {
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="text-[13px] font-bold text-brand-900">@a.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                            <div class="text-[11px] text-brand-400">@a.AppointmentTime</div>
                                        </td>
                                        <td class="px-6 py-4 text-[13px] text-brand-600 font-medium">@a.ServiceName</td>
                                        <td class="px-6 py-4 text-[13px] text-brand-600 font-medium">Dr. @(a.Doctor?.Profile?.LastName ?? "TBD")</td>
                                        <td class="px-6 py-4">
                                            @{
                                                var color = a.Status.ToLower() switch {
                                                    "confirmed" => "bg-emerald-50 text-emerald-600 border-emerald-100",
                                                    "arrived" => "bg-blue-50 text-blue-600 border-blue-100",
                                                    "completed" => "bg-slate-100 text-slate-600 border-slate-200",
                                                    "cancelled" => "bg-rose-50 text-rose-600 border-rose-100",
                                                    "no_show" => "bg-slate-100 text-slate-600 border-slate-200",
                                                    _ => "bg-amber-50 text-amber-600 border-amber-100"
                                                };
                                            }
                                            <span class="px-3 py-1 @color text-[10px] font-bold rounded-full border uppercase tracking-wider">@a.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    } else {
                        <div class="p-20 text-center text-brand-400 text-[13px]">No appointments found.</div>
                    }
                </div>

                <!-- Tab Content: Notes -->
                <div id="content-notes" class="tab-content hidden bg-white rounded-3xl p-6 border border-slate-200/60 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-md font-bold text-brand-900 font-display">Clinical Notes</h4>
                        <button onclick="saveNotes()" class="px-4 py-1.5 bg-primary/10 text-primary text-[12px] font-bold rounded-lg hover:bg-primary hover:text-white transition-all">Save Changes</button>
                    </div>
                    <textarea 
                        class="w-full p-5 rounded-2xl bg-slate-50 border border-slate-200 outline-none focus:border-primary/40 text-[13.5px] leading-relaxed text-brand-700 resize-none shadow-inner"
                        placeholder="Enter internal clinical notes, medical history, or allergies here...">Patient is undergoing routine orthodontic treatment. Gum health is stable. No known allergies to local anesthesia.</textarea>
                    <div class="flex items-center justify-between mt-3">
                        <p class="text-[11px] text-brand-400 italic">Clinical data managed by Samson Dental</p>
                        <span class="text-[10px] text-slate-300 font-mono">ID: @p?.Id</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function saveNotes() {
        const notes = document.querySelector('textarea').value;
        const patientId = "@p?.Id";
        
        console.log("Saving notes for", patientId, ":", notes);
        
        const btn = event.target;
        const originalText = btn.innerText;
        btn.innerText = "Saving...";
        btn.disabled = true;
        
        setTimeout(() => {
            btn.innerText = "Saved!";
            btn.classList.replace('bg-primary/10', 'bg-emerald-500');
            btn.classList.replace('text-primary', 'text-white');
            
            setTimeout(() => {
                btn.innerText = originalText;
                btn.classList.replace('bg-emerald-500', 'bg-primary/10');
                btn.classList.replace('text-white', 'text-primary');
                btn.disabled = false;
            }, 2000);
        }, 1000);
    }

    function openNewAppointment() {
        const patientId = "@p?.Id";
        window.location.href = `/Doctor/Appointments?patientId=${patientId}&openModal=true`;
    }
    async function saveEvaluation() {
        const btn = event.target;
        const originalText = btn.innerText;
        
        const payload = {
            patientId: "@p?.Id",
            score: parseInt(document.getElementById('health-score-input').value),
            gumHealth: document.getElementById('eval-gum').value,
            cavityRisk: document.getElementById('eval-cavity').value,
            enamelStatus: document.getElementById('eval-enamel').value,
            plaqueLevel: document.getElementById('eval-plaque').value,
            notes: document.getElementById('eval-notes').value
        };

        btn.innerText = "Saving...";
        btn.disabled = true;

        try {
            const res = await fetch('/api/doctor/evaluate-oral-health', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.ok) {
                btn.innerText = "Saved!";
                btn.classList.replace('bg-primary/10', 'bg-emerald-500');
                btn.classList.replace('text-primary', 'text-white');
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.classList.replace('bg-emerald-500', 'bg-primary/10');
                    btn.classList.replace('text-white', 'text-primary');
                    btn.disabled = false;
                }, 2000);
            } else {
                alert("Failed to save: " + result.error);
                btn.innerText = originalText;
                btn.disabled = false;
            }
        } catch (err) {
            alert("Network error.");
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    // Pre-fill evaluation if exists
    
    function switchTab(tabId) {
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        const target = document.getElementById('content-' + tabId);
        if (target) target.classList.remove('hidden');
        
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        const activeBtn = document.querySelector(`[data-tab="${tabId}"]`);
        if (activeBtn) activeBtn.classList.add('active');
    }

    document.addEventListener('DOMContentLoaded', () => {
        switchTab('@(Model.ClinicalTimeline.Any() ? "timeline" : "appointments")');
    });

</script>

<style>
    [x-cloak] { display: none !important; }
    .font-display { font-family: 'Syne', sans-serif; }
    
    .tab-btn {
        color: #64748b; /* slate-500 */
        transition: all 0.2s ease;
    }
    .tab-btn:hover:not(.active) {
        background-color: #f8fafc; /* slate-50 */
        color: #0f172a; /* brand-900 */
    }
    .tab-btn.active {
        background-color: #0f172a; /* brand-900 */
        color: white !important;
        box-shadow: 0 4px 12px -2px rgb(15 23 42 / 0.15);
    }
</style>
