@page "/Doctor/ActivityLogs"
@model SamsonDentalCenterManagementSystem.Pages.DoctorSide.ActivityLogs.ActivityLogsModel
@{
Layout = "AdminSide/_StaffLayout";
}

<div id="page-activitylogs" class="page p-4 md:p-6 ">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
        <div>
            <h2 class="font-display text-xl font-bold text-brand">Activity Logs</h2>
            <p class="text-[12px] text-brand-500 mt-0.5">System and user activity audit trail</p>
        </div>
        
        <div class="flex items-center gap-2">
            <div class="relative group">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 translate-half text-slate-300 text-[11px] group-focus-within:text-primary transition-colors"></i>
                <input type="text" id="log-search" placeholder="Search logs..." 
                       class="pl-8 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-[12px] outline-none focus:border-primary transition-all w-[200px]" />
            </div>
            <select id="log-filter-category" class="px-4 pr-8 py-2 bg-white border border-slate-200 rounded-xl text-[12px]  outline-none focus:border-primary transition-all">
                <option value="">All Categories</option>
                <option value="appointment">Appointment</option>
                <option value="invoice">Invoice</option>
                <option value="inquiry">Inquiry</option>
                <option value="system">System</option>
                <option value="auth">Auth</option>
            </select>
        </div>
    </div>
  <div class="bg-white rounded-2xl p-5 border border-slate-200">
    <div id="logs-container" class="space-y-0 divide-y divide-dashed divide-slate-100">
      <!-- Activity logs will be hydrated here -->
      <div class="py-8 text-center text-brand-500 text-[12px]">
        Loading logs...
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script src="~/js/AdminSide/adminActivityLogs.js"></script>
}
