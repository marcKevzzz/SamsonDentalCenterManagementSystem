@page "/forgot-password"
@model ForgotPasswordModel
@{
    Layout = "_AuthLayout";
}

<div class="hidden lg:flex lg:w-[44%] bg-brand flex-col justify-between p-12 relative overflow-hidden shrink-0">
  <div class="absolute inset-0 bg-grid"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 my-auto">
    <div class="flex items-center gap-2 font-body text-[0.65rem] font-medium tracking-[0.15em] uppercase text-white/35 mb-5">
      <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>Security
    </div>
    <h2 class="brand-font font-bold text-white leading-[1.08] mb-5" style="font-size: clamp(2rem, 3.2vw, 2.8rem)">
      Recover your<br />account.
    </h2>
    <p class="font-body text-[0.9rem] text-white/50 leading-relaxed max-w-xs mb-10">
      Enter your email address and we'll send you a link to reset your password.
    </p>
  </div>
</div>

<div class="flex-1 flex items-center justify-center px-6 py-12 lg:py-0 overflow-y-auto">
  <div class="w-full max-w-[420px] fade-up animate">
    <div class="mb-8">
      <h2 class="brand-font font-bold text-brand text-[1.9rem] leading-tight mb-1.5">
        Forgot password?
      </h2>
      <p class="font-body text-[0.9rem] text-muted">
        No worries, it happens. Please enter your email.
      </p>
    </div>

    <form id="forgotForm" method="post" class="space-y-4">
      @Html.AntiForgeryToken()
      <div>
        <label class="block font-body text-[0.71rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">Email Address</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted pointer-events-none">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </span>
          <input asp-for="Email" type="email" class="auth-input" placeholder="juan@email.com" required />
        </div>
      </div>

      <button type="submit" class="brand-font font-bold text-[0.85rem] tracking-wider uppercase w-full bg-brand text-white py-3.5 rounded-xl hover:bg-primary transition-colors duration-200 cursor-pointer">
        Send Reset Link →
      </button>

      <div class="text-center mt-6">
        <a href="/sign-in" class="text-primary font-medium hover:underline text-sm">← Back to Sign In</a>
      </div>
    </form>

@if (TempData["Success"] != null || TempData["Error"] != null)
{
    <script type="module">
        import { Toast } from '/js/ui.js';
        document.addEventListener("DOMContentLoaded", () => {
            @if (TempData["Success"] != null)
            {
                <text>Toast.show("@TempData["Success"]", "success");</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>Toast.show("@TempData["Error"]", "danger");</text>
            }
        });
    </script>
}
  </div>
</div>
