@page "/signout"
@model SignoutModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head><title>Signing out…</title></head>
<body>
<script>
    // Completely clear local storage to ensure no Supabase session tokens or stale cache remain
    localStorage.clear();
    sessionStorage.clear();

    // Redirect to sign-in
    window.location.replace("/sign-in");
</script>
</body>
</html>