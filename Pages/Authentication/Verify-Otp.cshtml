@page "/Verify-Otp"
@model SamsonDentalCenterManagementSystem.Pages.Authentication.VerifyOtpModel
@{
    ViewData["Title"] = "Verify Code";
    Layout = "_AuthLayout";
}

<div class="min-h-screen bg-white lg:bg-[#FAFAFA] flex items-center justify-center p-4 mx-auto">
    <div class="max-w-[440px] w-full bg-white lg:rounded-[2rem] lg:shadow-[0_24px_80px_rgba(0,0,0,0.06)] p-8 lg:p-12 border-0 lg:border border-slate-200/60">
        <div class="text-center mb-10">
            <div class="w-16 h-16 bg-primary/5 rounded-2xl flex items-center justify-center mx-auto mb-6">
                <i class="fa-solid fa-shield-check text-primary text-2xl"></i>
            </div>
            <h1 class="brand-font text-3xl font-bold text-slate-900 tracking-tight">Verify Email</h1>
            <p class="text-slate-500 text-[15px] mt-3 leading-relaxed">
                Enter the 6-digit code we sent to <br>
                <span class="font-medium text-slate-900">@Model.Email</span>
            </p>
        </div>

        <form method="post" class="space-y-6">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Type" />

            <div class="space-y-4">
                <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-[0.2em] text-center">Security Code</label>
                <div class="flex justify-between gap-2" id="otp-inputs">
                    @for (int i = 0; i < 6; i++)
                    {
                        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*"
                               class="w-full h-14 sm:h-16 text-center text-2xl font-bold border-2 border-slate-100 bg-slate-50/50 rounded-xl focus:border-primary focus:bg-white focus:ring-4 focus:ring-primary/5 transition-all duration-200 outline-none"
                               oninput="moveNext(this, @i)" onkeydown="moveBack(event, this, @i)" />
                    }
                </div>
                <input type="hidden" asp-for="Code" id="full-code" />
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="bg-red-50 text-red-600 text-sm p-4 rounded-xl flex items-center gap-3 border border-red-100 animate-shake">
                    <i class="fa-solid fa-circle-exclamation shrink-0"></i>
                    <p>@TempData["Error"]</p>
                </div>
            }

            <div class="space-y-4 pt-4">
                <button type="submit" class="w-full bg-primary text-white font-bold py-4 rounded-xl hover:bg-brand transition-all duration-300 shadow-lg shadow-primary/20 active:scale-[0.98]">
                    Verify & Continue
                </button>

                <div class="text-center">
                    <p class="text-[14px] text-slate-400">
                        Didn't receive the code? 
                        <button type="button" onclick="resendCode()" class="text-primary font-bold hover:text-brand transition-colors">Resend</button>
                    </p>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const inputs = document.querySelectorAll('#otp-inputs input');
        
        // Handle Paste
        inputs.forEach((input, index) => {
            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = e.clipboardData.getData('text').trim();
                if (!/^\d+$/.test(pasteData)) return; // Only numbers
                
                const digits = pasteData.split('').slice(0, 6);
                digits.forEach((digit, i) => {
                    if (inputs[i]) {
                        inputs[i].value = digit;
                    }
                });
                
                // Focus the last input or the one after the pasted digits
                const nextFocus = Math.min(digits.length, 5);
                inputs[nextFocus].focus();
                updateFullCode();
            });

            // Handle multi-character input (for mobile browsers that don't trigger 'paste' correctly)
            input.addEventListener('input', (e) => {
                const value = e.target.value;
                if (value.length > 1) {
                    const digits = value.replace(/\D/g, '').split('').slice(0, 6);
                    digits.forEach((digit, i) => {
                        const idx = index + i;
                        if (inputs[idx]) {
                            inputs[idx].value = digit;
                        }
                    });
                    const nextFocus = Math.min(index + digits.length, 5);
                    inputs[nextFocus].focus();
                }
                updateFullCode();
            });
        });
    });

    function moveNext(el, index) {
        // Ensure only numbers
        el.value = el.value.replace(/[^0-9]/g, '');
        
        if (el.value.length === 1 && index < 5) {
            el.parentElement.children[index + 1].focus();
        }
        updateFullCode();
    }

    function moveBack(e, el, index) {
        if (e.key === "Backspace" && el.value.length === 0 && index > 0) {
            el.parentElement.children[index - 1].focus();
        }
    }

    function updateFullCode() {
        const inputs = document.querySelectorAll('#otp-inputs input');
        let code = "";
        inputs.forEach(input => code += input.value);
        document.getElementById('full-code').value = code;
    }

    async function resendCode() {
        // Logic to trigger resend
        alert("Resend functionality coming soon.");
    }
</script>
