@page "/reset-password"
@model ResetPasswordModel
@{
    Layout = "_AuthLayout";
}

<div class="hidden lg:flex lg:w-[44%] bg-brand flex-col justify-between p-12 relative overflow-hidden shrink-0">
  <div class="absolute inset-0 bg-grid"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 my-auto">
    <div class="flex items-center gap-2 font-body text-[0.65rem] font-medium tracking-[0.15em] uppercase text-white/35 mb-5">
      <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>Security
    </div>
    <h2 class="brand-font font-bold text-white leading-[1.08] mb-5" style="font-size: clamp(2rem, 3.2vw, 2.8rem)">
      Set a new<br />password.
    </h2>
    <p class="font-body text-[0.9rem] text-white/50 leading-relaxed max-w-xs mb-10">
      Almost there. Choose a strong password to secure your account.
    </p>
  </div>
</div>

<div class="flex-1 flex items-center justify-center px-6 py-12 lg:py-0 overflow-y-auto">
  <div class="w-full max-w-[420px] fade-up animate">
    <div class="mb-8">
      <h2 class="brand-font font-bold text-brand text-[1.9rem] leading-tight mb-1.5">
        Reset Password
      </h2>
      <p class="font-body text-[0.9rem] text-muted">
        Enter your new password below.
      </p>
    </div>

    <form id="resetForm" method="post" class="space-y-4">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="Email" />
      <input type="hidden" asp-for="Otp" />
      <input type="hidden" asp-for="Verified" />

      <div>
        <label class="block font-body text-[0.71rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">New Password</label>
        <input asp-for="NewPassword" type="password" class="auth-input" placeholder="Min. 8 characters" required minlength="8" />
      </div>

      <div>
        <label class="block font-body text-[0.71rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">Confirm New Password</label>
        <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="Repeat new password" required minlength="8" />
      </div>

      <button type="submit" class="brand-font font-bold text-[0.85rem] tracking-wider uppercase w-full bg-brand text-white py-3.5 rounded-xl hover:bg-primary transition-colors duration-200 cursor-pointer">
        Update Password →
      </button>

      <a href="/Authentication/Signin" class="flex items-center justify-center gap-2 text-[0.8rem] text-muted hover:text-brand transition-colors mt-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Sign In
      </a>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="mt-4 p-4 bg-green-50 text-green-700 rounded-xl text-sm font-medium border border-green-100">
            @TempData["Success"]
            <div class="mt-2">
                <a href="/Authentication/Signin" class="text-green-800 underline font-bold">Sign In Now →</a>
            </div>
        </div>
        <script type="module">
            import { Toast } from '/js/ui.js';
            document.addEventListener("DOMContentLoaded", () => {
                Toast.show("@TempData["Success"]", "success");
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script type="module">
            import { Toast } from '/js/ui.js';
            document.addEventListener("DOMContentLoaded", () => {
                Toast.show("@TempData["Error"]", "danger");
            });
        </script>
    }
  </div>
</div>

<script type="module">
  import {Toast, Modal} from '/js/ui.js'
    document.addEventListener("DOMContentLoaded", () => {
        // No longer using hash tokens
    });
</script>
