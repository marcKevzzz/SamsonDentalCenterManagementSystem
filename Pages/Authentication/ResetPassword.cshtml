@page "/reset-password"
@model ResetPasswordModel
@{
    Layout = "_AuthLayout";
}

<div class="hidden lg:flex lg:w-[44%] bg-brand flex-col justify-between p-12 relative overflow-hidden shrink-0">
  <div class="absolute inset-0 bg-grid"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 my-auto">
    <div class="flex items-center gap-2 font-body text-[0.65rem] font-semibold tracking-[0.15em] uppercase text-white/35 mb-5">
      <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>Security
    </div>
    <h2 class="brand-font font-extrabold text-white leading-[1.08] mb-5" style="font-size: clamp(2rem, 3.2vw, 2.8rem)">
      Set a new<br />password.
    </h2>
    <p class="font-body text-[0.9rem] text-white/50 leading-relaxed max-w-xs mb-10">
      Almost there. Choose a strong password to secure your account.
    </p>
  </div>
</div>

<div class="flex-1 flex items-center justify-center px-6 py-12 lg:py-0 overflow-y-auto">
  <div class="w-full max-w-[420px] fade-up animate">
    <div class="mb-8">
      <h2 class="brand-font font-extrabold text-brand text-[1.9rem] leading-tight mb-1.5">
        Reset Password
      </h2>
      <p class="font-body text-[0.9rem] text-muted">
        Enter your new password below.
      </p>
    </div>

    <form id="resetForm" method="post" class="space-y-4">
      @Html.AntiForgeryToken()
      <input type="hidden" id="accessToken" name="AccessToken" />

      <div>
        <label class="block font-body text-[0.71rem] font-semibold tracking-[0.08em] uppercase text-muted mb-2">New Password</label>
        <input asp-for="NewPassword" type="password" class="auth-input" placeholder="Min. 8 characters" required minlength="8" />
      </div>

      <div>
        <label class="block font-body text-[0.71rem] font-semibold tracking-[0.08em] uppercase text-muted mb-2">Confirm New Password</label>
        <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="Repeat new password" required minlength="8" />
      </div>

      <button type="submit" class="brand-font font-bold text-[0.85rem] tracking-wider uppercase w-full bg-brand text-white py-3.5 rounded-xl hover:bg-primary transition-colors duration-200 cursor-pointer">
        Update Password →
      </button>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="mt-4 p-4 bg-green-50 text-green-700 rounded-xl text-sm font-medium border border-green-100">
            @TempData["Success"]
            <div class="mt-2">
                <a href="/sign-in" class="text-green-800 underline font-bold">Sign In Now →</a>
            </div>
        </div>
        <script type="module">
            import { Toast } from '/js/ui.js';
            document.addEventListener("DOMContentLoaded", () => {
                Toast.show("@TempData["Success"]", "success");
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script type="module">
            import { Toast } from '/js/ui.js';
            document.addEventListener("DOMContentLoaded", () => {
                Toast.show("@TempData["Error"]", "danger");
            });
        </script>
    }
  </div>
</div>

<script type="module">
  import {Toast, Modal} from '/js/ui.js'
    // Grab token from hash or query and put in hidden input
    document.addEventListener("DOMContentLoaded", () => {
        const hash = window.location.hash.substring(1);
        const urlParams = new URLSearchParams(window.location.search);
        const hashParams = new URLSearchParams(hash);
        
        // Supabase often puts token in hash, but user might have query param if link mangled
        const token = hashParams.get("access_token") || urlParams.get("token") || urlParams.get("access_token");
        
        if (token) {
            document.getElementById("accessToken").value = token;
        } else {
            // If no token, and not just submitted, show error
            @if (TempData["Error"] == null && TempData["Success"] == null)
            {
                <text>
                if (window.Toast) {
                    Toast.show("No reset token found. Please check your link or request a new one.", "danger");
                } else {
                    alert("No reset token found. Please check your link or request a new one.");
                }
                setTimeout(() => {
                    window.location.href = "/forgot-password";
                }, 3000);
                </text>
            }
        }
    });
</script>
