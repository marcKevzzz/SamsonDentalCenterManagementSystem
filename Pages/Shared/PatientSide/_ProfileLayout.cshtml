@{
  Layout = "_Layout";
}

<div class="pt-[90px] max-w mx-auto px-4 sm:px-8 lg:px-12 py-10 flex gap-8 items-start ">
   
  <!-- ── Sidebar ── -->
  <aside class="hidden lg:block w-56 shrink-0 sticky top-[90px]">


    <!-- Nav -->
    <div class="bg-white rounded-[2rem] p-3 border border-slate-100 shadow-sm space-y-1">
      <a href="/Profile/Dashboard" class="side-link group" id="side-dashboard">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-slate-50 flex items-center justify-center group-[.active]:bg-white group-[.active]:text-primary transition-all">
                <i class="fa-solid fa-house-user text-[14px]"></i>
            </div>
            <span>Dashboard</span>
        </div>
      </a>

      <a href="/Profile/MyAppointments" class="side-link group" id="side-myappointments">
        <div class="flex items-center justify-between w-full">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-slate-50 flex items-center justify-center group-[.active]:bg-white group-[.active]:text-primary transition-all">
                    <i class="fa-solid fa-calendar-check text-[14px]"></i>
                </div>
                <span>Appointments</span>
            </div>
        </div>
      </a>

      <a href="/Profile/Records" class="side-link group" id="side-records">
        <div class="flex items-center justify-between w-full">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-slate-50 flex items-center justify-center group-[.active]:bg-white group-[.active]:text-primary transition-all">
                    <i class="fa-solid fa-folder-open text-[14px]"></i>
                </div>
                <span>Dental Records</span>
            </div>
            <span id="notif-patient-records-count" class="hidden w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
        </div>
      </a>

      <a href="/Profile/Notifications" class="side-link group" id="side-notifications">
        <div class="flex items-center justify-between w-full">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-slate-50 flex items-center justify-center group-[.active]:bg-white group-[.active]:text-primary transition-all">
                    <i class="fa-solid fa-bell text-[14px]"></i>
                </div>
                <span>Notifications</span>
            </div>
            <span id="notif-patient-general-count" class="hidden w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white unread-dot"></span>
        </div>
      </a>

          <a href="/Profile/Settings" class="side-link group" id="side-settings">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-slate-50 flex items-center justify-center group-[.active]:bg-white group-[.active]:text-primary transition-all">
                    <i class="fa-solid fa-gear text-[14px]"></i>
                </div>
                <span>Settings</span>
            </div>
          </a>
    </div>
  </aside>


  @RenderBody()
</div>