<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Samson Dental Center Staff Portal</title>
  <script type="importmap"></script>

  <script>
    if (localStorage.getItem("sidebarCollapsed") === "true") {
      document.documentElement.classList.add("sb-collapsed");
    }
  </script>

  <link rel="stylesheet" href="~/css/admin.css" />
  <link rel="stylesheet" href="~/css/tailwind.css" />
  <link rel="stylesheet" href="~/SamsonDentalCenterManagementSystem.styles.css" asp-append-version="true" />
  <script src="https://cdn.tailwindcss.com"></script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <link href="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css" rel="stylesheet" />

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap"
    rel="stylesheet" />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="~/js/config.js" asp-append-version="true"></script>
  <!-- Auth guard: intercepts 401 expired responses across all fetch() calls -->
  <script src="~/js/auth-guard.js" asp-append-version="true"></script>
  <script type="module" src="~/js/AdminSide/AdminStore.js" asp-append-version="true"></script>
  <script type="module" src="~/js/AdminSide/site.js" asp-append-version="true" defer></script>
  <script src="~/js/AdminSide/adminNotifications.js" asp-append-version="true" defer></script>
</head>

<body data-role="@(ViewData["UserRole"]?.ToString()?.ToLower() ?? "admin")">
  <!-- Overlay for mobile sidebar -->
  <div id="overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[49] hidden lg:!hidden"></div>

  <div class="flex min-h-screen">
    <!-- ══════════════════════════════════════ -->
    <!-- SIDEBAR                                -->
    <!-- ══════════════════════════════════════ -->
    <aside id="sidebar"
      class="w-[256px] bg-brand fixed left-0 top-0 h-dvh z-[300] transition-all duration-300 -translate-x-full lg:translate-x-0">
      <div class="flex flex-col relative h-full w-full">
        <div class="flex items-center gap-3 px-4 py-5 border-b border-white/[0.07] flex-shrink-0 overflow-hidden">
          <div class="brand-logo flex items-center -ml-2">
           <img src="~/images/logo.svg" alt="logo" class="w-12 h-12 object-cover mt-1 brightness-150" />
            <span id="logo" class="logo-font sidebar-text text-white font-bold text-[1.25rem] tracking-[0.035em] uppercase flex flex-col leading-[0.85] transition-colors gap-0.5 -ml-2 md:hidden lg:flex">
                Samson  <span id="logo-last" class="text-gray-400 brightness-125 tracking-[0.20em] text-[0.5rem] p-0.5 bg-gray-400/10 rounded-full">Dental  Center</span>
            </span>
        </div>
         

          <button id="toggle-btn"
            class="absolute -right-3 top-5 p-1 rounded-full bg-[#1f2c4b] text-white transition-colors hidden lg:flex items-center justify-center flex-shrink-0">
            <svg id="toggle-icon" class="transition-transform duration-300" width="18" height="18" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <!-- Chevron Left -->
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        </div>

        <nav id="sidebar-nav" class="flex-1 overflow-y-auto py-2 overflow-x-hidden">
          @{
            var r = (ViewData["UserRole"]?.ToString() ?? "").ToLower();
            var basePath = r == "admin" ? "/Admin" : (r == "doctor" ? "/Doctor" : "/Receptionist");
          }
          <div class="nav-label px-7 py-2.5">
            <span
              class="sidebar-text text-[9.5px] font-bold uppercase tracking-[0.12em] text-white font-display">Main</span>
          </div>

          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[15px] transition-all"
            href="@basePath/Dashboard" id="admin-dashboard">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" />
              <rect x="14" y="3" width="7" height="7" />
              <rect x="3" y="14" width="7" height="7" />
              <rect x="14" y="14" width="7" height="7" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Dashboard</span>
          </a>

          @if(r == "admin" || r == "receptionist" || r == "doctor") {
          <div class="nav-label px-7 py-2.5 mt-1">
            <span
              class="sidebar-text text-[9.5px] font-bold uppercase tracking-[0.12em] text-white font-display">People</span>
          </div>
          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/Patients" id="admin-patients">
            <svg class="pl-0.5 flex" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Patients</span>
            <span id="notif-patients-count" class="sidebar-text ml-auto px-2 py-0.5 bg-brand-400/20 text-white text-[11px] font-bold rounded-full hidden"></span>
          </a>
          }

          @if(r == "admin") {
          <!-- Staff Dropdown -->
          <div class="relative px-2">
            <button class="nav-item group w-full flex items-center gap-4 px-4 py-2.5 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all hover:bg-white/[0.05]"
              id="staff-dropdown-btn">
              <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M19 11l2 2 4-4" />
              </svg>
              <span class="sidebar-text nav-links transition-opacity duration-300">Staff</span>
              <svg class="sidebar-text ml-auto transition-transform duration-200" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" id="staff-arrow">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <!-- Dropdown content (Expanded Sidebar) -->
            <div id="staff-dropdown" class="hidden pl-10 pr-2 py-1 space-y-1 overflow-hidden transition-all duration-300">
              <a href="/Admin/Staff/Doctors" class="flex items-center justify-between px-4 py-2 rounded-lg text-[11.5px] text-white/60 hover:text-white hover:bg-white/[0.05] transition-colors">
                <span>Doctors</span>
                <span id="notif-doctor-count" class=" text-white text-[11px] font-bold hidden"></span>
              </a>
              <a href="/Admin/Staff/Receptionists" class="flex items-center justify-between px-4 py-2 rounded-lg text-[11.5px] text-white/60 hover:text-white hover:bg-white/[0.05] transition-colors">
                <span>Receptionists</span>
                <span id="notif-receptionist-count" class=" text-white text-[11px] font-bold hidden"></span>
              </a>
            </div>

            <!-- Popup Menu (Collapsed Sidebar) -->
            <div id="staff-popup" class="hidden fixed left-[72px] mt-[-40px] w-44 bg-[#1f2c4b] border border-white/10 rounded-xl shadow-2xl overflow-hidden z-[500] animate-in fade-in slide-in-from-left-2 duration-200">
              <div class="px-4 py-2 border-b border-white/5 bg-white/5">
                <span class="text-[10px] font-bold uppercase tracking-widest text-white/40">Staff Directory</span>
              </div>
              <a href="/Admin/Staff/Doctors" class="flex items-center justify-between px-4 py-2.5 text-[12px] text-white hover:bg-white/10 transition-colors">
                <span>Doctors</span>
                <span id="popup-notif-doctor-count" class="w-1.5 h-1.5 bg-red-500 rounded-full hidden unread-dot"></span>
              </a>
              <a href="/Admin/Staff/Receptionists" class="flex items-center justify-between px-4 py-2.5 text-[12px] text-white hover:bg-white/10 transition-colors">
                <span>Receptionists</span>
                <span id="popup-notif-receptionist-count" class="w-1.5 h-1.5 bg-red-500 rounded-full hidden unread-dot"></span>
              </a>
            </div>
          </div>
          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="/Admin/Users" id="admin-users">
          <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
  <circle cx="9" cy="7" r="4" />
  <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
</svg>

            <span class="sidebar-text nav-links transition-opacity duration-300">Users</span>
            <span id="notif-users-count" class="sidebar-text ml-auto px-2 py-0.5 bg-brand-400/20 text-white text-[11px] font-bold rounded-full hidden"></span>
          </a>
          }

          <div class="px-7 py-2.5 mt-1">
            <span
              class="sidebar-text text-[9.5px] font-bold uppercase tracking-[0.12em] text-white font-display">Operations</span>
          </div>

          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/Appointments" id="admin-appointments">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Appointments</span>
            <span id="notif-appointments-count" class="sidebar-text ml-auto px-2 py-0.5 bg-brand-400/20 text-white text-[10px] font-bold rounded-full hidden"></span>
          </a>

          @if(r == "admin") {
          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="/Admin/BlockedDates" id="admin-blocked-dates">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
              <line x1="9" y1="15" x2="15" y2="15" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Blocked Dates</span>
          </a>
          }

          @if(r == "admin" || r == "doctor") {
          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/Treatments" id="admin-invoices">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <polyline points="10 9 9 9 8 9" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Treatments</span>
          </a>
          }

          @if(r == "admin") {
          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="/Admin/Services" id="admin-services-link">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a5 5 0 0 1 5 5v3H7V7a5 5 0 0 1 5-5z" />
              <rect x="2" y="10" width="20" height="12" rx="2" />
              <path d="M12 14v4" />
              <path d="M10 16h4" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Services</span>
            <span id="notif-services-count" class="sidebar-text ml-auto text-[11px] hidden unread-dot"></span>
          </a>
          }

          @if(r == "admin" || r == "receptionist") {
          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/Billing" id="admin-transactions">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z" />
              <path d="M16 8h-6" />
              <path d="M16 12H8" />
              <path d="M13 16H8" />
            </svg>

            <span class="sidebar-text nav-links transition-opacity duration-300">Billing</span>
          </a>
          }

          @if(r == "admin" || r == "receptionist" || r == "doctor") {
          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/Availability" id="staff-availability">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
              <line x1="8" y1="14" x2="16" y2="14" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">@(r == "admin" ? "Leaves" : "My Schedule")</span>
            <span id="notif-leaves-count" class="sidebar-text ml-auto px-2 py-0.5 bg-brand-400/20 text-white text-[10px] font-bold rounded-full hidden"></span>
          </a>
          }

          <div class="px-7 py-2.5 mt-1">
            <span
              class="sidebar-text text-[9.5px] font-bold uppercase tracking-[0.12em] text-white font-display">Analytics</span>
          </div>

          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/Reports" id="admin-reports">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10" />
              <line x1="12" y1="20" x2="12" y2="4" />
              <line x1="6" y1="20" x2="6" y2="14" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Reports</span>
          </a>

          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/Inquiries" id="admin-inquiries">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Inquiries</span>
            <span id="notif-inquiries-count" class="sidebar-text ml-auto px-2 py-0.5 bg-brand-400/20 text-white text-[10px] font-bold rounded-full hidden"></span>
          </a>

          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/ActivityLogs" id="admin-activitylogs">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
            <span class="sidebar-text nav-links transition-opacity duration-300">Activity Logs</span>
            <span id="notif-activitylogs-count" class="sidebar-text ml-auto  px-2 py-0.5 bg-brand-400/20 text-white text-[10px] font-bold rounded-full hidden"></span>
          </a>
          }
          
          
          @if(r == "admin" ){
          <div class="px-7 py-2.5 mt-1">
            <span class="sidebar-text text-[9.5px] font-bold uppercase tracking-[0.12em] text-white font-display">Controls</span>
          </div>
          <a class="nav-item flex items-center gap-4 px-4 py-2.5 mx-2 rounded-xl cursor-pointer text-white text-[13px] font-medium transition-all"
            href="@basePath/Reviews" id="admin-reviews">
            <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              <path d="M12 7l1.25 2.5 2.75.5-2 2 .5 2.75L12 13l-2.5 1.25.5-2.75-2-2 2.75-.5L12 7z" />
            </svg>

            <span class="sidebar-text nav-links transition-opacity duration-300">Reviews</span>
            <span id="notif-reviews-count" class="sidebar-text ml-auto text-[11px] hidden unread-dot"></span>
          </a>

          <!-- Settings Dropdown -->
          <div class="relative px-2">
            <button class="nav-item group w-full flex items-center gap-4 px-4 py-2.5 rounded-xl cursor-pointer text-white text-[13px] font-medium "
              id="settings-dropdown-btn">
              <svg class="flex-shrink-0" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15-.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <span class="sidebar-text nav-links transition-opacity duration-300">Settings</span>
              <svg class="sidebar-text ml-auto transition-transform duration-200" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" id="settings-arrow">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <!-- Dropdown content (Expanded Sidebar) -->
            <div id="settings-dropdown" class="hidden pl-10 pr-2 py-1 space-y-1 overflow-hidden transition-all duration-300">
              <a href="/Admin/Settings/Identity" class="block px-4 py-2 rounded-lg text-[11.5px] text-white/60 hover:text-white hover:bg-white/[0.05] transition-colors">Identity</a>
              <a href="/Admin/Settings/Availability" class="block px-4 py-2 rounded-lg text-[11.5px] text-white/60 hover:text-white hover:bg-white/[0.05] transition-colors">Availability</a>
              <a href="/Admin/Settings/FAQs" class="block px-4 py-2 rounded-lg text-[11.5px] text-white/60 hover:text-white hover:bg-white/[0.05] transition-colors">FAQs</a>
              <a href="/Admin/Settings/Photos" class="block px-4 py-2 rounded-lg text-[11.5px] text-white/60 hover:text-white hover:bg-white/[0.05] transition-colors">Photos</a>
            </div>

            <!-- Popup Menu (Collapsed Sidebar) -->
            <div id="settings-popup" class="hidden fixed left-[72px] mt-[-40px] w-44 bg-[#1f2c4b] border border-white/10 rounded-xl shadow-2xl overflow-hidden z-[500] animate-in fade-in slide-in-from-left-2 duration-200">
              <div class="px-4 py-2 border-b border-white/5 bg-white/5">
                <span class="text-[10px] font-bold uppercase tracking-widest text-white/40">Clinic Settings</span>
              </div>
              <a href="/Admin/Settings/Identity" class="block px-4 py-2.5 text-[12px] text-white hover:bg-white/10 transition-colors">Identity</a>
              <a href="/Admin/Settings/Availability" class="block px-4 py-2.5 text-[12px] text-white hover:bg-white/10 transition-colors">Availability</a>
              <a href="/Admin/Settings/FAQs" class="block px-4 py-2.5 text-[12px] text-white hover:bg-white/10 transition-colors">FAQs</a>
              <a href="/Admin/Settings/Photos" class="block px-4 py-2.5 text-[12px] text-white hover:bg-white/10 transition-colors">Photos</a>
            </div>
          </div>
          }
        </nav>

        <div class="p-2 border-t border-white/[0.07] flex-shrink-0 overflow-visible relative">
          
          <!-- Popup for Collapsed State -->
          <div id="user-popup" class="hidden absolute bottom-[100%] left-2 mb-2 w-48 bg-[#1f2c4b] border border-white/10 rounded-xl shadow-xl overflow-hidden z-[300]">
            <a href="/StaffProfile" class="block px-4 py-2.5 text-sm text-white hover:bg-white/[0.05] transition-colors font-medium">Profile</a>
            <button id="popupSignoutBtn" class="w-full text-left px-4 py-2.5 text-sm text-red-400 hover:bg-white/[0.05] transition-colors font-medium">Sign Out</button>
          </div>

          <div class="flex justify-between items-center p-2.5 rounded-xl bg-white/[0.05]">
            <div id="user-profile-btn" class="flex items-center gap-2.5 cursor-pointer hover:bg-white/[0.05] p-1.5 -ml-1.5 rounded-xl transition-colors">
              <div
                class="w-8 h-8 rounded-full bg-primary primary/80 flex items-center justify-center text-white text-[11px] font-bold flex-shrink-0"
                id="sidebar-user-initials">
                @(ViewData["UserInitials"] ?? "")
              </div>
              <div class="sidebar-text flex flex-col min-w-0">
                <span class="text-[12px] font-medium text-white truncate" id="sidebar-user-name">@(ViewData["UserName"] ?? "Staff")</span>
                <span class="text-[10px] text-white capitalize" id="sidebar-user-role">@(ViewData["UserRole"] ?? "")</span>
              </div>
            </div>
            <button id="signoutBtn"
              class="sidebar-text border-none bg-transparent text-white flex items-center gap-2.5 px-4 py-2.5 rounded-xl hover:text-red-600 hover:bg-white/[0.05] transition-colors font-medium">
              <svg class="menu-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </aside>

    <!-- MAIN -->
    <main id="main"
      class="flex-1 flex flex-col min-h-screen transition-all duration-[250ms] lg:ml-[256px] overflow-hidden relative">
      <!-- TOPBAR -->
      <header
        class="bg-white border-b border-slate-200 z-[50] flex items-center justify-between px-4 lg:px-6 h-[60px] flex-shrink-0 fixed left-0 lg:left-[256px] top-0 w-full lg:w-[calc(100%-256px)] transition-all duration-[250ms]">
        <div class="flex items-center gap-3">
          <!-- Hamburger (mobile only) -->
          <button class="lg:hidden p-2 rounded-lg hover:bg-slate-100 text-slate-600 transition-colors"
            id="openSidebarBtn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
          <div>
            <h1 id="page-title" class="font-display text-[15px] font-bold text-brand-900 leading-tight">
              Dashboard
            </h1>
            <p id="page-breadcrumb" class="text-[10.5px] text-brand-500">
              Overview · Today
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <div class="relative hidden sm:block">
            <svg class="absolute left-2.5 top-1/2 translate-half text-slate-400" width="13" height="13"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input placeholder="Search…"
              class="pl-8 pr-3 py-1.5 text-[12px] bg-slate-50 border border-slate-200 rounded-lg outline-none focus:border-primary/50 focus:ring-2 focus:ring-primary/10 w-44" />
          </div>
          <div class="relative">
            <button id="notif-bell" class="relative p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition-colors" data-dropdown-toggle="notif-dropdown">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
              </svg>
              <span id="notif-dot" class="absolute top-1.5 right-1.5 w-1.5 h-1.5 rounded-full bg-accent pulse hidden"></span>
            </button>
            
            <!-- Notification Dropdown -->
            <div id="notif-dropdown" class="z-[200] hidden bg-white !translate-x-[-285px] !translate-y-[44px] divide-y divide-slate-100 rounded-2xl shadow-xl border border-slate-200 rounded-tr-none w-80 max-h-[480px] overflow-hidden">
              <div class="px-4 py-3 bg-slate-50/50 flex items-center justify-between">
                <span class="text-[13px] font-bold text-brand">Notifications</span>
                <button id="mark-all-read" class="text-[10px] text-primary font-medium hover:underline">Mark all as read</button>
              </div>
              <div id="notif-list" class="overflow-y-auto max-h-[400px] divide-y divide-slate-50">
                <div class="py-8 text-center text-slate-400 text-[11px]">No notifications</div>
              </div>
              <div class="p-2 text-center bg-slate-50/50">
                <a href="#" class="text-[10px] text-brand font-medium hover:underline">View all activity</a>
              </div>
            </div>
          </div>
          <div id="date-pill"
            class="hidden md:flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-[11px] font-medium text-brand-500 bg-slate-50 border border-slate-200">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <span id="cur-date"></span>
          </div>
        </div>
      </header>

      <!-- PAGE CONTENT -->
      <div class="flex-1 max-w-full overflow-hidden mt-[60px]">@RenderBody()</div>
    </main>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-5 right-5 space-y-1 z-[10000]"></div>

  <!-- Modal Root -->
  <div id="modal-root" ></div>

  <!-- Hidden role data for JS -->
  <input type="hidden" id="currentUserRole" value="@(ViewData["UserRole"] ?? "")" />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
  <script type="module" src="~/js/AdminSide/adminNotifications.js" asp-append-version="true"></script>
  <script src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"></script>
  <script src="/_framework/aspnetcore-browser-refresh.js"></script>

  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>