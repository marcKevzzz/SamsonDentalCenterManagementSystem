<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- VIEW APPOINTMENT MODAL                                                    -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<div id="view-modal" class="fixed inset-0 z-[60] hidden">
  <div class="absolute inset-0 bg-brand/40 backdrop-blur-md" onclick="closeViewModal()"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="view-modal-box"
      class="bg-white rounded-3xl shadow-2xl w-full max-w-lg pointer-events-auto
             transform scale-95 opacity-0 transition-all duration-300 flex flex-col overflow-hidden">

      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h3 class="font-display font-bold text-xl text-brand">Appointment Details</h3>
          <p id="view-appt-id" class="text-brand/40 text-[11px] font-bold uppercase tracking-wider mt-1">#APT-XXXX</p>
        </div>
        <div id="view-status-badge" class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider border">
          <span id="view-status">STATUS</span>
        </div>
      </div>

      <div class="p-8 space-y-6 overflow-y-auto max-h-[70vh]">
        
        <!-- Patient Section -->
        <div class="space-y-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              <h4 class="text-[11px] font-bold uppercase tracking-wider text-brand/40">Patient Information</h4>
            </div>
            <span id="view-patient-type-badge" class="text-[9px] font-bold bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded border border-slate-200 uppercase tracking-tight">Verified Patient</span>
          </div>
          <div class="grid grid-cols-2 gap-6 bg-slate-50/50 p-5 rounded-2xl border border-slate-100">
            <div>
              <p class="text-[10px] font-bold text-brand/30 uppercase tracking-widest mb-1">Account Holder</p>
              <p id="view-patient-name" class="text-[13.5px] font-bold text-brand">-</p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-brand/30 uppercase tracking-widest mb-1">Source</p>
              <p id="view-source" class="text-[12px] font-medium text-brand">-</p>
            </div>
            <div class="col-span-2">
              <p class="text-[10px] font-bold text-brand/30 uppercase tracking-widest mb-1">Email Address</p>
              <p id="view-patient-email" class="text-[13px] font-medium text-brand">-</p>
            </div>
          </div>
        </div>

        <!-- Managed Profile Section (Hidden by default) -->
        <div id="view-other-section" class="space-y-4 hidden">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
            <h4 class="text-[11px] font-bold uppercase tracking-wider text-brand/40">Managed Profile (Booked For)</h4>
          </div>
          <div class="grid grid-cols-2 gap-6 bg-purple-50/30 p-5 rounded-2xl border border-purple-100/50">
            <div>
              <p class="text-[10px] font-bold text-purple-600/40 uppercase tracking-widest mb-1">Patient Name</p>
              <p id="view-other-name" class="text-[13.5px] font-bold text-brand">-</p>
            </div>
             <div>
              <p class="text-[10px] font-bold text-purple-600/40 uppercase tracking-widest mb-1">Relationship</p>
              <p class="text-[12px] font-medium text-brand">Managed Account</p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-purple-600/40 uppercase tracking-widest mb-1">Phone Number</p>
              <p id="view-other-phone" class="text-[13px] font-medium text-brand">-</p>
            </div>
             <div>
              <p class="text-[10px] font-bold text-purple-600/40 uppercase tracking-widest mb-1">Email Address</p>
              <p id="view-other-email" class="text-[12px] font-medium text-brand">-</p>
            </div>
          </div>
        </div>

        <!-- Appointment Section -->
        <div class="space-y-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
            <h4 class="text-[11px] font-bold uppercase tracking-wider text-brand/40">Treatment Details</h4>
          </div>
          <div class="grid grid-cols-2 gap-6 bg-slate-50/50 p-5 rounded-2xl border border-slate-100">
            <div class="col-span-2">
              <p class="text-[10px] font-bold text-brand/30 uppercase tracking-widest mb-1">Service & Category</p>
              <p class="text-[13.5px] font-bold text-brand">
                <span id="view-service">-</span> 
                <span class="text-brand/40 font-medium text-[11px] ml-1">/ <span id="view-category">-</span></span>
              </p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-brand/30 uppercase tracking-widest mb-1">Dental Specialist</p>
              <p id="view-doctor" class="text-[13px] font-medium text-brand">-</p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-brand/30 uppercase tracking-widest mb-1">Schedule</p>
              <p class="text-[13px] font-bold text-brand">
                <span id="view-date">-</span> <br/>
                <span id="view-time" class="text-brand/50 font-medium text-[11px]">-</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Notes Section -->
        <div class="space-y-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            <h4 class="text-[11px] font-bold uppercase tracking-wider text-brand/40">Additional Notes</h4>
          </div>
          <div class="bg-amber-50/50 p-5 rounded-2xl border border-amber-100/50 min-h-[80px]">
            <p id="view-notes" class="text-[12.5px] text-brand/70 italic leading-relaxed">-</p>
          </div>
        </div>
      </div>

      <div class="flex justify-end p-6 bg-slate-50 border-t border-slate-100">
        <button onclick="closeViewModal()"
          class="px-8 py-2.5 text-[12px] font-bold rounded-xl bg-brand text-white shadow-xl shadow-brand/10 hover:opacity-90 transition-all">
          Close Details
        </button>
      </div>
    </div>
  </div>
</div>
