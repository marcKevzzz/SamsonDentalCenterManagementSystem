@page "/Legal"
@{
    ViewData["Title"] = "Legal Information";
}

<div class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-center mb-16">
        <h1 class="brand-font text-4xl font-bold text-brand mb-4">Legal Information</h1>
        <p class="text-brand/60">Our commitment to your privacy and transparent service.</p>
    </div>

    <div class="space-y-16">
        <!-- Privacy Policy -->
        <section id="privacy" class="scroll-mt-24">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h2 class="brand-font text-2xl font-bold text-brand">Privacy Policy</h2>
            </div>
            <div class="prose prose-slate max-w-none text-brand/70 leading-relaxed space-y-4">
                <p>At Samson Dental Center, we take your medical and personal privacy seriously. This policy outlines how we collect, use, and protect your information.</p>
                <h3 class="text-brand font-bold mt-6">1. Information Collection</h3>
                <p>We collect personal details (name, DOB, contact) and clinical records necessary for your dental treatment. This data is stored securely on encrypted servers.</p>
                <h3 class="text-brand font-bold mt-6">2. Data Usage</h3>
                <p>Your information is used strictly for scheduling, medical evaluation, billing, and clinical communication. We do not sell your data to third parties.</p>
                <h3 class="text-brand font-bold mt-6">3. Confidentiality</h3>
                <p>All staff members are bound by confidentiality agreements. Your records are only accessible to authorized clinical personnel involved in your care.</p>
            </div>
        </section>

        <hr class="border-slate-100" />

        <!-- Terms of Service -->
        <section id="terms" class="scroll-mt-24">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <i class="fa-solid fa-file-contract"></i>
                </div>
                <h2 class="brand-font text-2xl font-bold text-brand">Terms of Service</h2>
            </div>
            <div class="prose prose-slate max-w-none text-brand/70 leading-relaxed space-y-4">
                <p>By using our services and portal, you agree to the following terms and conditions.</p>
                <h3 class="text-brand font-bold mt-6">1. Appointment Booking</h3>
                <p>Appointments are subject to availability. While we strive to honor all scheduled times, emergencies may occasionally require rescheduling. You will be notified promptly via email or phone.</p>
                <h3 class="text-brand font-bold mt-6">2. Cancellation Policy</h3>
                <p>We require at least 24 hours notice for cancellations. Repeated no-shows may result in a deposit requirement for future bookings.</p>
                <h3 class="text-brand font-bold mt-6">3. Medical Accuracy</h3>
                <p>You agree to provide accurate and complete medical history. Samson Dental Center is not liable for complications arising from undisclosed medical conditions.</p>
            </div>
        </section>
    </div>
</div>
