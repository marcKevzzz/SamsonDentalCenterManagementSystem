@page "/Admin/Settings/Photos"
@model SamsonDentalCenterManagementSystem.Pages.AdminSide.AdminSettingsModel
@{
    Layout = "AdminSide/_StaffLayout";
    ViewData["Title"] = "Clinic Photos";
    ViewData["Breadcrumb"] = "Settings · Photos";
}

<div class="h-full flex flex-col p-6 overflow-hidden">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-brand tracking-tight font-display">Clinic Gallery</h1>
            <p class="text-slate-500 text-[13px] mt-1 font-medium">Manage the clinic's visual gallery shown to potential patients.</p>
        </div>
    </div>

    @Html.AntiForgeryToken()
    <input type="hidden" id="toast-msg" value="@TempData["Toast"]" />
    <input type="hidden" id="toast-type" value="@TempData["ToastType"]" />

    <form method="post" asp-route-section="Photos" class="flex-1 flex flex-col gap-6 overflow-hidden">
        <input type="hidden" asp-for="Settings.Id" />
        
        <div class="flex-1 overflow-y-auto pr-2 space-y-8 pb-32">
            <div class="bg-white p-7 rounded-[32px] border border-slate-200 shadow-sm space-y-8">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-brand/10 text-brand flex items-center justify-center">
                        <i class="fa-solid fa-images text-sm"></i>
                    </div>
                    <h3 class="text-slate-800 font-bold text-base">Gallery Management</h3>
                </div>
                <input type="hidden" asp-for="Settings.ClinicPhotosJson" id="photos-json" />
                <div id="photos-list" class="min-h-[300px]">
                    <!-- Populated by JS -->
                </div>
                <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center">
                    <p class="text-[11px] text-brand/40 font-bold uppercase tracking-widest mb-1">Upload Tip</p>
                    <p class="text-[10px] text-slate-400 font-medium">Changes here are staged locally. Click "Save Gallery" below to commit them to the database.</p>
                </div>
            </div>
        </div>

        <!-- FAB -->
        <div class="fixed bottom-8 right-8 flex items-center gap-4">
            <button type="button" onclick="saveGallery(this)" class="group bg-brand text-white pl-8 pr-10 py-5 rounded-[28px] font-bold text-sm shadow-2xl shadow-brand/30 hover:shadow-brand/50 hover:scale-[1.02] active:scale-95 transition-all flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center group-hover:rotate-12 transition-transform">
                    <i class="fa-solid fa-check text-xs"></i>
                </div>
                Save Gallery
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script type="module">
        import { ClinicSettings } from '../../../js/AdminSide/adminSettings.js';
        document.addEventListener('DOMContentLoaded', () => {
            const settings = new ClinicSettings();
            settings.init();
        });
    </script>
}
