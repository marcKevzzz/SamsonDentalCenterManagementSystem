<!-- CONFIRM APPOINTMENT MODAL                                                 -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<div id="confirm-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-emerald-900/30 backdrop-blur-md" onclick="closeConfirmModal()"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="confirm-modal-box"
      class="bg-white rounded-3xl shadow-2xl w-full max-w-md pointer-events-auto
             transform scale-95 opacity-0 transition-all duration-300 flex flex-col overflow-hidden">

      <div class="p-6 border-b border-slate-100 bg-emerald-50/50">
        <h3 class="font-display font-bold text-xl text-emerald-700">Confirm Booking</h3>
        <p class="text-emerald-600/60 text-[11px] font-bold uppercase tracking-wider mt-1">Finalize Appointment Slot</p>
      </div>

      <div class="p-6 space-y-6">
        <div class="bg-emerald-50 rounded-2xl p-4 border border-emerald-100/50">
            <p id="confirm-modal-message" class="text-[13px] text-emerald-800 leading-relaxed"></p>
        </div>
        
        <!-- Doctor selection removed as per request -->
        <input type="hidden" id="confirm-doctor" value="any" />
      </div>

      <input type="hidden" id="confirm-appt-id" />

      <div class="flex justify-end gap-3 p-6 bg-slate-50 border-t border-slate-100">
        <button onclick="closeConfirmModal()"
          class="px-6 py-2.5 text-[12px] font-bold text-brand/50 hover:text-brand transition-colors">
          Dismiss
        </button>
        <button onclick="submitConfirm()"
          class="px-8 py-2.5 text-[12px] font-bold rounded-xl bg-emerald-600 text-white shadow-xl shadow-emerald-600/20 hover:opacity-90 transition-all">
          Approve Booking
        </button>
      </div>
    </div>
  </div>
</div>



<!-- ── BLOCK DATE MODAL ──────────────────────────────────────────────────── -->
<div id="block-date-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-brand/40 backdrop-blur-md" onclick="closeBlockDateModal()"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="block-date-modal-box"
      class="bg-white rounded-3xl shadow-2xl w-full max-w-lg pointer-events-auto transform scale-95 opacity-0 transition-all duration-300 flex flex-col overflow-hidden">

      <div class="p-6 border-b border-slate-100 bg-red-50/60">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center">
            <i class="fa-solid fa-ban text-red-500"></i>
          </div>
          <div>
            <h3 class="font-display font-bold text-[17px] text-brand">Block a Date</h3>
            <p class="text-[11px] text-brand/40 font-bold uppercase tracking-wider mt-0.5">Prevent new bookings</p>
          </div>
        </div>
      </div>

      <div class="p-6 space-y-5">
        <div>
          <label class="block text-[11px] font-bold text-brand mb-2 ml-1">Date to Block *</label>
          <input id="block-date-input" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")"
            class="w-full text-[13px] px-4 py-3 rounded-xl border border-slate-100 bg-slate-50/50 focus:bg-white focus:border-red-400 focus:ring-4 focus:ring-red-400/10 transition-all outline-none" />
        </div>
        <div>
          <label class="block text-[11px] font-bold text-brand mb-2 ml-1">Reason <span class="text-brand/40 font-normal">(optional)</span></label>
          <input id="block-date-reason" type="text" placeholder="e.g. Clinic holiday, Staff training, Emergency closure…"
            class="w-full text-[13px] px-4 py-3 rounded-xl border border-slate-100 bg-slate-50/50 focus:bg-white focus:border-red-400 focus:ring-4 focus:ring-red-400/10 transition-all outline-none" />
        </div>

        <!-- Blocked dates list -->
        <div>
          <p class="text-[11px] font-bold text-brand/40 uppercase tracking-wider mb-2">Currently Blocked</p>
          <div id="blocked-dates-list" class="space-y-1.5 max-h-40 overflow-y-auto">
            <p class="text-[11px] text-brand/40 italic">Loading…</p>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 p-6 bg-slate-50 border-t border-slate-100">
        <button onclick="closeBlockDateModal()"
          class="px-6 py-2.5 text-[12px] font-bold text-brand hover:text-brand transition-colors">Cancel</button>
        <button onclick="submitBlockDate()"
          class="px-8 py-2.5 text-[12px] font-bold rounded-xl bg-red-500 text-white shadow-xl shadow-red-500/20 hover:opacity-90 transition-all">
          <i class="fa-solid fa-ban mr-1.5"></i>Block Date
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── CONFLICT MODAL (shown after blocking a date with existing appts) ──── -->
<div id="conflict-modal" class="fixed inset-0 z-[40] hidden">
  <div class="absolute inset-0 bg-brand/50 backdrop-blur-md"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="conflict-modal-box"
      class="bg-white rounded-3xl shadow-2xl w-full max-w-lg pointer-events-auto transform scale-95 opacity-0 transition-all duration-300 flex flex-col overflow-hidden">

      <div class="p-6 border-b border-amber-100 bg-amber-50/70">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
            <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
          </div>
          <div>
            <h3 class="font-display font-bold text-[17px] text-brand">Date Blocked — Action Required</h3>
            <p id="conflict-summary" class="text-[12px] text-amber-700 mt-0.5"></p>
          </div>
        </div>
      </div>

      <div class="p-6">
        <p class="text-[12px] text-brand/60 mb-3">The following appointments are still active on this date. They will <strong>not</strong> be automatically cancelled — please handle them manually.</p>
        <div id="conflict-list" class="space-y-2 max-h-56 overflow-y-auto"></div>
      </div>

      <div class="flex justify-end gap-3 p-6 bg-slate-50 border-t border-slate-100">
        <button onclick="closeConflictModal()"
          class="px-8 py-2.5 text-[12px] font-bold rounded-xl bg-brand text-white shadow-xl shadow-brand/10 hover:opacity-90 transition-all">
          Got it, I'll handle them
        </button>
      </div>
    </div>
  </div>
</div>

    <script type="module" src="~/js/AdminSide/adminAppointment.js"></script>
