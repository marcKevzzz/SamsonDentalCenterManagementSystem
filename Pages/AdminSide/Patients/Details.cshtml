@page "/Admin/Patients/Details"
@model SamsonDentalCenterManagementSystem.Pages.AdminSide.Patients.PatientDetailsModel
@{
    Layout = "AdminSide/_StaffLayout";
    var p = Model.Patient;
    var initials = p != null ? $"{(p.FirstName.Length > 0 ? p.FirstName[0] : ' ')}{(p.LastName.Length > 0 ? p.LastName[0] : ' ')}".Trim().ToUpper() : "??";
    var age = p?.DateOfBirth.HasValue == true ? (DateTime.Today.Year - p.DateOfBirth.Value.Year).ToString() : "N/A";
}

<div class="page p-4 md:p-6 bg-slate-50 min-h-screen font-sans">
    <!-- Header / Breadcrumbs -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
            <a href="/Admin/Patients" class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-brand/50 hover:bg-slate-50 hover:border-brand/20 transition-all shadow-sm">
                <i class="fa-solid fa-arrow-left text-xs"></i>
            </a>
            <div>
                <h2 class="text-xl font-bold text-brand tracking-tight">Patient Portfolio</h2>
                <div class="flex items-center gap-2 text-[10px] text-brand/40 mt-0.5">
                    <span class="font-bold uppercase tracking-wider">Clinical</span>
                    <i class="fa-solid fa-chevron-right text-[7px] opacity-30"></i>
                    <span class="text-brand/60 font-bold uppercase tracking-wider">@p?.FirstName @p?.LastName</span>
                </div>
            </div>
        </div>
        <div class="flex gap-2">
            <button onclick="openNewMessage()" class="px-4 py-2 bg-white border border-slate-200 text-brand/60 rounded-xl text-[12px] font-bold shadow-sm hover:bg-slate-50 transition-all flex items-center gap-2">
                <i class="fa-solid fa-comment-dots text-[10px]"></i>
                <span class="hidden sm:inline">Message</span>
            </button>
            <button onclick="openNewAppointment()" class="px-4 py-2 bg-primary text-white rounded-xl text-[12px] font-bold shadow-md hover:shadow-lg hover:scale-[1.01] active:scale-95 transition-all flex items-center gap-2">
                <i class="fa-solid fa-calendar-plus text-[10px]"></i>
                <span class="hidden sm:inline">Schedule Visit</span>
                <span class="sm:hidden">Schedule</span>
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Sidebar: Patient Info -->
        <div class="lg:col-span-3 space-y-5">
            <div class="bg-white rounded-2xl p-6 border border-slate-200/60 shadow-sm sticky top-6">
                <div class="flex flex-col items-center text-center mb-6">
                    <div class="relative mb-4 group">
                        @if (!string.IsNullOrEmpty(p?.AvatarUrl)) {
                            <img src="@p.AvatarUrl" class="w-20 h-20 rounded-2xl object-cover ring-4 ring-slate-50 shadow-lg transition-transform group-hover:scale-105 duration-500" />
                        } else {
                            <div class="w-20 h-20 rounded-2xl bg-primary flex items-center justify-center text-white text-2xl font-bold shadow-lg ring-4 ring-slate-50 transition-transform group-hover:scale-105 duration-500">
                                @initials
                            </div>
                        }
                        <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-white shadow-sm"></div>
                    </div>
                    <h3 class="text-lg font-bold text-brand">@p?.FirstName @p?.LastName</h3>
                    <div class="mt-1 flex items-center gap-1.5 justify-center">
                        <span class="px-2 py-0.5 bg-slate-100 text-[8px] font-bold uppercase tracking-widest text-brand/40 rounded-md">#@p?.Id.Substring(0, 8).ToUpper()</span>
                        <span class="px-2 py-0.5 @(p?.IsActive == true ? "bg-emerald-50 text-emerald-600" : "bg-rose-50 text-rose-600") text-[8px] font-bold uppercase tracking-widest rounded-md">@(p?.IsActive == true ? "ACTIVE" : "INACTIVE")</span>
                    </div>
                </div>

                <div class="space-y-3">
                    <div class="p-3.5 rounded-xl bg-slate-50/50 border border-slate-100 hover:border-brand/10 transition-colors">
                        <div class="text-[8px] text-brand/40 font-bold uppercase tracking-widest mb-1 flex items-center gap-1.5">
                            <i class="fa-solid fa-venus-mars text-[7px]"></i> Demographics
                        </div>
                        <div class="text-[12px] font-bold text-brand">@age yrs • @(p?.Sex ?? "Unknown")</div>
                    </div>
                    <div class="p-3.5 rounded-xl bg-slate-50/50 border border-slate-100 hover:border-brand/10 transition-colors">
                        <div class="text-[8px] text-brand/40 font-bold uppercase tracking-widest mb-1 flex items-center gap-1.5">
                            <i class="fa-solid fa-phone text-[7px]"></i> Contact
                        </div>
                        <div class="text-[12px] font-bold text-brand">@p?.PhoneNumber</div>
                        <div class="text-[10px] text-brand/40 truncate mt-0.5">@p?.Email</div>
                    </div>
                    <div class="p-3.5 rounded-xl bg-slate-50/50 border border-slate-100 hover:border-brand/10 transition-colors">
                        <div class="text-[8px] text-brand/40 font-bold uppercase tracking-widest mb-1 flex items-center gap-1.5">
                            <i class="fa-solid fa-location-dot text-[7px]"></i> Residence
                        </div>
                        <div class="text-[11px] font-bold text-brand line-clamp-2">@(p?.Address ?? "No address listed")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(p?.Relationship)) {
                    <div class="p-3.5 rounded-xl bg-slate-50/50 border border-slate-100 hover:border-brand/10 transition-colors">
                        <div class="text-[8px] text-brand/40 font-bold uppercase tracking-widest mb-1 flex items-center gap-1.5">
                            <i class="fa-solid fa-people-arrows text-[7px]"></i> Relationship
                        </div>
                        <div class="text-[12px] font-bold text-brand">@p.Relationship</div>
                    </div>
                    }
                    @if (!string.IsNullOrEmpty(p?.EmergencyContact)) {
                    <div class="p-3.5 rounded-xl bg-rose-50/50 border border-rose-100 hover:border-rose-200 transition-colors">
                        <div class="text-[8px] text-rose-500 font-bold uppercase tracking-widest mb-1 flex items-center gap-1.5">
                            <i class="fa-solid fa-phone-flip text-[7px]"></i> Emergency
                        </div>
                        <div class="text-[12px] font-bold text-brand">@p.EmergencyContact</div>
                    </div>
                    }
                </div>

                @if (Model.MedicalInfo != null) {
                    <div class="mt-6 pt-6 border-t border-slate-100">
                        <div class="text-[9px] text-brand/40 font-bold uppercase tracking-widest mb-3 flex items-center justify-between">
                            Alerts
                            <i class="fa-solid fa-triangle-exclamation text-rose-400"></i>
                        </div>
                        <div class="flex flex-wrap gap-1.5">
                            @if (Model.MedicalInfo.IsSmoker == true) {
                                <span class="px-2 py-0.5 bg-rose-50 text-rose-600 text-[9px] font-bold rounded-lg border border-rose-100">Smoker</span>
                            }
                            @if (!string.IsNullOrEmpty(Model.MedicalInfo.BloodType)) {
                                <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 text-[9px] font-bold rounded-lg border border-emerald-100">Type @Model.MedicalInfo.BloodType</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Main Content -->
        <div class="lg:col-span-9 space-y-6">
            <!-- Summary Tiles -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div class="bg-white p-5 rounded-2xl border border-slate-200/60 shadow-sm flex items-center gap-4 group hover:border-rose-100 transition-all">
                    <div class="w-11 h-11 rounded-xl bg-rose-50 text-rose-500 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-wallet text-lg"></i>
                    </div>
                    <div>
                        <div class="text-[9px] text-brand/40 font-bold uppercase tracking-widest mb-0.5">Balance</div>
                        <div class="text-xl font-bold text-brand">₱@Model.OutstandingBalance.ToString("N0")</div>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200/60 shadow-sm flex items-center gap-4 group hover:border-brand/10 transition-all">
                    <div class="w-11 h-11 rounded-xl bg-brand-50 text-brand/60 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-calendar-check text-lg"></i>
                    </div>
                    <div>
                        <div class="text-[9px] text-brand/40 font-bold uppercase tracking-widest mb-0.5">Next Visit</div>
                        @if (Model.NextAppointment != null) {
                            <div class="text-[13px] font-bold text-brand">@Model.NextAppointment.AppointmentDate.ToString("MMM dd")</div>
                            <div class="text-[10px] font-bold text-brand/40 uppercase">@Model.NextAppointment.AppointmentTime</div>
                        } else {
                            <div class="text-[12px] font-bold text-slate-300 italic">None Scheduled</div>
                        }
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200/60 shadow-sm flex items-center gap-4 group hover:border-emerald-100 transition-all">
                    <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-tooth text-lg"></i>
                    </div>
                    <div>
                        <div class="text-[9px] text-brand/40 font-bold uppercase tracking-widest mb-0.5">Last Treatment</div>
                        @if (Model.LastTreatmentDate.HasValue) {
                            <div class="text-[13px] font-bold text-brand">@Model.LastTreatmentDate.Value.ToString("MMM dd, yyyy")</div>
                            <div class="text-[10px] font-bold text-brand/40 uppercase truncate max-w-[120px]">@Model.ClinicalTimeline.FirstOrDefault()?.ServiceName</div>
                        } else {
                            <div class="text-[12px] font-bold text-slate-300 italic">New Patient</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Tabs Module -->
            <div class="space-y-5">
                <!-- Tab Bar -->
                <div class="flex items-center justify-between">
                    <div id="tab-bar" class="flex gap-1.5 bg-white p-1 rounded-xl border border-slate-200/60 shadow-sm">
                        <button onclick="switchTab('timeline')" data-tab="timeline" class="tab-btn active px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all">History</button>
                        <button onclick="switchTab('chart')" data-tab="chart" class="tab-btn text-brand/40 hover:bg-slate-50 px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all">Chart</button>
                        <button onclick="switchTab('medical')" data-tab="medical" class="tab-btn text-brand/40 hover:bg-slate-50 px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all">Medical</button>
                        <button onclick="switchTab('appointments')" data-tab="appointments" class="tab-btn text-brand/40 hover:bg-slate-50 px-5 py-1.5 rounded-lg text-[11px] font-bold uppercase tracking-wider transition-all">Visits</button>
                    </div>
                    
                    <div class="hidden md:flex items-center gap-3 text-[10px] font-bold text-brand/40">
                        <div class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Stable</div>
                        <div class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand"></span> Active</div>
                    </div>
                </div>

                <!-- Tab Content: Timeline -->
                <div id="content-timeline" class="tab-content space-y-4">
                    @if (Model.ClinicalTimeline.Any()) {
                        <div class="relative space-y-6 before:absolute before:left-5 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-100">
                            @foreach (var t in Model.ClinicalTimeline) {
                                <div class="relative pl-12 group">
                                    <div class="absolute left-0 top-1 w-10 h-10 rounded-xl bg-white border-2 border-brand/10 flex items-center justify-center z-10 shadow-sm group-hover:border-primary group-hover:scale-105 transition-all">
                                        <i class="fa-solid fa-kit-medical text-brand/30 text-sm group-hover:text-primary transition-colors"></i>
                                    </div>
                                    <div class="bg-white border border-slate-100 rounded-2xl p-5 hover:border-brand/20 transition-all">
                                        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                                            <div>
                                                <h4 class="text-[14px] font-bold text-brand">@t.ServiceName</h4>
                                                <div class="flex items-center gap-3 mt-0.5 text-[10px] font-bold text-brand/40 uppercase tracking-widest">
                                                    <span>@t.CreatedAt.ToString("MMM dd, yyyy")</span>
                                                </div>
                                            </div>
                                            <span class="px-2.5 py-0.5 bg-emerald-50 text-emerald-600 text-[9px] font-bold uppercase tracking-widest rounded-full border border-emerald-100">@t.Status</span>
                                        </div>
                                        <div class="space-y-4">
                                            @if (!string.IsNullOrEmpty(t.ToothNumbers)) {
                                                <div class="flex flex-wrap gap-1.5">
                                                    @foreach(var tooth in t.ToothNumbers.Split(',')) {
                                                        <span class="px-2.5 py-0.5 bg-slate-50 text-brand/60 text-[9px] font-bold rounded-lg border border-slate-100">#@tooth.Trim()</span>
                                                    }
                                                </div>
                                            }
                                            <div class="bg-slate-50/50 p-4 rounded-xl border border-slate-100 italic text-[12px] text-brand/60 leading-relaxed shadow-inner">
                                                "@t.ProcedureDetails"
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    } else {
                        <div class="bg-white rounded-2xl p-12 text-center border border-slate-100 shadow-sm">
                            <div class="w-16 h-16 bg-slate-50 rounded-xl flex items-center justify-center mx-auto mb-4">
                                <i class="fa-solid fa-folder-open text-slate-200 text-2xl"></i>
                            </div>
                            <h4 class="text-lg font-bold text-brand mb-1">No Clinical History</h4>
                            <p class="text-[12px] text-brand/40 max-w-xs mx-auto">This patient hasn't had any recorded treatments yet.</p>
                        </div>
                    }
                </div>

                <!-- Tab Content: Chart -->
                <div id="content-chart" class="tab-content hidden">
                    <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm overflow-x-auto">
                        <div class="min-w-[800px]">
                            <div class="flex items-center justify-between mb-8">
                                <div>
                                    <h3 class="text-lg font-bold text-brand">Odontogram Visualization</h3>
                                    <p class="text-[10px] text-brand/40 font-bold uppercase tracking-widest mt-0.5">Digital charting of patient tooth status</p>
                                </div>
                                <div class="flex gap-3">
                                    <div class="flex items-center gap-2 text-[9px] font-bold text-brand/40 uppercase tracking-widest"><span class="w-2.5 h-2.5 rounded bg-emerald-500 shadow-sm"></span> Healthy</div>
                                    <div class="flex items-center gap-2 text-[9px] font-bold text-brand/40 uppercase tracking-widest"><span class="w-2.5 h-2.5 rounded bg-blue-500 shadow-sm"></span> Filled</div>
                                    <div class="flex items-center gap-2 text-[9px] font-bold text-brand/40 uppercase tracking-widest"><span class="w-2.5 h-2.5 rounded bg-rose-500 shadow-sm"></span> Decay</div>
                                </div>
                            </div>

                            <div class="bg-slate-50/50 rounded-[2rem] p-10 border border-slate-100 shadow-inner relative overflow-hidden">
                                <div class="absolute inset-x-0 top-1/2 translate-half h-px bg-slate-200/50"></div>
                                
                                <!-- Upper Arch -->
                                <div class="flex justify-center gap-2 mb-12 relative z-10">
                                    @for (int i = 1; i <= 16; i++) {
                                        var status = Model.ToothStatusMap.ContainsKey(i) ? Model.ToothStatusMap[i].ToLower() : "healthy";
                                        var colorClass = status switch {
                                            "healthy" => "bg-white text-emerald-500 border-emerald-100",
                                            "filled" => "bg-blue-500 text-white border-blue-600",
                                            "crown" => "bg-purple-500 text-white border-purple-600",
                                            "rct" => "bg-emerald-600 text-white border-emerald-700",
                                            "extracted" => "bg-slate-400 text-white border-slate-500 line-through",
                                            "decay" => "bg-rose-500 text-white border-rose-600",
                                            "missing" => "bg-slate-200 text-slate-400 border-slate-300 opacity-50",
                                            _ => "bg-amber-500 text-white border-amber-600"
                                        };
                                        <div class="flex flex-col items-center gap-1.5">
                                            <span class="text-[8px] font-bold text-slate-300">#@i</span>
                                            <div class="w-9 h-12 rounded-lg border flex items-center justify-center font-bold text-[11px] shadow-sm transition-all hover:scale-110 cursor-help @colorClass" title="Tooth #@i: @status">@i</div>
                                        </div>
                                    }
                                </div>

                                <!-- Lower Arch -->
                                <div class="flex justify-center gap-2 relative z-10">
                                    @for (int i = 32; i >= 17; i--) {
                                        var status = Model.ToothStatusMap.ContainsKey(i) ? Model.ToothStatusMap[i].ToLower() : "healthy";
                                        var colorClass = status switch {
                                            "healthy" => "bg-white text-emerald-500 border-emerald-100",
                                            "filled" => "bg-blue-500 text-white border-blue-600",
                                            "crown" => "bg-purple-500 text-white border-purple-600",
                                            "rct" => "bg-emerald-600 text-white border-emerald-700",
                                            "extracted" => "bg-slate-400 text-white border-slate-500 line-through",
                                            "decay" => "bg-rose-500 text-white border-rose-600",
                                            "missing" => "bg-slate-200 text-slate-400 border-slate-300 opacity-50",
                                            _ => "bg-amber-500 text-white border-amber-600"
                                        };
                                        <div class="flex flex-col items-center gap-1.5">
                                            <div class="w-9 h-12 rounded-lg border flex items-center justify-center font-bold text-[11px] shadow-sm transition-all hover:scale-110 cursor-help @colorClass" title="Tooth #@i: @status">@i</div>
                                            <span class="text-[8px] font-bold text-slate-300">#@i</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Medical -->
                <div id="content-medical" class="tab-content hidden">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Core Medical Data -->
                        <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-6">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-brand text-white flex items-center justify-center shadow-md">
                                        <i class="fa-solid fa-file-medical text-base"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-md font-bold text-brand">Medical Profile</h3>
                                        <p class="text-[9px] font-bold uppercase tracking-widest text-brand/40">Vital signs & data</p>
                                    </div>
                                </div>
                                <button onclick="openEditMedical()" class="w-8 h-8 rounded-lg bg-slate-50 text-brand/40 hover:text-brand hover:bg-slate-100 transition-all flex items-center justify-center">
                                    <i class="fa-solid fa-pen-to-square text-[12px]"></i>
                                </button>
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-[9px] font-bold text-brand/40 uppercase tracking-widest mb-1">Blood Type</div>
                                    <div class="text-lg font-bold text-brand">@(Model.MedicalInfo?.BloodType ?? "Unknown")</div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-[9px] font-bold text-brand/40 uppercase tracking-widest mb-1">Smoker</div>
                                    <div class="text-lg font-bold @(Model.MedicalInfo?.IsSmoker == true ? "text-rose-600" : "text-emerald-600")">@(Model.MedicalInfo?.IsSmoker == true ? "Yes" : "No")</div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-[9px] font-bold text-brand/40 uppercase tracking-widest mb-1">Weight</div>
                                    <div class="text-lg font-bold text-brand">@(Model.MedicalInfo?.Weight?.ToString("0.0") ?? "---") <span class="text-[10px] font-bold text-brand/40 uppercase">kg</span></div>
                                </div>
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                                    <div class="text-[9px] font-bold text-brand/40 uppercase tracking-widest mb-1">Height</div>
                                    <div class="text-lg font-bold text-brand">@(Model.MedicalInfo?.Height?.ToString("0.0") ?? "---") <span class="text-[10px] font-bold text-brand/40 uppercase">cm</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Allergies & Risks -->
                        <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-6">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-rose-500 text-white flex items-center justify-center shadow-md">
                                        <i class="fa-solid fa-shield-virus text-base"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-md font-bold text-brand">Allergies & Risks</h3>
                                        <p class="text-[9px] font-bold uppercase tracking-widest text-brand/40">Critical safety info</p>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-3">
                                @if (Model.MedicalInfo != null && !string.IsNullOrEmpty(Model.MedicalInfo.AllergiesJson)) {
                                    var allergies = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.MedicalInfo.AllergiesJson);
                                    if (allergies?.Any() == true) {
                                        @foreach (var allergy in allergies) {
                                            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-rose-50 border border-rose-100 text-rose-700">
                                                <i class="fa-solid fa-circle-exclamation text-rose-400 text-[11px]"></i>
                                                <span class="text-[12px] font-bold uppercase tracking-wider">@allergy</span>
                                            </div>
                                        }
                                    } else {
                                        <div class="flex flex-col items-center justify-center py-8 text-center opacity-40">
                                            <i class="fa-solid fa-check-circle text-3xl mb-2"></i>
                                            <p class="text-[12px] font-bold">No Known Allergies</p>
                                        </div>
                                    }
                                } else {
                                    <div class="flex flex-col items-center justify-center py-8 text-center opacity-40">
                                        <i class="fa-solid fa-check-circle text-3xl mb-2"></i>
                                        <p class="text-[12px] font-bold">No Known Allergies</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab Content: Appointments -->
                <div id="content-appointments" class="tab-content hidden">
                    <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50/80 border-b border-slate-100">
                                    <th class="px-6 py-4 text-[9px] font-bold text-brand/40 uppercase tracking-widest">Date & Time</th>
                                    <th class="px-6 py-4 text-[9px] font-bold text-brand/40 uppercase tracking-widest">Service</th>
                                    <th class="px-6 py-4 text-[9px] font-bold text-brand/40 uppercase tracking-widest">Status</th>
                                    <th class="px-6 py-4 text-[9px] font-bold text-brand/40 uppercase tracking-widest text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                @foreach (var a in Model.Appointments.OrderByDescending(x => x.AppointmentDate)) {
                                    <tr class="hover:bg-slate-50/50 transition-colors group">
                                        <td class="px-6 py-4">
                                            <div class="text-[12px] font-bold text-brand">@a.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                            <div class="text-[10px] font-bold text-brand/40 uppercase tracking-widest mt-0.5">@a.AppointmentTime</div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-[12px] font-bold text-brand/70">@a.ServiceName</div>
                                            <div class="text-[9px] font-bold text-brand/30 mt-0.5 flex items-center gap-1.5">
                                                <i class="fa-solid fa-user-doctor text-[7px]"></i>
                                                Dr. @(a.Doctor?.Profile?.LastName ?? "TBD")
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            @{
                                                var color = a.Status.ToLower() switch {
                                                    "confirmed" => "bg-emerald-50 text-emerald-600 border-emerald-100",
                                                    "arrived" => "bg-blue-50 text-blue-600 border-blue-100",
                                                    "completed" => "bg-slate-50 text-slate-400 border-slate-100",
                                                    "cancelled" => "bg-rose-50 text-rose-600 border-rose-100",
                                                    _ => "bg-amber-50 text-amber-600 border-amber-100"
                                                };
                                            }
                                            <span class="px-2 py-0.5 @color text-[8px] font-bold rounded-lg border uppercase tracking-widest">@a.Status</span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <button class="w-8 h-8 rounded-lg bg-white border border-slate-100 text-brand/30 hover:text-brand hover:border-brand/30 transition-all shadow-sm">
                                                <i class="fa-solid fa-ellipsis text-[12px]"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Medical Modal -->
<div id="edit-medical-modal" class="fixed inset-0 z-[1000] hidden">
    <div class="absolute inset-0 bg-brand/40 backdrop-blur-sm" onclick="closeEditMedical()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden relative">
            <div class="p-6 border-b border-slate-100 bg-slate-50">
                <h3 class="text-lg font-bold text-brand">Edit Medical Info</h3>
                <p class="text-[10px] font-bold text-brand/40 uppercase tracking-widest">Update clinical records for @p?.FirstName</p>
            </div>
            <form id="edit-medical-form" class="p-6 space-y-4">
                <input type="hidden" name="PatientId" value="@p?.Id" />
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] font-bold text-brand/40 uppercase mb-1.5 ml-1">Blood Type</label>
                        <select name="BloodType" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:border-primary outline-none">
                            <option value="">Select...</option>
                            @foreach(var type in new[]{"A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"}){
                                <option value="@type" selected="@(Model.MedicalInfo?.BloodType == type)">@type</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-brand/40 uppercase mb-1.5 ml-1">Smoker Status</label>
                        <select name="IsSmoker" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:border-primary outline-none">
                            <option value="false" selected="@(Model.MedicalInfo?.IsSmoker == false)">Non-Smoker</option>
                            <option value="true" selected="@(Model.MedicalInfo?.IsSmoker == true)">Smoker</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-brand/40 uppercase mb-1.5 ml-1">Height (cm)</label>
                        <input type="number" step="0.1" name="Height" value="@Model.MedicalInfo?.Height" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:border-primary outline-none" />
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-brand/40 uppercase mb-1.5 ml-1">Weight (kg)</label>
                        <input type="number" step="0.1" name="Weight" value="@Model.MedicalInfo?.Weight" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:border-primary outline-none" />
                    </div>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="closeEditMedical()" class="flex-1 px-4 py-2.5 text-[12px] font-bold rounded-xl text-brand/60 bg-slate-50 hover:bg-slate-100 transition-all">Cancel</button>
                    <button type="submit" class="flex-1 px-4 py-2.5 text-[12px] font-bold rounded-xl text-white bg-primary shadow-lg shadow-primary/20 hover:shadow-primary/30 transition-all">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    function openNewMessage() {
        const patientId = "@p?.Id";
        window.location.href = `/Admin/Inquiries?patientId=${patientId}`;
    }

    function openNewAppointment() {
        const patientId = "@p?.Id";
        window.location.href = `/Admin/Appointments?patientId=${patientId}&openModal=true`;
    }

    function switchTab(tabId) {
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        const target = document.getElementById('content-' + tabId);
        if (target) target.classList.remove('hidden');
        
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        const activeBtn = document.querySelector(`[data-tab="${tabId}"]`);
        if (activeBtn) activeBtn.classList.add('active');
    }

    function openEditMedical() {
        document.getElementById('edit-medical-modal').classList.remove('hidden');
    }

    function closeEditMedical() {
        document.getElementById('edit-medical-modal').classList.add('hidden');
    }

    document.getElementById('edit-medical-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());
        
        // Fix types
        data.Height = parseFloat(data.Height) || null;
        data.Weight = parseFloat(data.Weight) || null;
        data.IsSmoker = data.IsSmoker === 'true';

        try {
            const res = await fetch('/api/admin/data/update-medical', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                location.reload();
            } else {
                alert('Failed to update medical info');
            }
        } catch (err) {
            console.error(err);
            alert('An error occurred');
        }
    });

    // Initialize first tab
    document.addEventListener('DOMContentLoaded', () => {
        switchTab('timeline');
    });
</script>

<style>
    .tab-btn {
        color: #64748b; /* slate-500 */
        transition: all 0.2s ease;
    }
    .tab-btn:hover:not(.active) {
        background-color: #f8fafc; /* slate-50 */
        color: #0f172a; /* brand */
    }
    .tab-btn.active {
        background-color: #0f172a; /* brand */
        color: white !important;
        box-shadow: 0 4px 12px -2px rgb(15 23 42 / 0.15);
    }
    
    @@media (max-width: 640px) {
        .text-xl { font-size: 1.125rem; }
        .text-lg { font-size: 1rem; }
        .text-md { font-size: 0.875rem; }
        .tab-btn { padding-left: 0.75rem; padding-right: 0.75rem; font-size: 9px; }
    }
</style>
