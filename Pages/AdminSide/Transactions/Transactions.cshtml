@page "/Admin/Transactions"
@model AdminTransactionsModel
@{
    Layout = "AdminSide/_StaffLayout";
}

<div class="page p-6">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div>
            <h2 class="text-2xl font-extrabold text-brand tracking-tight">Billing & Invoices</h2>
            <p class="text-[13px] text-brand-400 mt-1">Manage and track your generated treatment invoices</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <div class="relative min-w-[200px]">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="invoiceSearch" placeholder="Search patient..." 
                    class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-[12px] focus:border-primary focus:ring-4 focus:ring-primary/5 outline-none transition-all" />
            </div>
            <select id="statusFilter" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-[12px] font-bold text-brand-600 outline-none focus:border-primary transition-all">
                <option value="">All Status</option>
                <option value="paid">Paid</option>
                <option value="pending">Pending</option>
                <option value="partial">Partial</option>
                <option value="cancelled">Cancelled</option>
            </select>
            <span class="px-4 py-2 bg-brand-50 border border-brand-100 rounded-xl text-[12px] font-bold text-brand">
                Total: @Model.Invoices.Count
            </span>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto overflow-y-hidden">
        <table class="w-full text-left border-collapse min-w-[800px]">
            <thead>
                <tr class="bg-slate-50/50 border-b border-slate-100">
                    <th class="px-6 py-4 text-[11px] font-bold text-brand-400 uppercase tracking-widest">Date</th>
                    <th class="px-6 py-4 text-[11px] font-bold text-brand-400 uppercase tracking-widest">Patient</th>
                    <th class="px-6 py-4 text-[11px] font-bold text-brand-400 uppercase tracking-widest">Services</th>
                    <th class="px-6 py-4 text-[11px] font-bold text-brand-400 uppercase tracking-widest text-right">Amount</th>
                    <th class="px-6 py-4 text-[11px] font-bold text-brand-400 uppercase tracking-widest text-center">Status</th>
                    <th class="px-6 py-4 text-[11px] font-bold text-brand-400 uppercase tracking-widest text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @if (!Model.Invoices.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-20 text-center">
                            <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-slate-100">
                                <i class="fa-solid fa-file-invoice text-slate-200 text-2xl"></i>
                            </div>
                            <p class="text-[13px] text-brand-400 font-medium">No invoices found yet.</p>
                        </td>
                    </tr>
                }
                @foreach (var invoice in Model?.Invoices ?? Enumerable.Empty<SamsonDentalCenterManagementSystem.Models.Invoice>())
                {
                    <tr class="hover:bg-slate-50/50 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="text-[13px] font-bold text-brand-900">@invoice.CreatedAt.ToString("MMM dd, yyyy")</div>
                            <div class="text-[10px] text-brand-400">@invoice.CreatedAt.ToString("hh:mm tt")</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-brand-900 text-white flex items-center justify-center text-[10px] font-bold">
                                    @(invoice.Patient?.FullName?.Substring(0, 1) ?? "P")
                                </div>
                                <div>
                                    <div class="text-[13px] font-bold text-brand-900">@(invoice.Patient?.FullName ?? "Unknown Patient")</div>
                                    <div class="text-[10px] text-brand-400">#@invoice.Id.Substring(0, 8)</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-wrap gap-1 max-w-[200px]">
                                @foreach (var item in invoice.Items?.Take(2) ?? Enumerable.Empty<SamsonDentalCenterManagementSystem.Models.InvoiceItem>())
                                {
                                    <span class="px-2 py-0.5 bg-slate-100 rounded-md text-[10px] text-brand-600 font-medium">@item.Description</span>
                                }
                                @if ((invoice.Items?.Count ?? 0) > 2)
                                {
                                    <span class="px-2 py-0.5 bg-brand-50 rounded-md text-[10px] text-brand-600 font-bold">+@(invoice.Items.Count - 2)</span>
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="text-[13px] font-bold text-brand-900">₱@invoice.FinalAmount.ToString("N2")</div>
                            @if (invoice.DiscountAmount > 0)
                            {
                                <div class="text-[10px] text-emerald-500 font-bold">-₱@invoice.DiscountAmount.ToString("N2") Disc.</div>
                            }
                        </td>
                        <td class="px-6 py-4 text-center">
                            @if (invoice.Status == "paid")
                            {
                                <span class="px-3 py-1 bg-emerald-50 text-emerald-600 border border-emerald-100 rounded-full text-[10px] font-bold uppercase tracking-wider">Paid</span>
                            }
                            else if (invoice.Status == "cancelled")
                            {
                                <span class="px-3 py-1 bg-rose-50 text-rose-600 border border-rose-100 rounded-full text-[10px] font-bold uppercase tracking-wider">Cancelled</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-amber-50 text-amber-600 border border-amber-100 rounded-full text-[10px] font-bold uppercase tracking-wider">Pending</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right">
                            @if (invoice.Status != "paid")
                            {
                                <button onclick="openPaymentModal('@invoice.Id', '@(invoice.Patient?.FullName ?? "Patient")', @invoice.FinalAmount)" 
                                    class="w-8 h-8 rounded-lg border border-emerald-100 text-emerald-500 hover:bg-emerald-50 hover:text-emerald-600 hover:border-emerald-200 transition-all mr-1" title="Confirm Payment">
                                    <i class="fa-solid fa-check text-xs"></i>
                                </button>
                            }
                            <button onclick="viewInvoice('@invoice.Id')" class="w-8 h-8 rounded-lg border border-slate-100 text-brand-400 hover:text-brand-900 hover:border-brand-200 transition-all">
                                <i class="fa-solid fa-eye text-xs"></i>
                            </button>
                            <button onclick="window.print()" class="w-8 h-8 rounded-lg border border-slate-100 text-brand-400 hover:text-brand-900 hover:border-brand-200 transition-all">
                                <i class="fa-solid fa-print text-xs"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- PAYMENT MODAL                                                            -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<div id="payment-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-brand/40 backdrop-blur-md" onclick="closePaymentModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md pointer-events-auto transform transition-all duration-300">
            <div class="p-8">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-xl font-extrabold text-brand">Confirm Payment</h3>
                        <p id="payment-patient-name" class="text-[12px] text-brand-400 mt-1 font-medium"></p>
                    </div>
                    <button onclick="closePaymentModal()" class="text-slate-300 hover:text-slate-600">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <div class="space-y-4">
                    <input type="hidden" id="pay-invoice-id" />
                    
                    <div>
                        <label class="block text-[11px] font-bold text-brand uppercase tracking-wider mb-1.5">Amount Paid (₱)</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold">₱</span>
                            <input type="number" id="pay-amount" step="0.01"
                                class="w-full pl-9 pr-4 py-3 bg-slate-50 border border-slate-100 rounded-2xl text-[15px] font-bold text-brand outline-none focus:bg-white focus:border-primary transition-all" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-brand uppercase tracking-wider mb-1.5">Payment Method</label>
                        <select id="pay-method" class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-2xl text-[13px] font-bold text-brand outline-none focus:bg-white focus:border-primary transition-all">
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Maya">Maya</option>
                            <option value="Card">Credit/Debit Card</option>
                            <option value="Bank">Bank Transfer</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-brand uppercase tracking-wider mb-1.5">Reference Number</label>
                        <input type="text" id="pay-ref" placeholder="Optional..."
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-2xl text-[13px] font-medium text-brand outline-none focus:bg-white focus:border-primary transition-all" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-brand uppercase tracking-wider mb-1.5">Notes</label>
                        <textarea id="pay-notes" rows="2" placeholder="Internal remarks..."
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-2xl text-[12px] font-medium text-brand outline-none focus:bg-white focus:border-primary transition-all resize-none"></textarea>
                    </div>
                </div>

                <div class="mt-8">
                    <button onclick="submitPayment()" id="btn-submit-payment"
                        class="w-full py-4 bg-primary text-white rounded-2xl text-[14px] font-bold shadow-xl shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all">
                        Record Payment
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openPaymentModal(id, name, amount) {
        document.getElementById('pay-invoice-id').value = id;
        document.getElementById('payment-patient-name').innerText = "Invoice for " + name;
        document.getElementById('pay-amount').value = amount;
        document.getElementById('payment-modal').classList.remove('hidden');
    }

    function closePaymentModal() {
        document.getElementById('payment-modal').classList.add('hidden');
    }

    async function submitPayment() {
        const btn = document.getElementById('btn-submit-payment');
        const id = document.getElementById('pay-invoice-id').value;
        const amount = document.getElementById('pay-amount').value;
        const method = document.getElementById('pay-method').value;
        const ref = document.getElementById('pay-ref').value;
        const notes = document.getElementById('pay-notes').value;

        if (!amount || amount <= 0) return alert("Enter valid amount");

        btn.disabled = true;
        btn.innerText = "Processing...";

        try {
            const res = await fetch('/api/invoice/pay', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    invoiceId: id,
                    amount: parseFloat(amount),
                    paymentMethod: method,
                    referenceNumber: ref,
                    notes: notes
                })
            });

            const data = await res.json();
            if (data.ok) {
                window.location.reload();
            } else {
                alert(data.error || "Payment failed");
                btn.disabled = false;
                btn.innerText = "Record Payment";
            }
        } catch (err) {
            console.error(err);
            alert("Network error");
            btn.disabled = false;
            btn.innerText = "Record Payment";
        }
    }

    function viewInvoice(id) {
        // Just a simple eye view for now, could redirect to a detail page
        alert("Invoice ID: " + id + "\nFeature coming soon: Full PDF View");
    }

    // Client-side filtering
    document.getElementById('invoiceSearch').addEventListener('input', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);

    function filterTable() {
        const query = document.getElementById('invoiceSearch').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        const rows = document.querySelectorAll('tbody tr:not(.empty-row)');

        rows.forEach(row => {
            const patient = row.querySelector('td:nth-child(2)').innerText.toLowerCase();
            const rowStatus = row.querySelector('td:nth-child(5)').innerText.toLowerCase();
            
            const matchesSearch = patient.includes(query);
            const matchesStatus = !status || rowStatus.includes(status);

            row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
        });
    }
</script>