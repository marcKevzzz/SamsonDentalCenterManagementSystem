@page "/Profile/Notifications"
@model NotificationsModel
@{
ViewData["Title"] = "Notifications";
}

<section class="flex-1 min-w-0 fade-up min-h-[90dvh]">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-2">
      <div class="flex items-center gap-2 font-body text-[0.67rem] font-bold tracking-[0.2em] uppercase text-primary/60">
        <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>Communications
      </div>
    </div>
    <h1 class="font-bold text-[2rem] text-brand leading-tight" style="font-family:'Syne',sans-serif">Notification Center</h1>
    <p class="text-muted text-sm mt-1">Stay synchronized with your clinical progress and upcoming sessions.</p>
  </div>

  <!-- Filter tabs + actions -->
  <div class="flex items-center justify-between border-b border-gray-100 mb-8 overflow-x-auto no-scrollbar">
    <div class="flex">
      <button onclick="filterTab('all')" id="ftab-all"
        class="px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 -mb-px transition-all text-primary border-primary whitespace-nowrap"
        style="font-family:'Syne',sans-serif">
        All Messages
      </button>

      <button onclick="filterTab('appointments')" id="ftab-appointments"
        class="px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 -mb-px transition-all text-muted border-transparent hover:text-brand whitespace-nowrap"
        style="font-family:'Syne',sans-serif">
        Appointments
      </button>
      <button onclick="filterTab('system')" id="ftab-system"
        class="px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 -mb-px transition-all text-muted border-transparent hover:text-brand whitespace-nowrap"
        style="font-family:'Syne',sans-serif">
        System Alerts
      </button>
    </div>
  </div>

  <!-- Notification list -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden" id="notifList">
      <!-- Content injected by notifications.js -->
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="hidden py-32 flex-col items-center justify-center text-center bg-white rounded-3xl border border-slate-100 shadow-sm">
    <div class="w-20 h-20 bg-slate-50 rounded-[2rem] flex items-center justify-center mb-6">
        <i class="fa-regular fa-bell-slash text-slate-200 text-3xl"></i>
    </div>
    <h3 class="font-bold text-lg text-brand mb-2" style="font-family:'Syne',sans-serif">All Caught Up!</h3>
    <p class="text-sm text-muted max-w-xs mx-auto">You have no new notifications at the moment. We'll alert you here for any updates.</p>
  </div>
</section>

<script type="module" src="~/js/site.js"></script>
<script src="~/js/PatientSide/notifications.js"></script>
