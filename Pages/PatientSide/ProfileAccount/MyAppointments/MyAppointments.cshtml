@page "/Profile/MyAppointments"
@model MyAppointmentsModel
@{
ViewData["Title"] = "My Appointments page";
}


<div class="flex-1 min-w-0">
  <!-- Header Section -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8 fade-up">
    <div>
      <div class="flex items-center gap-2 font-body text-[0.67rem] font-medium tracking-[0.15em] uppercase text-muted mb-2">
        <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>Appointments
      </div>
      <h1 class="brand-font font-bold text-brand text-[1.5rem] leading-tight">My Appointments</h1>
    </div>
    
    <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative min-w-[280px]">
            <input type="text" id="apptSearch" oninput="searchAppts(this.value)" placeholder="Search by service or doctor..." 
                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-[#e5e7eb] bg-white text-[0.85rem] focus:border-primary outline-none transition-all" />
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 translate-half text-muted text-xs"></i>
        </div>
        <a href="/Appointments" class="brand-font font-bold text-[0.8rem] tracking-wider uppercase bg-brand text-white px-6 py-2.5 rounded-xl hover:bg-primary transition-all text-center no-underline">
            Book New
        </a>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8 fade-up">
    <div class="bg-white rounded-2xl p-5 border border-[#e5e7eb] shadow-sm group hover:border-primary/30 transition-all">
      <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-gray-50 flex items-center justify-center text-brand group-hover:bg-primary group-hover:text-white transition-all">
              <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div class="brand-font font-bold text-brand text-[1.5rem]">@Model.TotalCount</div>
      </div>
      <div class="font-body text-[0.7rem] font-bold uppercase tracking-wider text-muted">Total</div>
    </div>
    
    <div class="bg-white rounded-2xl p-5 border border-[#e5e7eb] shadow-sm group hover:border-primary/30 transition-all">
      <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-primary">
              <i class="fa-solid fa-clock-rotate-left"></i>
          </div>
          <div class="brand-font font-bold text-brand text-[1.5rem]">@Model.UpcomingCount</div>
      </div>
      <div class="font-body text-[0.7rem] font-bold uppercase tracking-wider text-muted">Upcoming</div>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-[#e5e7eb] shadow-sm group hover:border-primary/30 transition-all">
      <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-green-600">
              <i class="fa-solid fa-check"></i>
          </div>
          <div class="brand-font font-bold text-brand text-[1.5rem]">@Model.CompletedCount</div>
      </div>
      <div class="font-body text-[0.7rem] font-bold uppercase tracking-wider text-muted">Completed</div>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-[#e5e7eb] shadow-sm group hover:border-primary/30 transition-all">
      <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-yellow-50 flex items-center justify-center text-yellow-600">
              <i class="fa-solid fa-star"></i>
          </div>
          <div class="brand-font font-bold text-brand text-[1.5rem]">4.8</div>
      </div>
      <div class="font-body text-[0.7rem] font-bold uppercase tracking-wider text-muted">Rating</div>
    </div>
  </div>

  <div class="appt-master-container fade-up">
      <!-- Master List -->
      <div class="appt-list-pane">
          <div class="flex items-center gap-2 mb-4 overflow-x-auto no-scrollbar pb-2 border-b border-slate-100">
            <button onclick="filterAppts('all')" class="filter-tab active px-4 py-2 font-body text-[0.75rem] font-bold uppercase tracking-widest text-muted transition-all whitespace-nowrap" data-filter="all">All</button>
            <button onclick="filterAppts('confirmed')" class="filter-tab px-4 py-2 font-body text-[0.75rem] font-bold uppercase tracking-widest text-muted transition-all whitespace-nowrap" data-filter="confirmed">Confirmed</button>
            <button onclick="filterAppts('pending')" class="filter-tab px-4 py-2 font-body text-[0.75rem] font-bold uppercase tracking-widest text-muted transition-all whitespace-nowrap" data-filter="pending">Pending</button>
            <button onclick="filterAppts('completed')" class="filter-tab px-4 py-2 font-body text-[0.75rem] font-bold uppercase tracking-widest text-muted transition-all whitespace-nowrap" data-filter="completed">Completed</button>
          </div>

          <div id="apptList" class="space-y-3">
            @if (!Model.Appointments.Any())
            {
                <div class="py-20 text-center bg-white rounded-3xl border border-dashed border-[#e5e7eb]">
                    <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-calendar-plus text-muted text-xl"></i>
                    </div>
                    <h3 class="brand-font font-bold text-brand text-[1.1rem] mb-2">No Appointments Yet</h3>
                    <p class="font-body text-[0.85rem] text-muted mb-6 max-w-xs mx-auto">Your smile is important to us. Book your first consultation today!</p>
                </div>
            }
            else
            {
                @foreach (var appt in Model.Appointments)
                {
                    var docName = appt.Doctor?.Profile != null ? $"{appt.Doctor.Title} {appt.Doctor.Profile.FirstName} {appt.Doctor.Profile.LastName}" : null;
                    var apptJson = System.Text.Json.JsonSerializer.Serialize(new {
                        id = appt.Id,
                        serviceName = appt.ServiceName,
                        patientFirstName = appt.PatientFirstName,
                        patientLastName = appt.PatientLastName,
                        doctorName = docName,
                        date = appt.AppointmentDate.ToString("MMMM dd, yyyy"),
                        day = appt.AppointmentDate.ToString("ddd"),
                        time = appt.AppointmentTime,
                        status = appt.Status,
                        notes = appt.Notes,
                        durationMinutes = appt.Service?.DurationMinutes ?? 60
                    });

                    var s = appt.Status.ToLower();
                    var statusColor = s switch {
                        "confirmed" => "bg-emerald-100 text-emerald-600",
                        "completed" => "bg-slate-100 text-slate-600",
                        "cancelled" => "bg-red-100 text-red-600",
                        "pending"   => "bg-amber-100 text-amber-600",
                        _           => "bg-blue-100 text-primary"
                    };

                    <div class="appt-item-card fade-up-item" data-status="@s" data-name="@appt.ServiceName" onclick='viewApptDetails(@Html.Raw(apptJson), this)'>
                        <div class="flex items-center gap-5">
                            <!-- Date Pill -->
                            <div class="w-14 h-14 shrink-0 rounded-2xl bg-slate-50 flex flex-col items-center justify-center border border-slate-100 group-hover:bg-white transition-colors">
                                <span class="text-[0.65rem] font-bold uppercase text-muted tracking-widest leading-none">@appt.AppointmentDate.ToString("MMM")</span>
                                <span class="text-[1.2rem] font-bold text-brand leading-none mt-1">@appt.AppointmentDate.ToString("dd")</span>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-2 mb-1">
                                    <h3 class="brand-font font-bold text-brand text-[1.05rem] truncate">@appt.ServiceName</h3>
                                    <span class="status-pill @statusColor">@appt.Status</span>
                                </div>
                                <div class="flex items-center gap-3 text-[0.75rem] text-muted font-medium">
                                    <div class="flex items-center gap-1.5">
                                        <i class="fa-regular fa-clock opacity-50"></i>
                                        <span>@appt.AppointmentTime</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <i class="fa-solid fa-user-doctor opacity-50 text-[10px]"></i>
                                        <span class="truncate">@(docName ?? "To be assigned")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="shrink-0 text-slate-300">
                                <i class="fa-solid fa-chevron-right text-xs"></i>
                            </div>
                        </div>
                    </div>
                }
            }
          </div>
      </div>

      <!-- Detail Pane -->
      <div class="appt-detail-pane hidden lg:flex">
          <div id="detailEmpty" class="flex-1 flex flex-col items-center justify-center p-12 text-center">
              <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mb-6">
                  <i class="fa-solid fa-calendar-day text-slate-300 text-3xl"></i>
              </div>
              <h3 class="brand-font font-bold text-brand text-lg mb-2">Select an appointment</h3>
              <p class="text-muted text-sm leading-relaxed">Click on an appointment from the list to view its full details and available actions.</p>
          </div>

          <div id="detailContent" class="hidden flex-1 flex flex-col h-full overflow-hidden">
              <div class="p-8 pb-4">
                  <div class="flex items-center justify-between mb-6">
                      <span id="det-status-badge" class="status-pill">STATUS</span>
                      <span id="det-id" class="text-[0.65rem] font-bold text-slate-300 uppercase tracking-widest">#ID</span>
                  </div>
                  <h2 id="det-service" class="brand-font font-bold text-brand text-[1.4rem] leading-tight mb-6">Service Name</h2>
                  
                  <div class="space-y-6">
                      <div class="flex items-center gap-4 p-4 bg-slate-50 rounded-2xl border border-slate-100">
                          <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center text-primary border border-slate-100">
                              <i class="fa-regular fa-calendar-check text-xl"></i>
                          </div>
                          <div>
                              <p id="det-date" class="brand-font font-bold text-brand text-[0.95rem]">Date</p>
                              <p id="det-time" class="font-body text-muted text-xs font-medium">Time</p>
                          </div>
                      </div>

                      <div class="flex items-center gap-4">
                          <div class="w-12 h-12 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400 border border-slate-100">
                              <i class="fa-solid fa-user-doctor"></i>
                          </div>
                          <div>
                              <p id="det-doctor" class="brand-font font-bold text-brand text-[0.9rem]">Doctor Name</p>
                              <p class="font-body text-muted text-xs">Primary Dentist</p>
                          </div>
                      </div>

                      <div class="flex items-start gap-4">
                          <div class="w-12 h-12 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400 border border-slate-100 shrink-0">
                              <i class="fa-solid fa-location-dot"></i>
                          </div>
                          <div>
                              <p class="brand-font font-bold text-brand text-[0.9rem]">Samson Dental Center</p>
                              <p class="font-body text-muted text-xs leading-relaxed">Unit 201, Medical Tower, Quezon City</p>
                          </div>
                      </div>

                      <div class="pt-2">
                          <p class="text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">Patient Notes</p>
                          <div class="bg-amber-50/50 rounded-2xl p-4 border border-amber-100/50">
                              <p id="det-notes" class="font-body text-brand/70 text-xs leading-relaxed italic">No additional notes.</p>
                          </div>
                      </div>
                  </div>
              </div>

              <div class="mt-auto p-8 bg-slate-50/50 border-t border-slate-100 flex flex-col gap-3">
                  <div id="activeActions" class="flex flex-col gap-3">
                      <button id="btnReschedule" class="w-full py-3 bg-brand text-white brand-font font-bold text-[0.8rem] tracking-widest uppercase rounded-xl hover:bg-primary transition-all shadow-lg shadow-brand/10">
                          Reschedule
                      </button>
                      <button id="btnCancel" class="w-full py-3 text-red-500 font-bold text-[0.8rem] tracking-widest uppercase hover:bg-red-50 rounded-xl transition-all">
                          Cancel Appointment
                      </button>
                  </div>
                  <div id="completedActions" class="hidden flex flex-col gap-3">
                       <button class="w-full py-3 bg-emerald-600 text-white brand-font font-bold text-[0.8rem] tracking-widest uppercase rounded-xl hover:bg-emerald-700 transition-all">
                          Download Receipt
                      </button>
                      <button class="w-full py-3 text-brand font-bold text-[0.8rem] tracking-widest uppercase hover:bg-slate-100 rounded-xl transition-all">
                          Leave a Review
                      </button>
                  </div>
              </div>
          </div>
      </div>
  </div>

  <!-- Empty state for search/filters -->
  <div id="noResults" class="hidden py-20 text-center">
      <p class="text-muted font-body text-[0.9rem]">No appointments match your search or filter.</p>
      <button onclick="clearFilters()" class="text-primary font-bold text-[0.8rem] mt-2 underline">Clear all filters</button>
  </div>
</div>



<script type="module" src="~/js/site.js"></script>
<script type="module" src="~/js/PatientSide/myAppointments.js"></script>