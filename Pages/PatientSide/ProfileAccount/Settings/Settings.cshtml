@page "/Profile/Settings"
@model SettingsModel
@{
ViewData["Title"] = "Settings page";
var p = Model.UserProfile;
var dob = p?.DateOfBirth?.ToString("yyyy-MM-dd") ?? "";
var sex = p?.Sex ?? "";
var sexOptions = new SelectList(new[]
{
new { Value = "", Text = "Select sex" },
new { Value = "Male", Text = "Male" },
new { Value = "Female", Text = "Female" },
new { Value = "prefer_not", Text = "Prefer not to say" }
}, "Value", "Text", sex);
var selectClass = "w-full px-3.5 py-2.5 border-[1.5px] border-gray-200 rounded-lg text-sm text-brand";
}


@* JSON bridge for settings.js — matches your actual Profile columns *@
<script id="user-data" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        id          = p?.Id          ?? "",
        firstName   = p?.FirstName   ?? "",
        lastName    = p?.LastName    ?? "",
        email       = p?.Email       ?? "",
        phoneNumber = p?.PhoneNumber ?? "",
        dateOfBirth = p?.DateOfBirth?.ToString("yyyy-MM-dd") ?? "",
        sex         = p?.Sex         ?? "",
        address     = p?.Address     ?? "",
        avatarUrl   = p?.AvatarUrl   ?? "",
        role        = p?.Role        ?? "",
    }))
</script>

<Section class="flex-1 min-w-0 fade-up">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-2">
      <div class="flex items-center gap-2 font-body text-[0.67rem] font-bold tracking-[0.2em] uppercase text-primary/60">
        <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>Account Center
      </div>
    </div>
    <h1 class="font-bold text-[2rem] text-brand leading-tight" style="font-family:'Syne',sans-serif">Profile Settings</h1>
    <p class="text-muted text-sm mt-1">Manage your digital identity, contact details, and security preferences.</p>
  </div>

  <!-- Tabs -->
  <div class="flex border-b border-gray-100 mb-8 overflow-x-auto no-scrollbar">
    <button data-tab="personal" id="tab-btn-personal"
      class="tab-btn px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 -mb-px transition-all text-primary border-primary whitespace-nowrap"
      style="font-family:'Syne',sans-serif">
      Personal Details
    </button>
    <button data-tab="contact" id="tab-btn-contact"
      class="tab-btn px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 -mb-px transition-all text-muted border-transparent hover:text-brand whitespace-nowrap"
      style="font-family:'Syne',sans-serif">
      Contact Info
    </button>
    <button data-tab="security" id="tab-btn-security"
      class="tab-btn px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 -mb-px transition-all text-muted border-transparent hover:text-brand whitespace-nowrap"
      style="font-family:'Syne',sans-serif">
      Security & Access
    </button>
  </div>

  <!-- TAB: Personal Info -->
  <div id="tab-personal" class="space-y-6">
    <div class="settings-card">
      <h3 class="font-bold text-sm text-brand border-b border-gray-50 pb-4 mb-6" style="font-family:'Syne',sans-serif">
        Identity Visualization</h3>
      <div class="flex flex-col sm:flex-row items-center gap-8">
        <div class="relative group">
          <div id="avatarCircle"
            class="w-24 h-24 rounded-[2rem] bg-gradient-to-br from-primary to-blue-400 flex items-center justify-center font-bold text-3xl text-white border-4 border-white shadow-xl overflow-hidden transition-transform duration-500 group-hover:scale-105"
            style="font-family:'Syne',sans-serif">
            @if (!string.IsNullOrEmpty(p?.AvatarUrl))
            {
              <img src="@p.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
            }
            else
            {
              @((p?.FirstName?[..1] ?? "") + (p?.LastName?[..1] ?? ""))
            }
          </div>
          <button id="triggerAvatar"
            class="absolute -bottom-2 -right-2 w-9 h-9 bg-brand border-4 border-white rounded-xl flex items-center justify-center hover:bg-primary transition-all shadow-lg active:scale-90">
            <i class="fa-solid fa-camera text-white text-xs"></i>
          </button>
          <input type="file" id="avatarInput" accept="image/*" class="hidden" />
        </div>
        <div class="text-center sm:text-left">
          <p class="font-bold text-base text-brand mb-1" style="font-family:'Syne',sans-serif">Profile Picture</p>
          <p class="text-muted text-xs mb-4">Recommended: Square, min 400x400px. JPG or PNG.</p>
          <div class="flex items-center justify-center sm:justify-start gap-3">
            <button id="uploadBtn" class="px-4 py-2 bg-slate-50 text-brand font-bold text-[0.65rem] tracking-widest uppercase rounded-lg border border-slate-100 hover:bg-slate-100 transition-all">
              Change Photo
            </button>
            <button id="removeBtn" class="px-4 py-2 text-red-500 font-bold text-[0.65rem] tracking-widest uppercase rounded-lg hover:bg-red-50 transition-all">
              Remove
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="settings-card">
      <h3 class="font-bold text-sm text-brand border-b border-gray-50 pb-4 mb-6" style="font-family:'Syne',sans-serif">
        Personal Information</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="input-label">First Name</label>
          <input type="text" value="@p?.FirstName" placeholder="Juan" id="firstName" class="premium-input" />
        </div>
        <div>
          <label class="input-label">Last Name</label>
          <input type="text" value="@p?.LastName" placeholder="Dela Cruz" id="lastName" class="premium-input" />
        </div>
        <div>
          <label class="input-label">Date of Birth</label>
          <input type="date" value="@dob" id="dateOfBirth" class="premium-input" />
        </div>
        <div>
          <label class="input-label">Sex</label>
          <div class="relative">
             @Html.DropDownList("sex", sexOptions, new { id = "sex", @class = "premium-input appearance-none" })
             <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-slate-300 pointer-events-none text-[10px]"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB: Contact & Address -->
  <div id="tab-contact" class="space-y-6 hidden">
    <div class="settings-card">
      <h3 class="font-bold text-sm text-brand border-b border-gray-50 pb-4 mb-6" style="font-family:'Syne',sans-serif">
        Contact Channels</h3>
      <div class="space-y-6">
        <div>
          <label class="input-label">Email Address</label>
          <input type="email" value="@p?.Email" placeholder="juan@example.com" id="email" class="premium-input bg-slate-50/50" readonly />
          <p class="text-[0.65rem] text-muted mt-2">To change your primary email, please contact our support team.</p>
        </div>
        <div>
          <label class="input-label">Phone Number</label>
          <input type="tel" value="@p?.PhoneNumber" placeholder="09XX XXX XXXX" id="contactNumber" class="premium-input" />
        </div>
      </div>
    </div>

    <div class="settings-card">
      <h3 class="font-bold text-sm text-brand border-b border-gray-50 pb-4 mb-6" style="font-family:'Syne',sans-serif">
        Residential Address</h3>
      <div>
        <label class="input-label">Home Address</label>
        <textarea id="address" rows="3" class="premium-input resize-none" placeholder="Enter your full home address...">@p?.Address</textarea>
      </div>
    </div>
  </div>

  <!-- TAB: Security -->
  <div id="tab-security" class="space-y-6 hidden">
    <div class="settings-card">
      <h3 class="font-bold text-sm text-brand border-b border-gray-50 pb-4 mb-6" style="font-family:'Syne',sans-serif">
        Update Password</h3>
      <div class="space-y-5">
        <div>
          <label class="input-label">Current Password</label>
          <div class="relative">
            <input type="password" id="currentPw" class="premium-input pr-12" placeholder="••••••••" />
            <button data-target="currentPw" class="pw-toggle absolute right-4 top-1/2 -translate-y-1/2 text-slate-300 hover:text-brand transition-colors">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>
        <div>
          <label class="input-label">New Password</label>
          <div class="relative">
            <input type="password" id="newPw" class="premium-input pr-12" placeholder="Min 8 characters" />
            <button data-target="newPw" class="pw-toggle absolute right-4 top-1/2 -translate-y-1/2 text-slate-300 hover:text-brand transition-colors">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
          <div class="flex gap-1.5 mt-3">
            <div class="strength-seg h-1 flex-1 bg-slate-100 rounded-full" id="s1"></div>
            <div class="strength-seg h-1 flex-1 bg-slate-100 rounded-full" id="s2"></div>
            <div class="strength-seg h-1 flex-1 bg-slate-100 rounded-full" id="s3"></div>
            <div class="strength-seg h-1 flex-1 bg-slate-100 rounded-full" id="s4"></div>
          </div>
        </div>
        <div>
          <label class="input-label">Confirm New Password</label>
          <div class="relative">
            <input type="password" id="confirmPw" class="premium-input pr-12" placeholder="Repeat new password" />
            <button data-target="confirmPw" class="pw-toggle absolute right-4 top-1/2 -translate-y-1/2 text-slate-300 hover:text-brand transition-colors">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>
      </div>
      <div class="flex justify-end mt-8">
        <button id="savePassword" class="px-8 py-3 bg-brand text-white font-bold text-[0.75rem] tracking-widest uppercase rounded-xl hover:bg-primary transition-all active:scale-95">
          Update Security
        </button>
      </div>
    </div>

    <div class="bg-red-50/50 rounded-2xl border border-red-100 p-8">
      <h3 class="font-bold text-sm text-red-600 mb-2" style="font-family:'Syne',sans-serif">Deactivate Account</h3>
      <p class="text-xs text-red-500/70 mb-6 leading-relaxed">This will disable your access to the portal immediately. Your records will be preserved for clinical purposes but you will no longer be able to book appointments online.</p>
      <button id="deactivateAccount" class="px-6 py-2.5 bg-white text-red-500 border border-red-200 font-bold text-[0.65rem] tracking-widest uppercase rounded-xl hover:bg-red-500 hover:text-white transition-all">
        Deactivate
      </button>
    </div>
  </div>

  <div class="flex justify-end gap-3 mt-10" id="grpBtn">
    <button class="px-6 py-3 text-muted font-bold text-[0.75rem] tracking-widest uppercase hover:text-brand transition-all">
      Reset
    </button>
    <button id="saveAllInfo" class="hidden px-10 py-3 bg-brand text-white font-bold text-[0.75rem] tracking-widest uppercase rounded-xl hover:bg-primary transition-all shadow-lg shadow-brand/10">
      Save All Changes
    </button>
    <button id="nextTab" class="px-10 py-3 bg-brand text-white font-bold text-[0.75rem] tracking-widest uppercase rounded-xl hover:bg-primary transition-all shadow-lg shadow-brand/10">
      Continue <i class="fa-solid fa-chevron-right ml-2 text-[10px]"></i>
    </button>
  </div>
</Section>






<script type="module" src="~/js/site.js"></script>
<script src="~/js/PatientSide/settings.js" type="module"></script>