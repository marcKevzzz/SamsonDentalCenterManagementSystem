@page "/Profile/Records"
@model RecordsModel
@{
ViewData["Title"] = "Dental Records";
}

<section class="flex-1 min-w-0 space-y-5">
  <div class="fade-up">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 font-body text-[0.67rem] font-medium tracking-[0.15em] uppercase text-muted mb-2">
          <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>Patient Records
        </div>
        <h1 class="brand-font font-bold text-brand text-[1.75rem] leading-tight">Dental Records</h1>
        <p class="font-body text-[.87rem] text-muted mt-1">Your complete oral health history at Samson Dental Center.</p>
      </div>
    </div>
  </div>

  <!-- ═══ PATIENT INFO CARD ═══ -->
  <div class="fade-up bg-brand rounded-2xl overflow-hidden">
    <div class="relative px-5 pt-5 pb-0">
      <div class="absolute inset-0 opacity-[.04]"
        style="background-image:linear-gradient(rgba(255,255,255,1) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,1) 1px,transparent 1px);background-size:30px 30px;">
      </div>
      <div class="relative z-10 flex flex-col sm:flex-row sm:items-start gap-4 mb-5">
        <!-- Avatar -->
        <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center shrink-0 border-2 border-primary/30 overflow-hidden">
          @if (!string.IsNullOrEmpty(Model.Patient?.AvatarUrl))
          {
            <img src="@Model.Patient.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
          }
          else
          {
            <span class="brand-font font-bold text-white text-[1.1rem]">
              @((Model.Patient?.FirstName?.Length > 0 ? Model.Patient.FirstName[0].ToString() : "") + 
                (Model.Patient?.LastName?.Length > 0 ? Model.Patient.LastName[0].ToString() : ""))
            </span>
          }
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="brand-font font-bold text-white text-[1.2rem] leading-tight">@Model.Patient?.FullName</h2>
              <div class="flex flex-wrap items-center gap-3 mt-1.5">
                <span class="font-body text-[.75rem] text-white/55 flex items-center gap-1.5">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  DOB: @(Model.Patient?.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "N/A")
                </span>
                <span class="font-body text-[.75rem] text-white/55 flex items-center gap-1.5">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                  @Model.Patient?.Sex
                </span>
                <span class="font-body text-[.75rem] text-white/55">Patient ID: @Model.Patient?.Id.Substring(0, 8).ToUpper()</span>
              </div>
            </div>
            <span class="font-body text-[.65rem] font-medium uppercase tracking-wider bg-green-500/20 text-green-300 px-2.5 py-1 rounded-full">
              @(Model.Patient?.IsActive == true ? "Active Patient" : "Inactive")
            </span>
          </div>
        </div>
      </div>
      <!-- Info grid -->
      <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 border-t border-white/10">
        <div class="px-4 py-3 border-r border-white/10">
          <div class="font-body text-[.65rem] font-medium tracking-[.1em] uppercase text-white/35 mb-1">Patient Since</div>
          <div class="brand-font font-bold text-white text-[.9rem]">@Model.Patient?.CreatedAt.ToString("MMMM yyyy")</div>
        </div>
        <div class="px-4 py-3 sm:border-r border-white/10">
          <div class="font-body text-[.65rem] font-medium tracking-[.1em] uppercase text-white/35 mb-1">Blood Type</div>
          <div class="brand-font font-bold text-white text-[.9rem]">@(Model.MedicalInfo?.BloodType ?? "N/A")</div>
        </div>
        <div class="px-4 py-3 border-t sm:border-t-0 border-r border-white/10">
          <div class="font-body text-[.65rem] font-medium tracking-[.1em] uppercase text-white/35 mb-1">Last Visit</div>
          <div class="brand-font font-bold text-white text-[.9rem]">
            @(Model.Treatments.FirstOrDefault()?.CreatedAt.ToString("MMM dd, yyyy") ?? "No visits yet")
          </div>
        </div>
        <div class="px-4 py-3 border-t sm:border-t-0 border-white/10">
          <div class="font-body text-[.65rem] font-medium tracking-[.1em] uppercase text-white/35 mb-1">Total Treatments</div>
          <div class="brand-font font-bold text-white text-[.9rem]">@Model.Treatments.Count</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ RECORDS NAVIGATION ═══ -->
  <div class="flex items-center gap-6 border-b border-slate-100 mb-8 overflow-x-auto no-scrollbar">
    <button onclick="showTab('treatment')" id="tab-treatment" 
      class="rec-tab-btn active px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 transition-all whitespace-nowrap">
      Treatment History
    </button>
    @if (Model.ToothChart.Any())
    {
      <button onclick="showTab('chart')" id="tab-chart" 
        class="rec-tab-btn px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 transition-all text-muted border-transparent hover:text-brand whitespace-nowrap">
        Interactive Tooth Chart
      </button>
    }
    <button onclick="showTab('xray')" id="tab-xray" 
      class="rec-tab-btn px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 transition-all text-muted border-transparent hover:text-brand whitespace-nowrap">
      Diagnostic Imaging
    </button>
    <button onclick="showTab('medical')" id="tab-medical" 
      class="rec-tab-btn px-6 py-3 font-bold text-[0.7rem] tracking-widest uppercase border-b-2 transition-all text-muted border-transparent hover:text-brand whitespace-nowrap">
      Medical History
    </button>
  </div>

  <!-- ═══ TREATMENT HISTORY TAB ═══ -->
  <div id="tabContent-treatment" class="tab-pane-rec space-y-6">
      <div class="grid grid-cols-1 gap-4">
          @if (!Model.Treatments.Any())
          {
              <div class="py-20 text-center bg-white rounded-3xl border border-dashed border-[#e5e7eb]">
                  <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
                      <i class="fa-solid fa-notes-medical text-muted text-xl"></i>
                  </div>
                  <h3 class="brand-font font-bold text-brand text-[1.1rem] mb-2">No Treatment Records</h3>
                  <p class="font-body text-[0.85rem] text-muted max-w-xs mx-auto">Your treatment history will be displayed here after your first clinical visit.</p>
              </div>
          }
          @foreach (var t in Model.Treatments)
          {
              <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm hover:shadow-md transition-all group">
                  <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                      <div class="flex gap-4">
                          <div class="w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all shrink-0">
                              <i class="fa-solid fa-tooth"></i>
                          </div>
                          <div>
                              <div class="flex items-center gap-3 mb-1">
                                  <h3 class="brand-font font-bold text-brand text-lg">@t.ServiceName</h3>
                                  <span class="text-[0.65rem] font-bold uppercase tracking-widest px-2 py-1 bg-emerald-50 text-emerald-600 rounded-lg">@t.Status</span>
                              </div>
                              <p class="text-sm text-muted mb-4">@t.Diagnosis</p>
                              
                              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-medium">
                                  <div class="flex items-center gap-2 text-brand/70">
                                      <i class="fa-regular fa-calendar opacity-50"></i>
                                      <span>@t.CreatedAt.ToString("MMMM dd, yyyy")</span>
                                  </div>
                                  @if (!string.IsNullOrEmpty(t.ToothNumbers))
                                  {
                                      <div class="flex items-center gap-2 text-brand/70">
                                          <i class="fa-solid fa-hashtag opacity-50"></i>
                                          <span>Teeth: @t.ToothNumbers</span>
                                      </div>
                                  }
                              </div>
                          </div>
                      </div>
                      <div class="md:text-right">
                          <p class="text-[0.65rem] font-bold text-slate-300 uppercase tracking-widest mb-2">Procedure Details</p>
                          <p class="text-[0.8rem] text-muted leading-relaxed max-w-sm ml-auto">@t.ProcedureDetails</p>
                      </div>
                  </div>
              </div>
          }
      </div>
  </div>

  <!-- ═══ TOOTH CHART TAB ═══ -->
  <div id="tabContent-chart" class="tab-pane-rec hidden">
      <div class="bg-white rounded-[3rem] p-10 border border-slate-100 shadow-sm">
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-10 gap-4">
              <div>
                  <h2 class="brand-font font-bold text-brand text-2xl">Digital Odontogram</h2>
                  <p class="text-muted text-sm mt-1">Interactive visualization of your dental status.</p>
              </div>
              <div class="flex items-center gap-4 flex-wrap">
                  <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded bg-white border border-slate-200"></div>
                      <span class="text-[0.6rem] font-bold text-muted uppercase tracking-widest">Healthy</span>
                  </div>
                  <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded bg-blue-100 border border-blue-300"></div>
                      <span class="text-[0.6rem] font-bold text-muted uppercase tracking-widest">Filled</span>
                  </div>
                  <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded bg-purple-100 border border-purple-300"></div>
                      <span class="text-[0.6rem] font-bold text-muted uppercase tracking-widest">Crown</span>
                  </div>
                  <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded bg-emerald-100 border border-emerald-300"></div>
                      <span class="text-[0.6rem] font-bold text-muted uppercase tracking-widest">RCT</span>
                  </div>
                  <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded bg-slate-200 border border-slate-300"></div>
                      <span class="text-[0.6rem] font-bold text-muted uppercase tracking-widest">Extracted</span>
                  </div>
                  <div class="flex items-center gap-2 opacity-60">
                      <div class="w-3 h-3 rounded bg-red-50 border border-red-200"></div>
                      <span class="text-[0.6rem] font-bold text-muted uppercase tracking-widest">Missing</span>
                  </div>
                  <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded bg-red-100 border border-red-300"></div>
                      <span class="text-[0.6rem] font-bold text-muted uppercase tracking-widest">Decay</span>
                  </div>
              </div>
          </div>

          @if (!Model.ToothChart.Any())
          {
              <div class="py-20 text-center bg-slate-50/50 rounded-[2.5rem] border border-dashed border-[#e5e7eb]">
                  <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-100">
                      <i class="fa-solid fa-tooth text-slate-300 text-xl"></i>
                  </div>
                  <h3 class="brand-font font-bold text-brand text-[1.1rem] mb-2">No Dental Chart Data</h3>
                  <p class="font-body text-[0.85rem] text-muted max-w-sm mx-auto">Your odontogram will be populated after your first comprehensive oral examination.</p>
              </div>
          }
          else
          {
              <div class="bg-slate-50/50 rounded-[2.5rem] p-12 border border-slate-100/50 overflow-x-auto">
                  <div class="min-w-[600px]">
                      <!-- Upper Teeth -->
                      <div class="flex flex-wrap justify-center gap-3 mb-16">
                          @for (int i = 1; i <= 16; i++)
                          {
                              var status = Model.ToothStatusMap.ContainsKey(i) ? Model.ToothStatusMap[i].ToLower() : "healthy";
                              <div class="flex flex-col items-center gap-2 group">
                                  <span class="text-[0.6rem] font-bold text-slate-300 group-hover:text-primary transition-colors">#@i</span>
                                  <div class="tooth-v2 tooth-@status" title="Tooth #@i: @status">@i</div>
                              </div>
                          }
                      </div>

                      <!-- Arch Divider -->
                      <div class="h-px bg-slate-200 w-2/3 mx-auto mb-16 relative">
                          <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 bg-slate-50 px-6 -top-2 text-[0.6rem] font-bold text-slate-300 uppercase tracking-[0.4em] whitespace-nowrap">Lower Mandibular Arch</div>
                      </div>

                      <!-- Lower Teeth -->
                      <div class="flex flex-wrap justify-center gap-3">
                          @for (int i = 32; i >= 17; i--)
                          {
                              var status = Model.ToothStatusMap.ContainsKey(i) ? Model.ToothStatusMap[i].ToLower() : "healthy";
                              <div class="flex flex-col items-center gap-2 group">
                                  <div class="tooth-v2 tooth-@status rotate-180" title="Tooth #@i: @status">
                                      <span class="rotate-180 inline-block">@i</span>
                                  </div>
                                  <span class="text-[0.6rem] font-bold text-slate-300 group-hover:text-primary transition-colors">#@i</span>
                              </div>
                          }
                      </div>
                  </div>
              </div>
          }
      </div>
  </div>

  <!-- ═══ X-RAY TAB ═══ -->
  <div id="tabContent-xray" class="tab-pane-rec hidden">
      <div class="flex flex-col gap-8">
          @if (false)
          {
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                  @foreach (var treatment in Model.Treatments)
                  {
                      <div class="group relative bg-white rounded-[2.5rem] overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all">
                          <div class="aspect-square bg-slate-900 flex items-center justify-center overflow-hidden">
                              <i class="fa-solid fa-file-medical text-slate-700 text-5xl group-hover:scale-110 transition-transform"></i>
                          </div>
                          <div class="p-8">
                              <div class="flex items-center justify-between mb-2">
                                  <h3 class="font-bold text-brand text-base">@treatment.ServiceName</h3>
                                  <i class="fa-solid fa-expand text-slate-200 text-xs group-hover:text-primary transition-colors"></i>
                              </div>
                              <p class="text-muted text-[0.65rem] uppercase tracking-[0.15em] font-bold">Captured: @treatment.CreatedAt.ToString("MMM dd, yyyy")</p>
                          </div>
                      </div>
                  }
              </div>
          }
          else
          {
              <div class="py-32 flex flex-col items-center justify-center text-center bg-white rounded-[3rem] border border-slate-100 shadow-sm">
                  <div class="w-24 h-24 bg-slate-50 rounded-[2.5rem] flex items-center justify-center mb-8">
                      <i class="fa-solid fa-x-ray text-slate-200 text-4xl"></i>
                  </div>
                  <h3 class="font-bold text-2xl text-brand mb-3" style="font-family:'Syne',sans-serif">No X-Rays Found</h3>
                  <p class="text-sm text-muted max-w-xs mx-auto leading-relaxed">Digital diagnostic images associated with your treatments will appear here once uploaded by our clinical team.</p>
              </div>
          }
      </div>
  </div>

  <!-- ═══ MEDICAL HISTORY TAB ═══ -->
  <div id="tabContent-medical" class="tab-pane-rec hidden space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-sm">
              <div class="w-12 h-12 rounded-2xl bg-red-50 flex items-center justify-center text-red-500 mb-6">
                  <i class="fa-solid fa-droplet text-lg"></i>
              </div>
              <h3 class="brand-font font-bold text-brand text-lg mb-4">Core Info</h3>
              <div class="space-y-4">
                  <div class="flex justify-between items-center py-3 border-b border-slate-50">
                      <span class="text-sm text-muted">Blood Type</span>
                      <span class="text-sm font-bold text-brand">@(Model.MedicalInfo?.BloodType ?? "N/A")</span>
                  </div>
                  <div class="flex justify-between items-center py-3 border-b border-slate-50">
                      <span class="text-sm text-muted">Weight</span>
                      <span class="text-sm font-bold text-brand">@(Model.MedicalInfo?.Weight?.ToString("0") ?? "---") kg</span>
                  </div>
                  <div class="flex justify-between items-center py-3 border-b border-slate-50">
                      <span class="text-sm text-muted">Smoker</span>
                      <span class="text-sm font-bold @(Model.MedicalInfo?.IsSmoker == true ? "text-red-600" : "text-green-600")">@(Model.MedicalInfo?.IsSmoker == true ? "Yes" : "No")</span>
                  </div>
              </div>
          </div>

          <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-sm">
              <div class="w-12 h-12 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-500 mb-6">
                  <i class="fa-solid fa-shield-virus text-lg"></i>
              </div>
              <h3 class="brand-font font-bold text-brand text-lg mb-4">Allergies</h3>
              <div class="flex flex-wrap gap-2">
                  @if (!Model.Allergies.Any())
                  {
                      <p class="text-sm text-muted">No known allergies on file.</p>
                  }
                  @foreach (var allergy in Model.Allergies)
                  {
                      <span class="px-3 py-1.5 bg-red-50 text-red-600 text-[0.7rem] font-bold rounded-lg uppercase tracking-wider">@allergy</span>
                  }
              </div>
          </div>

          <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-sm">
              <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-500 mb-6">
                  <i class="fa-solid fa-pills text-lg"></i>
              </div>
              <h3 class="brand-font font-bold text-brand text-lg mb-4">Medications</h3>
              <div class="space-y-3">
                  @if (!Model.Medications.Any())
                  {
                      <p class="text-sm text-muted">No current medications.</p>
                  }
                  @foreach (var med in Model.Medications)
                  {
                      <div class="flex items-center gap-3">
                          <div class="w-1.5 h-1.5 rounded-full bg-blue-400"></div>
                          <span class="text-sm text-brand font-medium">@med</span>
                      </div>
                  }
              </div>
          </div>
      </div>
  </div>

</section>

<script>
function showTab(tabId) {
    // Buttons
    document.querySelectorAll('.rec-tab-btn').forEach(btn => {
        btn.classList.remove('active', 'text-primary', 'border-primary');
        btn.classList.add('text-muted', 'border-transparent');
    });
    const activeBtn = document.getElementById('tab-' + tabId);
    activeBtn.classList.add('active', 'text-primary', 'border-primary');
    activeBtn.classList.remove('text-muted', 'border-transparent');

    // Panes
    document.querySelectorAll('.tab-pane-rec').forEach(pane => {
        pane.classList.add('hidden');
    });
    document.getElementById('tabContent-' + tabId).classList.remove('hidden');
}
</script>

<style>
.rec-tab-btn.active {
    color: var(--primary);
    border-color: var(--primary);
}
.tooth-v2 {
    width: 32px;
    height: 42px;
    border-radius: 8px 8px 16px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
    font-family: 'Syne', sans-serif;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    position: relative;
    box-shadow: inset 0 -4px 0 rgba(0,0,0,0.05);
}
.tooth-v2:hover {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1), inset 0 -4px 0 rgba(0,0,0,0.05);
    z-index: 10;
}
.tooth-healthy { background: #ffffff; border: 1px solid #e2e8f0; color: #64748b; }
.tooth-filled { background: #dbeafe; border: 1px solid #93c5fd; color: #2563eb; }
.tooth-crown { background: #f3e8ff; border: 1px solid #d8b4fe; color: #9333ea; }
.tooth-rct { background: #d1fae5; border: 1px solid #6ee7b7; color: #059669; }
.tooth-extracted { background: #e2e8f0; border: 1px solid #cbd5e1; color: #94a3b8; text-decoration: line-through; }
.tooth-missing { background: #fef2f2; border: 1px solid #fecaca; color: #fca5a5; opacity: 0.6; }
.tooth-decay { background: #fee2e2; border: 1px solid #fca5a5; color: #dc2626; }
.tooth-plan { background: #fef3c7; border: 1px solid #fde68a; color: #d97706; }
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
