@page "/Confirm-Guest"
@model SamsonDentalCenterManagementSystem.Pages.PatientSide.Appointments.ConfirmGuestModel
@{
    ViewData["Title"] = "Confirm Appointment";
    ViewData["HideNav"] = true;
}

<div class="min-h-screen bg-slate-50 flex items-center justify-center p-4">
    <div class="max-w-md w-full">
        <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-brand transition-colors mb-6 font-body text-sm no-underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Cancel and Return Home
        </a>
        
        <div class="bg-white rounded-3xl shadow-xl p-8 border border-slate-100">
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-brand/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-calendar-check text-brand text-2xl"></i>
            </div>
            <h1 class="brand-font text-2xl font-bold text-slate-900">Confirm Appointment</h1>
            <p class="text-slate-500 text-sm mt-2">
                We've sent a verification code to <br>
                <span class="font-semibold text-slate-700">@Model.Email</span>
            </p>
        </div>

        <form method="post" class="space-y-6">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-3 text-center">Enter 6-Digit Code</label>
                <div class="flex justify-center gap-2" id="otp-inputs">
                    @for (int i = 0; i < 6; i++)
                    {
                        <input type="text" maxlength="1" 
                               class="w-12 h-14 text-center text-xl font-bold border-2 border-slate-200 rounded-xl focus:border-brand focus:ring-0 transition-all outline-none"
                               oninput="updateFullCode()"
                               onkeyup="moveNext(this, @i)" onkeydown="moveBack(event, this, @i)" />
                    }
                </div>
                <input type="hidden" asp-for="Code" id="full-code" />
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="bg-red-50 text-red-600 text-xs p-3 rounded-xl flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @TempData["Error"]
                </div>
            }

            <button type="submit" class="w-full bg-brand text-white font-bold py-4 rounded-xl hover:bg-primary transition-all shadow-lg shadow-brand/20">
                Confirm Appointment ✓
            </button>
        </form>
        </div>
    </div>
</div>

<script>
    function moveNext(el, index) {
        if (el.value.length === 1 && index < 5) {
            el.parentElement.children[index + 1].focus();
        }
        updateFullCode();
    }

    function moveBack(e, el, index) {
        if (e.key === "Backspace" && el.value.length === 0 && index > 0) {
            el.parentElement.children[index - 1].focus();
        }
    }

    function updateFullCode() {
        const inputs = document.querySelectorAll('#otp-inputs input');
        let code = "";
        inputs.forEach(input => code += input.value);
        document.getElementById('full-code').value = code;
    }
</script>
