@page "/Services/{slug}"
@model SamsonDentalCenterManagementSystem.Pages.PatientSide.Services.SlugModel
@using SamsonDentalCenterManagementSystem.Services

<section class="relative bg-brand pt-[68px] overflow-hidden hero-section">
  <div class="absolute inset-0 ">
    <img src="@(Model?.Service?.Hero ?? "")" alt="@(Model?.Service?.Name ?? "")" class="w-full h-full object-cover opacity-70 hero-parallax-bg" />
    <div class="absolute inset-0 bg-gradient-to-r from-brand/90 via-brand/70 to-transparent"></div>
  </div>
  <div class="relative z-10 max-w mx-auto px-8 lg:px-12 py-20 service-reveal">
    <div
      class="flex items-center gap-2 font-body text-[0.67rem] font-medium tracking-[0.15em] uppercase text-primary mb-4">
      @(Model?.Service?.Category ?? "")
      @if (Model?.Service?.NeedsXray == true)
      {
        <span class="badge bg-red-50 text-red-600 border border-red-100 flex items-center gap-1.5 px-2 ml-1" title="X-Ray Required">
            <i class="fa-solid fa-x-ray text-[0.7rem]"></i>
        </span>
      }
    </div>
    <h1 class="brand-font font-bold text-white leading-[1.05] mb-4 line-clamp-3 service-slug-title"
      >
      @(Model?.Service?.Name ?? "")</h1>
    <p class="font-body text-[1rem] text-white/55 max-w-md leading-relaxed mb-8">@(Model?.Service?.Tagline ?? "")</p>
    <div class="flex gap-2 sm:gap-4 hero-actions">
      <a href="/Appointments?service=@Model.Service.Slug"
        class="brand-font flex items-center font-bold text-[0.82rem] tracking-wider uppercase bg-primary text-white px-4 sm:px-7 py-3 sm:py-3.5 rounded-xl hover:opacity-90 transition-opacity no-underline">
        Book This Service
      </a>
      <a href="#overview"
        class="brand-font font-bold text-[0.82rem] tracking-wider uppercase border-2 border-white/20 text-white px-4 sm:px-7 py-3 sm:py-3.5 rounded-xl hover:border-white/50 transition-colors no-underline">
        Learn More <i class="fa-solid fa-arrow-down ml-2 "></i>
      </a>
    </div>
  </div>
</section>

<div class="bg-offwhite border-b border-[#e5e7eb]">
  <div class="service-stats-container max-w mx-auto px-2  lg:px-12 py-10 grid grid-cols-3 gap-4">
    <div class="stats-item flex md:flex-row flex-col items-center justify-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center shadow-sm shrink-0">
        <i class="fa-solid fa-clock text-primary text-sm"></i>
      </div>
      <div>
        <div
          class="font-body text-[0.8rem] font-medium tracking-[0.1em] uppercase text-muted text-center md:text-left">
          Duration</div>
        <div class="brand-font font-bold text-md sm:text-lg text-brand text-center md:text-left">@(Model?.Service?.DurationMinutes + " min")
        </div>
      </div>
    </div>
    <div class="stats-item flex md:flex-row flex-col items-center justify-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center shadow-sm shrink-0">
        <i class="fa-solid fa-heart-pulse text-primary text-sm"></i>
      </div>
      <div>
        <div
          class="font-body text-[0.8rem] font-medium tracking-[0.1em] uppercase text-muted text-center md:text-left">
          Recovery</div>
        <div class="brand-font font-bold text-md sm:text-lg text-brand text-center md:text-left">@(Model?.Service?.Recovery ?? "")
        </div>
      </div>
    </div>
    <div class="stats-item flex md:flex-row flex-col items-center justify-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center shadow-sm shrink-0">
        <i class="fa-solid fa-tags text-primary text-sm"></i>
      </div>
      <div>
        <div
          class="font-body text-[0.8rem] font-medium tracking-[0.1em] uppercase text-muted text-center md:text-left">
          Starting Price</div>
        <div class="brand-font font-bold text-md sm:text-lg text-brand text-center md:text-left">₱@(Model?.Service?.Price.ToString("N0") ?? "")
        </div>
      </div>
    </div>
  </div>
</div>

<section id="overview" class="bg-white">
  <div class="max-w mx-auto px-8 lg:px-12 py-20 flex flex-col lg:flex-row gap-14">

    <div class="flex-1 min-w-0">
      @* Overview *@
      <div class="reveal-up mb-14">
        <div class="flex items-center gap-2 font-body text-[0.67rem] font-medium tracking-[0.15em] uppercase text-muted mb-2">
           Overview
        </div>
        <h2 class="brand-font font-bold text-brand leading-[1.1] mb-5" style="font-size:clamp(1.6rem,3vw,2.2rem);">
          What is @(Model?.Service?.Name ?? "")?
        </h2>
        <p class="font-body text-[1rem] text-muted leading-relaxed">@(Model?.Service?.Summary ?? "")</p>
      </div>

      @* Steps UI (New Section) *@
      <div class="reveal-up mb-14">
        <div class="flex items-center gap-2 font-body text-[0.67rem] font-medium tracking-[0.15em] uppercase text-muted mb-2">
           The Process
        </div>
        <h2 class="brand-font font-bold text-brand leading-[1.1] mb-8" style="font-size:clamp(1.4rem,2.5vw,1.9rem);">How It Works</h2>
        
        <div class="steps-container relative pl-8 border-l-2 border-primary/10 space-y-4 ml-2">
          @for (int j = 0; j < (Model?.Service?.Steps?.Count ?? 0); j++)
          {
            <div class="step-item relative">
              <div class="absolute -left-[43px] top-0 w-5 h-5 rounded-full bg-white border-4 border-primary z-10"></div>
              <div class="flex flex-col">
                <span class="font-body text-[0.65rem] font-bold text-primary uppercase tracking-widest">Step @(j + 1)</span>
                <h3 class="brand-font font-normal text-[0.95rem] text-brand/80 mb-1">@Model.Service.Steps[j]</h3>
              </div>
            </div>
          }
        </div>
      </div>

      @* Benefits *@
      <div class="reveal-up mb-14">
        <div class="flex items-center gap-2 font-body text-[0.67rem] font-medium tracking-[0.15em] uppercase text-muted mb-2">
           What to Expect
        </div>
        <h2 class="brand-font font-bold text-brand leading-[1.1] mb-6" style="font-size:clamp(1.4rem,2.5vw,1.9rem);">Benefits of This Treatment</h2>
        <ul class="benefits-container space-y-3.5">
          @foreach (var benefit in Model?.Service?.Benefits ?? Enumerable.Empty<string>())
          {
            <li class="benefit-item flex items-start gap-3 font-body text-[0.9rem] text-brand/80">
              <span class="w-5 h-5 rounded-full bg-primary/15 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fa-solid fa-check text-primary text-[9px]"></i>
              </span>
              @benefit
            </li>
          }
        </ul>
      </div>

      <div class="reveal-up">
    <div class="flex items-center gap-2 font-body text-[0.67rem] font-medium tracking-[0.15em] uppercase text-muted mb-2">
         FAQ
    </div>
    <h2 class="brand-font font-bold text-brand leading-[1.1] mb-7" style="font-size:clamp(1.4rem,2.5vw,1.9rem);">Common Questions</h2>
    
    <div class="space-y-3">
        @for (int i = 0; i < (Model?.Service?.Faqs?.Count ?? 0); i++) 
        { 
            var faq = Model?.Service?.Faqs?[i]; 
            <div class="border border-[#e5e7eb] rounded-2xl overflow-hidden">
                <button id="toggleFaq@i" 
                        data-index="@i"
                        class="faq-toggle w-full flex items-center justify-between px-6 py-4 text-left bg-white hover:bg-primary/10 transition-colors">
                    <span class="brand-font text-[0.9rem] text-medium text-brand">@faq?.Question</span>
                    <i id="chevron-@i"
                       class="fa-solid fa-chevron-down faq-chevron text-brand/60 text-[10px] transition-transform duration-300"></i>
                </button>
                
                <div id="faq-@i" class="faq-answer max-h-0 overflow-hidden bg-white px-6 transition-all duration-300 ease-in-out">
                    <p class="font-body text-[0.85rem] text-brand/60 leading-relaxed pb-5 pt-3">@faq?.Answer</p>
                </div>
            </div>
        }
    </div>
</div>
    </div>
  </div>
</section>


<script src="~/js/PatientSide/serviceslug.js" type="module"></script>