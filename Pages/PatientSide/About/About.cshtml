@page "/About"
@model AboutModel
@{
ViewData["Title"] = "About page";
}

<section class="pt-[68px] relative overflow-hidden h-[400px] bg-brand bg-ani">
  <div class="absolute inset-0 opacity-[0.04]"
    style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:48px 48px;">
  </div>
  <div class=" max-w mx-auto px-8 lg:px-12 py-16 relative z-10 ">
    <h1 class="about-hero-text brand-font font-extrabold leading-[1.05]  text-[clamp(2.6rem,6vw,4.2rem)] text-white mb-3">
      About Us
    </h1>
    <p class="about-hero-text font-body text-[0.92rem] text-white/45  leading-relaxed max-w-xl">
      @(Model.ClinicSettings.AboutText ?? "Discover the story, mission, and people behind Samson Dental Center's commitment to excellence.")
    </p>
  </div>
</section>

<!-- ══════════════════════════════════
     OUR STORY
═══════════════════════════════════ -->
<section class="bg-white">
  <div class="max-w mx-auto px-8 lg:px-12 py-24 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <!-- Text -->
    <div class="reveal-up">
      <div class="flex items-center gap-2 font-body text-[0.67rem] font-semibold tracking-[0.15em] uppercase text-muted mb-5">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        Our Story
      </div>
      <h2 class="brand-font font-extrabold leading-[1.1] text-brand mb-6" style="font-size:clamp(2rem,4vw,2.8rem);">
        A Legacy of Dental <br>Excellence Since 1964.
      </h2>
      <p class="font-body text-[0.93rem] text-muted leading-relaxed mb-4">
        Samson Dental Center has its roots since 1964. Now on its 3rd generation of management, it has lived up to its commitment of being the pioneer on dental advancements both in expertise, facilities and equipments over the years.
      </p>
      <p class="font-body text-[0.93rem] text-muted leading-relaxed">
        It is unique and distinctive because we incorporate skill, experience and technology under one roof. Our clinic branch at Porta Vaga and our main center at S Building continue to provide services based on the highest standards of professionalism.
      </p>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 mt-10">
        <div class="stats-item bg-offwhite rounded-2xl p-5 text-center">
          <div class="brand-font font-extrabold text-[1.9rem] text-brand leading-none">60</div>
          <div class="font-body text-[0.7rem] text-muted mt-1.5 leading-snug">Years of<br>Trust</div>
        </div>
        <div class="stats-item bg-offwhite rounded-2xl p-5 text-center">
          <div class="brand-font font-extrabold text-[1.9rem] text-brand leading-none">3rd</div>
          <div class="font-body text-[0.7rem] text-muted mt-1.5 leading-snug">Generation<br>Leadership</div>
        </div>
        <div class="stats-item bg-offwhite rounded-2xl p-5 text-center">
          <div class="brand-font font-extrabold text-[1.9rem] text-brand leading-none">2</div>
          <div class="font-body text-[0.7rem] text-muted mt-1.5 leading-snug">Premium<br>Branches</div>
        </div>
      </div>
    </div>

    <!-- Image -->
    <div class="reveal-up relative group">
      <div class="relative rounded-2xl shadow-xl overflow-hidden h-[440px]">
        <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80" alt="Clinic interior" id="aboutimg1" class="w-full h-full object-cover will-change-transform rounded-2xl" />
        <div class="absolute -bottom-[2%] left-0 right-0 bg-gradient-to-t from-brand/90 to-transparent p-8 pt-20" id="aboutimg">
          <div class="brand-font font-bold text-white text-[1.1rem]">Est. 1964</div>
          <div class="font-body text-white/55 text-[0.78rem] mt-0.5 uppercase tracking-widest">
            @(Model.ClinicSettings.LocationAddress ?? "Baguio City, Philippines")
          </div>
        </div>
      </div>
      <div class="absolute -top-4 -right-4 w-20 h-20 rounded-full bg-primary flex flex-col items-center justify-center shadow-lg z-10">
        <div class="brand-font font-extrabold text-white text-[0.9rem] leading-none">#1</div>
        <div class="font-body text-white/80 text-[0.52rem] text-center leading-tight mt-0.5">Rated<br>Clinic</div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════
     OUR JOURNEY (Timeline)
═══════════════════════════════════ -->
<section class="bg-offwhite py-24">
    <div class="max-w mx-auto px-8 lg:px-12">
        <div class="text-center mb-16 reveal-up">
            <div class="flex items-center justify-center gap-2 font-body text-[0.67rem] font-semibold tracking-[0.15em] uppercase text-muted mb-4">
                <span class="w-2 h-2 rounded-full bg-primary"></span>
                The Time Frame
            </div>
            <h2 class="brand-font font-extrabold text-brand" style="font-size:clamp(1.8rem,3.5vw,2.6rem);">Our Journey</h2>
        </div>

        <div class="relative max-w-4xl mx-auto pl-8 border-l-2 border-primary/20 space-y-12">
            @{
                var milestones = new[] {
                    new { Year = "1965 – 1966", Event = "First Company Retainer Dentist of Saint Louis Boy’s High School." },
                    new { Year = "1968 – 1978", Event = "Company Dentist of Baguio Benguet Incorporated" },
                    new { Year = "1970 – 2000", Event = "Retainer Dentist of the Philippine National Bank (PNB)" },
                    new { Year = "1970 – 2003", Event = "Retainer Dentist of Development Bank of the Philippines (DBP)" },
                    new { Year = "1978 – 1982", Event = "First Retainer Dentist of Pines Hotel" },
                    new { Year = "1986 – 1988", Event = "Company Retainer Dentist of Export Processing Zone Authority (EPZA)" },
                    new { Year = "1988 – 1997", Event = "Company Retainer Dentist of Baguio Country Club" },
                    new { Year = "1986 – Present", Event = "Texas Instrument Philippines, Baguio City" },
                    new { Year = "2006 – Present", Event = "Health Partners" }
                };
            }

            @foreach (var m in milestones) {
                <div class="milestone-item relative reveal-up">
                    <div class="absolute -left-[41px] top-0 w-4 h-4 rounded-full bg-white border-4 border-primary shadow-sm"></div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
                        <span class="brand-font font-bold text-primary text-sm mb-1 block">@m.Year</span>
                        <p class="font-body text-[0.88rem] text-brand font-medium leading-relaxed">@m.Event</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ══════════════════════════════════
     MISSION & VALUES
═══════════════════════════════════ -->
<section class="bg-white">
  <div class="max-w mx-auto px-8 lg:px-12 py-20">
    <div class="text-center mb-14 reveal-up">
      <div class="flex items-center justify-center gap-2 font-body text-[0.67rem] font-semibold tracking-[0.15em] uppercase text-muted mb-4">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        What Drives Us
      </div>
      <h2 class="brand-font font-extrabold text-brand" style="font-size:clamp(1.8rem,3.5vw,2.6rem);">
        Mission & Vision
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <div class="mission-card bg-offwhite rounded-3xl p-10 h-full hover:bg-white hover:shadow-xl transition-all duration-500 border border-transparent hover:border-slate-100">
        <div class="w-14 h-14 rounded-2xl bg-primary flex items-center justify-center mb-6 shadow-lg shadow-primary/20">
             <i class="fa-solid fa-eye text-white text-xl"></i>
        </div>
        <h3 class="brand-font font-extrabold text-2xl text-brand mb-4">Our Vision</h3>
        <p class="font-body text-[0.95rem] text-muted leading-relaxed">
          To be the leading provider of high-standard professional dental services, continuously innovating and preserving our legacy of excellence for generations to come.
        </p>
      </div>

      <div class="mission-card bg-offwhite rounded-3xl p-10 h-full hover:bg-white hover:shadow-xl transition-all duration-500 border border-transparent hover:border-slate-100">
        <div class="w-14 h-14 rounded-2xl bg-primary flex items-center justify-center mb-6 shadow-lg shadow-primary/20">
             <i class="fa-solid fa-bullseye text-white text-xl"></i>
        </div>
        <h3 class="brand-font font-extrabold text-2xl text-brand mb-4">Our Mission</h3>
        <p class="font-body text-[0.95rem] text-muted leading-relaxed">
          Incorporating skill, experience, and technology under one roof to ensure complete patient care and satisfaction in every treatment.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════
     OUR DEDICATED TEAM
═══════════════════════════════════ -->
<section class="bg-brand bg-ani py-32">
  <div class="max-w mx-auto px-8 lg:px-12">
    <div class="text-center mb-20 reveal-up">
       <div class="flex items-center justify-center gap-2 font-body text-[0.67rem] font-semibold tracking-[0.15em] uppercase text-white/50 mb-4">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        Expert Specialists
      </div>
      <h2 class="brand-font font-extrabold text-white mb-6" style="font-size:clamp(2.5rem,5vw,4rem);">
        Our Dedicated Team
      </h2>
      <p class="font-body text-[0.95rem] text-white/40 max-w-lg mx-auto leading-relaxed">
        Our team functions on the sole purpose of ensuring complete patient care and satisfaction, and this dedication is what sets us apart.
      </p>
    </div>

    <!-- Doctor Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var doc in Model.Doctors) {
            <div class="doctor-card-premium group bg-white rounded-[2.5rem] overflow-hidden shadow-2xl transition-all duration-500 hover:-translate-y-2 reveal-up">
                <div class="relative h-[340px] overflow-hidden">
                    <img src="@(string.IsNullOrEmpty(doc.Profile?.AvatarUrl) ? "https://ui-avatars.com/api/?name=" + doc.Profile?.FirstName + "&size=400" : doc.Profile.AvatarUrl)" alt="@doc.FullName" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-gradient-to-t from-brand/80 via-transparent to-transparent opacity-60"></div>
                    <div class="absolute bottom-6 left-6">
                        <span class="bg-primary text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full shadow-lg">@doc.Title</span>
                    </div>
                </div>
                <div class="p-8">
                    <h3 class="brand-font font-extrabold text-brand text-2xl mb-2">@doc.Profile?.FirstName @doc.Profile?.LastName</h3>
                    <p class="font-body text-[0.8rem] text-muted font-semibold uppercase tracking-widest mb-4">@string.Join(" • ", doc.Specialties)</p>
                    <p class="font-body text-[0.88rem] text-muted leading-relaxed line-clamp-3 italic mb-6">"@doc.Bio"</p>
                    <div class="flex items-center gap-4 pt-6 border-t border-slate-100">
                        <div class="flex flex-col">
                            <span class="text-[10px] text-muted uppercase font-bold tracking-tighter">Experience</span>
                            <span class="text-sm font-bold text-brand">15+ Years</span>
                        </div>
                        <div class="w-px h-8 bg-slate-100"></div>
                        <div class="flex flex-col">
                            <span class="text-[10px] text-muted uppercase font-bold tracking-tighter">Education</span>
                            <span class="text-sm font-bold text-brand truncate">Specialist</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
  </div>
</section>

<!-- ══════════════════════════════════
     FACILITIES & OFFERS
═══════════════════════════════════ -->
<section class="bg-white py-32">
  <div class="max-w mx-auto px-8 lg:px-12">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-10 mb-20">
        <div class="max-w-2xl reveal-up">
            <div class="flex items-center gap-2 font-body text-[0.67rem] font-semibold tracking-[0.15em] uppercase text-muted mb-4">
                <span class="w-2 h-2 rounded-full bg-primary"></span>
                State of the Art
            </div>
            <h2 class="brand-font font-extrabold text-brand leading-[1.1]" style="font-size:clamp(2rem,4.5vw,3rem);">
                Professional Dental Care <br><span class="text-primary italic">Tailored to Your Needs.</span>
            </h2>
        </div>
        <p class="font-body text-[0.95rem] text-muted leading-relaxed max-w-sm reveal-up">
            Our highly competent doctors, coupled with the latest technology, ensure that each patient is treated with the highest standards.
        </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div class="flex gap-6 reveal-up">
            <div class="w-16 h-16 rounded-3xl bg-blue-50 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-medal text-primary text-2xl"></i>
            </div>
            <div>
                <h3 class="brand-font font-bold text-xl text-brand mb-3">Quality Care</h3>
                <p class="font-body text-[0.9rem] text-muted leading-relaxed">
                    Our quality of dental care is outstanding. Our main clinic is located at a new modern facility in S Building, Baguio City.
                </p>
            </div>
        </div>
        <div class="flex gap-6 reveal-up">
            <div class="w-16 h-16 rounded-3xl bg-blue-50 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-bolt text-primary text-2xl"></i>
            </div>
            <div>
                <h3 class="brand-font font-bold text-xl text-brand mb-3">Fast Service</h3>
                <p class="font-body text-[0.9rem] text-muted leading-relaxed">
                    We make efforts to accommodate you and your scheduling needs and desires, ensuring prompt and efficient treatment.
                </p>
            </div>
        </div>
        <div class="flex gap-6 reveal-up">
            <div class="w-16 h-16 rounded-3xl bg-blue-50 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-tags text-primary text-2xl"></i>
            </div>
            <div>
                <h3 class="brand-font font-bold text-xl text-brand mb-3">Affordable Prices</h3>
                <p class="font-body text-[0.9rem] text-muted leading-relaxed">
                    Our prices are substantially affordable. We provide high-end care without the high-end price tag.
                </p>
            </div>
        </div>
        <div class="flex gap-6 reveal-up">
            <div class="w-16 h-16 rounded-3xl bg-blue-50 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-heart text-primary text-2xl"></i>
            </div>
            <div>
                <h3 class="brand-font font-bold text-xl text-brand mb-3">Patient Priority</h3>
                <p class="font-body text-[0.9rem] text-muted leading-relaxed">
                    We strive to make the patient our priority. We work hard to see you promptly and achieve your complete satisfaction.
                </p>
            </div>
        </div>
    </div>
  </div>
</section>

<script type="module" src="~/js/PatientSide/about.js"></script>