@page "/Contacts"
@model ContactsModel
@{
    ViewData["Title"] = "Contacts page";
}

<section class="bg-brand pt-[68px] h-[360px] md:h-[420px] relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.04]"
         style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:48px 48px;"></div>
  <div class="max-w mx-auto px-8 lg:px-12 py-16 contact-reveal relative z-10">
    <div class="flex items-center gap-2 font-body text-[0.65rem] font-bold tracking-[0.2em] uppercase text-white/40">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        Get in Touch
    </div>
    <h1 class="brand-font font-bold leading-[1.05] text-[clamp(2.8rem,7vw,4.5rem)] text-white mb-4 flex flex-col">
        Connect with <br><span class="text-white/40 italic text-[clamp(1rem,4vw,2rem)] font-medium">Samson Dental.</span>
    </h1>
    <p class="font-body text-[0.95rem] text-white/45 max-w-sm leading-relaxed">
      Whether it's a routine check-up or a complex procedure, our team is here to guide your dental journey.
    </p>
  </div>
</section>

<!-- ══════════════════════════════════
     QUICK INFO CARDS
═══════════════════════════════════ -->
<section class="bg-offwhite">
  <div class="max-w mx-auto px-8 lg:px-12 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

      <!-- Phone -->
      <div class="mission-card contact-info-item reveal-up bg-white rounded-2xl p-6 shadow-sm">
        <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l.95-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <div class="brand-font font-bold text-[0.95rem] text-brand mb-0.5">@(Model.ClinicSettings.ContactPhone ?? "+63 2 8888 1234")</div>
        <div class="font-body text-[0.78rem] text-muted">@(Model.ClinicSettings.Landline ?? "Mon–Sat, 8 AM – 6 PM")</div>
      </div>

      <!-- Email -->
      <div class="mission-card contact-info-item reveal-up bg-white rounded-2xl p-6 shadow-sm">
        <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div class="brand-font font-bold text-[0.95rem]  text-brand mb-0.5 truncate">@(Model.ClinicSettings.ContactEmail ?? "support@samson.com")</div>
        <div class="font-body text-[0.78rem] text-muted">Typical reply within 24 hours</div>
      </div>

      <!-- Location -->
      <div class="mission-card contact-info-item reveal-up bg-white rounded-2xl p-6 shadow-sm">
        <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div class="brand-font font-bold text-[0.95rem] text-brand mb-0.5">Samson Dental</div>
        <div class="font-body text-[0.78rem] text-muted line-clamp-1">@(Model.ClinicSettings.LocationAddress ?? "Baguio City, Philippines")</div>
      </div>

      <!-- Status -->
      <div class="mission-card contact-info-item reveal-up bg-white rounded-2xl p-6 shadow-sm">
        <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div class="font-body text-[0.65rem] font-medium tracking-[0.12em] uppercase text-muted mb-1.5">Clinic Status</div>
        <div id="clinicStatusDisplay">
            <div class="flex items-center gap-2 mb-0.5">
              <span class="w-2.5 h-2.5 rounded-full bg-slate-300 inline-block animate-pulse"></span>
              <span class="brand-font font-bold text-[0.95rem] text-slate-400">Loading Status...</span>
            </div>
            <div class="font-body text-[0.78rem] text-muted italic">Syncing with schedule...</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ══════════════════════════════════
     CONTACT FORM + MAP
═══════════════════════════════════ -->
<section class="bg-offwhite" id="contactSection">
  <div class="max-w mx-auto px-8 lg:px-12 py-12 grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

    <!-- LEFT: Form -->
    <div class="reveal-up flex flex-col h-full">
      <div class="flex items-center gap-2 font-body text-[0.67rem] font-medium tracking-[0.15em] uppercase text-muted mb-2">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        Get In Touch
      </div>
      <h2 class="brand-font font-bold leading-[1.1] text-brand mb-5" style="font-size:clamp(1.8rem,3.5vw,2.4rem);">
        Send Us a Message
      </h2>

      <!-- Success message -->
      <div id="successMsg" class="hidden bg-emerald-50 border border-emerald-100 rounded-3xl p-6 flex items-start gap-4 mb-8 shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500 flex items-center justify-center shrink-0 shadow-lg shadow-emerald-200/50">
          <i class="fa-solid fa-check text-white text-lg"></i>
        </div>
        <div>
          <div class="brand-font font-bold text-emerald-900 text-[16px]">Message Sent!</div>
          <div class="font-body text-[0.85rem] text-emerald-700/80 mt-1 leading-relaxed">We've received your inquiry. You can continue the conversation below.</div>
        </div>
      </div>

      @{
          var hasActive = Model.ActiveInquiry != null;
      }

      <!-- CHAT CONTAINER -->
      <div id="chatContainer" class="@(hasActive ? "" : "hidden") bg-slate-50 border border-slate-100 rounded-3xl overflow-hidden flex flex-col min-h-[400px] md:min-h-[60px] h-full md:mb-0 mb-10 shadow-inner">
          <div class="p-4 bg-white border-b border-slate-100 flex items-center justify-between">
              <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-brand text-white flex items-center justify-center text-[10px] font-bold">S</div>
                  <div>
                      <span class="block text-[13px] font-bold text-brand">Support Thread</span>
                      @if(hasActive) {
                          <span class="block text-[10px] text-slate-400 font-medium">Ticket: #@Model.ActiveInquiry.Id.Substring(0,8).ToUpper()</span>
                      }
                  </div>
              </div>
              <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full uppercase tracking-wider">Live</span>
          </div>
          <div id="chatMessages" class="flex-1 overflow-y-auto p-6 space-y-4">
              <!-- Messages load here -->
          </div>
          <div class="p-4 bg-white border-t border-slate-100 flex items-end gap-2">
              <textarea id="chatReply" placeholder="Type a follow-up..." rows="1" scrollbar-hide
                     class="flex-1 px-4 py-3 bg-slate-100 border border-slate-200 rounded-2xl text-[13px] focus:bg-white focus:border-primary transition-all outline-none resize-none overflow-y-auto max-h-32"></textarea>
              <button onclick="sendFollowup()" class="w-11 h-11 bg-primary text-white rounded-xl flex items-center justify-center shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all shrink-0">
                  <i class="fa-solid fa-paper-plane text-xs"></i>
              </button>
          </div>
      </div>

      <form id="contactForm" onsubmit="handleSubmit(event)" class="@(hasActive ? "hidden" : "") space-y-4">
        <input type="hidden" id="patientId" value="@Model.CurrentPatientId" />
        <script>
            window.activeInquiryId = '@(Model.ActiveInquiry?.Id)';
            window.clinicSettings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                hours = Model.ClinicSettings.ClinicalHoursRaw,
                status = new {
                    isAutomated = Model.ClinicSettings.IsAutomatedStatus,
                    manual = Model.ClinicSettings.ManualStatus
                }
            }));
        </script>
        <!-- Name row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 form-group">
          <div>
            <label class="block font-body text-[0.72rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">First Name</label>
            <input type="text" id="firstName" class="form-input" placeholder="Juan" required/>
          </div>
          <div>
            <label class="block font-body text-[0.72rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">Last Name</label>
            <input type="text" id="lastName" class="form-input" placeholder="Dela Cruz" required/>
          </div>
        </div>

        <!-- Email + Phone -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 form-group">
          <div>
            <label class="block font-body text-[0.72rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">Email Address</label>
            <input type="email" id="email" class="form-input" placeholder="juan@email.com" required/>
          </div>
          <div>
            <label class="block font-body text-[0.72rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">Phone Number</label>
            <input type="tel" id="phone" class="form-input" placeholder="09XXXXXXXXX"
                maxlength="11" pattern="09[0-9]{9}"
                oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11)" />
          </div>
        </div>

        <!-- Subject -->
        <div class="relative form-group">
          <label class="block font-body text-[0.72rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">Subject</label>
          <select id="subject" class="form-input pr-10" required>
            <option value="" disabled selected>What is this about?</option>
            <option>General Inquiry</option>
            <option>Service Information</option>
            <option>Insurance & Billing</option>
            <option>Feedback or Concern</option>
            <option>Other</option>
          </select>
          <i class="fa-solid fa-chevron-down absolute right-4 top-[2.85rem] text-[10px] text-slate-400 pointer-events-none"></i>
        </div>

        <!-- Message -->
        <div class="form-group">
          <label class="block font-body text-[0.72rem] font-medium tracking-[0.08em] uppercase text-muted mb-2">Your Message</label>
          <textarea id="message" class="form-input resize-none" rows="5" placeholder="Write your message here..." required></textarea>
        </div>

        <!-- Submit -->
        <button type="submit" id="submitBtn"
          class="submit-btn form-group w-full brand-font font-bold text-[0.88rem] tracking-wider uppercase bg-brand text-white py-4 rounded-xl hover:bg-primary transition-all duration-200 cursor-pointer mt-2 shadow-xl shadow-brand/10">
          Send Message
        </button>

        <p class="font-body text-[0.74rem] text-muted text-center leading-relaxed">
          By submitting, you agree to our <a href="#" class="text-primary hover:underline">Privacy Policy</a>.
        </p>

      </form>
    </div>

    <!-- RIGHT: Map + Hours -->
    <div class="reveal-up space-y-6 pt-6">

      <!-- Directions link -->
      <a href="https://www.google.com/maps/dir//Samson+Dental+Center" target="_blank"
         class="flex items-center justify-between bg-white hover:bg-white hover:shadow-lg rounded-2xl px-6 py-4 transition-all duration-300 group no-underline border border-transparent hover:border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-white flex items-center justify-center shadow-sm group-hover:bg-primary transition-colors">
            <svg class="group-hover:stroke-white transition-colors" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="3 11 22 2 13 21 11 13 3 11"/>
            </svg>
          </div>
          <div>
            <div class="brand-font font-bold text-[0.85rem] text-brand">Get Directions</div>
            <div class="font-body text-[0.74rem] text-muted">Navigate to our clinic</div>
          </div>
        </div>
        <svg class="w-4 h-4 text-muted group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>

      <!-- Hours card -->
      <div class="bg-white rounded-2xl overflow-hidden">
        <div class="flex items-center gap-2 px-6 pt-5 pb-3">
          <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <span class="brand-font font-bold text-[0.85rem] text-brand">Operating Hours</span>
        </div>
        <div id="operatingHoursList" class="px-6 pb-2">
           <div class="py-10 text-center text-[10px] font-bold text-slate-300 uppercase tracking-widest">Loading hours...</div>
        </div>
      </div>

      <!-- Social / quick contacts -->
      <div class="grid grid-cols-2 gap-4">
        <a href="tel:@(Model.ClinicSettings.ContactPhone)"
           class="mission-card bg-brand text-white rounded-2xl p-5 flex flex-col sm:flex-row items-center gap-3 no-underline hover:bg-primary transition-colors group">
          <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l.95-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="max-w-full">
            <div class="brand-font font-bold text-[0.78rem] text-white sm:text-left text-center">Call Us</div>
            <div class="font-body text-[0.72rem] text-white/60 sm:text-left text-center truncate text-nowrap">@(Model.ClinicSettings.ContactPhone ?? "N/A")</div>
          </div>
        </a>
        <a href="mailto:@(Model.ClinicSettings.ContactEmail)"
           class="mission-card bg-white rounded-2xl p-5 flex flex-col sm:flex-row items-center gap-3 no-underline hover:bg-red-50 transition-colors group">
          <div class="w-9 h-9 rounded-xl bg-white flex items-center justify-center shadow-sm shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="max-w-full">
            <div class="brand-font font-bold text-[0.78rem] text-brand sm:text-left text-center">Email Us</div>
            <div class="font-body text-[0.72rem] text-muted sm:text-left text-center truncate w-full">@(Model.ClinicSettings.ContactEmail ?? "support@samson.com")</div>
          </div>
        </a>
      </div>

    </div>
  </div>
</section>
<script type="module" src="~/js/PatientSide/contacts.js"></script>
