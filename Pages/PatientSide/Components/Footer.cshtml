@inject SamsonDentalCenterManagementSystem.Services.ClinicService ClinicService
@{
    var settings = await ClinicService.GetSettingsAsync();
}
<footer class="bg-brand text-white">
  <div class="max-w mx-auto px-8 lg:px-12 pt-16 pb-8">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 pb-12 border-b border-white/10"
    >
      <!-- Brand -->
      <div>
        <div class="brand-logo flex items-center mb-6">
          <img src="@(string.IsNullOrEmpty(settings?.LogoUrl) ? "/images/logo.svg" : settings.LogoUrl)" alt="logo" class="w-14 h-14 object-cover mt-1 brightness-150" />
            <span id="logo" class="logo-font font-semibold text-[1.25rem] tracking-[0.035em] uppercase flex flex-col leading-[0.85] transition-colors gap-0.5 -ml-2">
          @(settings?.ClinicName?.Replace(" Dental Center", "") ?? "Samson")  <span id="logo-last" class="text-gray-400 brightness-125 tracking-[0.20em] text-[0.5rem] p-0.5 bg-gray-400/10 rounded-full text-center">Dental Center</span>
            </span>
        </div>
        <p
          class="font-body text-[0.82rem] text-white/40 leading-relaxed max-w-[220px] mb-6"
        >
          @(settings?.AboutText ?? "Empowering communities with world-class dental solutions and compassionate care since 2008.")
        </p>
        <div class="flex gap-3">
          @if (!string.IsNullOrEmpty(settings?.FacebookUrl)) {
            <a href="@settings.FacebookUrl" target="_blank" class="w-9 h-9 border border-white/15 rounded-lg flex items-center justify-center text-white/50 hover:bg-primary hover:text-white transition-all">
                <i class="fa-brands fa-facebook-f text-xs"></i>
            </a>
          }
          @if (!string.IsNullOrEmpty(settings?.InstagramUrl)) {
            <a href="@settings.InstagramUrl" target="_blank" class="w-9 h-9 border border-white/15 rounded-lg flex items-center justify-center text-white/50 hover:bg-primary hover:text-white transition-all">
                <i class="fa-brands fa-instagram text-xs"></i>
            </a>
          }
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="brand-font font-bold text-[0.85rem] text-white mb-5">
          Quick Links
        </h4>
        <a
          href="#hero"
          class="block font-body text-[0.83rem] text-white/40 hover:text-primary transition-colors mb-3"
          >Home</a
        >
        <a
          href="#perks"
          class="block font-body text-[0.83rem] text-white/40 hover:text-primary transition-colors mb-3"
          >About</a
        >
        <a
          href="#perks"
          class="block font-body text-[0.83rem] text-white/40 hover:text-primary transition-colors mb-3"
          >Services</a
        >
        <a
          href="#location"
          class="block font-body text-[0.83rem] text-white/40 hover:text-primary transition-colors mb-3"
          >Contacts</a
        >
      </div>

      <!-- Specialties -->
      <div>
        <h4 class="brand-font font-bold text-[0.85rem] text-white mb-5">
          Specialties
        </h4>
        <a
          href="#"
          class="block font-body text-[0.83rem] text-white/40 hover:text-primary transition-colors mb-3"
          >General Dentistry</a
        >
        <a
          href="#"
          class="block font-body text-[0.83rem] text-white/40 hover:text-primary transition-colors mb-3"
          >Orthodontics</a
        >
        <a
          href="#"
          class="block font-body text-[0.83rem] text-white/40 hover:text-primary transition-colors mb-3"
          >Oral Surgery</a
        >
        <a
          href="#"
          class="block font-body text-[0.83rem] text-white/40 hover:text-primary transition-colors mb-3"
          >Pediatric Care</a
        >
      </div>

      <!-- Newsletter -->
      <div>
        <h4 class="brand-font font-bold text-[0.85rem] text-white mb-3">
          Newsletter
        </h4>
        <p class="font-body text-[0.8rem] text-white/38 leading-relaxed mb-4">
          Stay updated with dental tips and offers.
        </p>
        <div
          class="flex rounded-xl overflow-hidden border border-white/10"
          style="background: rgba(255, 255, 255, 0.07)"
        >
          <input
            type="email"
            placeholder="Your email"
            class="nl-input flex-1 bg-transparent border-none outline-none px-4 py-3 font-body text-[0.83rem] text-white"
          />
          <button
            class="bg-primary px-4 text-white text-base hover:opacity-85 transition-opacity cursor-pointer border-none"
          >
            →
          </button>
        </div>
      </div>
    </div>

    <!-- Footer bottom -->
    <div class="flex flex-wrap justify-between items-center pt-7 gap-4">
      <p class="font-body text-[0.74rem] text-white/28">
        © @DateTime.Now.Year @(settings?.ClinicName ?? "Samson Dental Center"). All Rights Reserved.
      </p>
      <div class="flex gap-6">
        <a
          href="#"
          class="font-body text-[0.74rem] text-white/28 hover:text-primary transition-colors"
          >Privacy Policy</a
        >
        <a
          href="#"
          class="font-body text-[0.74rem] text-white/28 hover:text-primary transition-colors"
          >Terms of Service</a
        >
      </div>
    </div>
  </div>
</footer>
