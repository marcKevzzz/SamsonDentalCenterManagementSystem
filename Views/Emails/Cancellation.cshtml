@using System
@{
    Layout = "_EmailLayout.cshtml";
}

<div class="header slate">
    <h1>Samson Dental</h1>
    <p>Appointment Cancelled</p>
</div>

<div class="content">
    <h2>Hi @Model.Name,</h2>
    <p>We are writing to confirm that your appointment has been cancelled. If this was a mistake, please book a new slot or contact us.</p>

    <div class="details-box">
        <div class="details-row">
            <span class="details-label">Service</span>
            <span class="details-value">@Model.Service</span>
        </div>
        <div class="details-row">
            <span class="details-label">Date</span>
            <span class="details-value">@Model.Date</span>
        </div>
        <div class="details-row">
            <span class="details-label">Time</span>
            <span class="details-value">@Model.Time</span>
        </div>
    </div>
    
    <p style="font-size: 12px; color: #64748b; text-align: center;">We hope to see you again soon.</p>
</div>
