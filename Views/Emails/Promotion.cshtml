@using System
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: sans-serif; line-height: 1.6; color: #333; background-color: #f8fafc; margin: 0; padding: 20px; }
        .container { max-width: 520px; margin: 0 auto; background-color: #fff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; }
        .header { background-color: #059669; padding: 28px 32px; color: #fff; }
        .content { padding: 28px 32px; }
        .details { background-color: #ecfdf5; border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; border: 1px solid #a7f3d0; }
        .footer { border-top: 1px solid #e2e8f0; padding: 16px 32px; background-color: #f8fafc; text-align: center; font-size: 11px; color: #94a3b8; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1 style="margin:0; font-size: 20px;">Samson Dental Center</h1>
            <p style="margin:4px 0 0; color:#a7f3d0; font-size: 13px;">Waitlist Update 🎉</p>
        </div>
        <div class="content">
            <p>Hi <strong>@Model.Name</strong>,</p>
            <p>Great news! A slot opened up and you've been automatically booked from the waitlist.</p>

            <div class="details">
                <p style="margin: 0; font-size: 13px;"><strong>Service:</strong> @Model.Service</p>
                @if (!string.IsNullOrEmpty(Model.Doctor)) {
                    <p style="margin: 5px 0; font-size: 13px;"><strong>Doctor:</strong> @Model.Doctor</p>
                }
                <p style="margin: 5px 0; font-size: 13px;"><strong>Date:</strong> @Model.Date</p>
                <p style="margin: 0; font-size: 13px;"><strong>Time:</strong> @Model.Time</p>
            </div>
            
            <p style="font-size: 12px; color: #64748b;">Please arrive 10 minutes early.</p>
        </div>
        <div class="footer">
            &copy; @DateTime.Now.Year Samson Dental Center. All rights reserved.
        </div>
    </div>
</body>
</html>
