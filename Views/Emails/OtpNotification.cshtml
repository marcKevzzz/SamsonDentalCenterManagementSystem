@using System
@{
    Layout = "_EmailLayout";
}

<div class="header slate">
    <h1>Verification Code</h1>
    <p>Identity Verification</p>
</div>

<div class="content">
    <h2>Hello @Model.Name,</h2>
    <p>You requested a verification code for <strong>@Model.Action</strong>. Please use the following 6-digit code to proceed:</p>
    
    <div class="otp-code">@Model.Code</div>

    @if (Model.Link != null)
    {
        <div style="text-align: center; margin: 24px 0;">
            <p style="font-size: 13px;">Alternatively, you can click the button below to verify automatically:</p>
            <a href="@Model.Link" class="button">Verify Automatically</a>
        </div>
    }

    <p style="font-size: 12px; color: #64748b; text-align: center;">This code will expire in 15 minutes. If you did not request this, please ignore this email.</p>
</div>
