@using System
@{
    Layout = "_EmailLayout";
}

<div class="header blue">
    <h1>Samson Dental</h1>
    <p>New Reply to Your Inquiry</p>
</div>

<div class="content">
    <h2>Hi @Model.Name,</h2>
    <p>Our staff has replied to your inquiry regarding <strong>"@Model.Subject"</strong>:</p>

    <div class="details-box" style="border-left: 4px solid #2563eb;">
        <p style="margin: 0; font-size: 13px; font-style: italic; color: #0f172a;">"@Model.Message"</p>
    </div>
    
    <p>You can view the full conversation and reply back by clicking the button below:</p>
    
    <div style="text-align: center; margin-top: 24px;">
        <a href="@Model.Link" class="button" style="background-color: #2563eb;">View Conversation</a>
    </div>
</div>
